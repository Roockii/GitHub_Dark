{%- comment -%}
  DRYNIVA — PÁGINAS LEGALES (Términos, Privacidad, Reembolsos, Envíos) con el estilo de la tienda.
  Muestra el texto que tienes en Configuración → Políticas, así que solo lo escribes una vez.
  Se usa en la plantilla de página "legal": la página elige su política por su URL
  (terms-of-service, privacy-policy, refund-policy, shipping-policy). Cualquier otra
  página muestra su propio contenido.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign h = page.handle | default: ''
  assign doc_title = page.title
  assign doc_body = page.content
  assign current = 'page'
  if h contains 'terms'
    assign current = 'terms'
    if shop.terms_of_service.body != blank
      assign doc_body = shop.terms_of_service.body
    endif
  elsif h contains 'privacy'
    assign current = 'privacy'
    if shop.privacy_policy.body != blank
      assign doc_body = shop.privacy_policy.body
    endif
  elsif h contains 'refund' or h contains 'return'
    assign current = 'refund'
    if shop.refund_policy.body != blank
      assign doc_body = shop.refund_policy.body
    endif
  elsif h contains 'shipping'
    assign current = 'shipping'
    if shop.shipping_policy.body != blank
      assign doc_body = shop.shipping_policy.body
    endif
  endif
  if page.content != blank
    assign doc_body = page.content
  endif
-%}

<style>
#dry-lg-{{ section.id }}{
  --lg-dark:{{ s.c_dark }};--lg-sage:{{ s.c_sage }};--lg-lt:{{ s.c_light }};--lg-btn1:{{ s.c_btn1 }};--lg-btn2:{{ s.c_btn2 }};
  font-family:'Inter',ui-sans-serif,system-ui,sans-serif;width:100%;color:#1f2a24;background:#fff;
}
#dry-lg-{{ section.id }} *,#dry-lg-{{ section.id }} *::before,#dry-lg-{{ section.id }} *::after{box-sizing:border-box;}
:where(#dry-lg-{{ section.id }}) :where(p,h1,h2,ul){margin:0;padding:0;}
#dry-lg-{{ section.id }} .lg-container{width:1100px;max-width:100%;margin:0 auto;padding:0 20px;position:relative;z-index:1;}
#dry-lg-{{ section.id }} .lg-hero{background:var(--lg-lt);padding:55px 0 95px;text-align:center;position:relative;overflow:hidden;}
#dry-lg-{{ section.id }} .lg-pre{display:inline-flex;align-items:center;gap:8px;font-size:14px;line-height:18px;font-weight:700;color:var(--lg-sage);text-transform:uppercase;letter-spacing:.08em;}
#dry-lg-{{ section.id }} .lg-pre svg{width:16px;height:16px;}
#dry-lg-{{ section.id }} .lg-title{font-size:44px;line-height:50px;font-weight:700;color:var(--lg-dark);letter-spacing:-.6px;margin-top:10px;}
#dry-lg-{{ section.id }} .lg-sub{font-size:17px;line-height:25px;margin:12px auto 0;max-width:620px;}
#dry-lg-{{ section.id }} .lg-leaf{position:absolute;width:150px;opacity:.55;color:color-mix(in srgb,var(--lg-sage) 35%,#fff);pointer-events:none;}
#dry-lg-{{ section.id }} .lg-leaf.l1{left:-15px;bottom:-10px;transform:rotate(-18deg);}
#dry-lg-{{ section.id }} .lg-leaf.l2{right:-5px;top:-5px;transform:rotate(160deg);}
#dry-lg-{{ section.id }} .lg-body{display:grid;grid-template-columns:250px 1fr;gap:28px;align-items:start;margin-top:-55px;padding-bottom:60px;}
#dry-lg-{{ section.id }} .lg-nav{position:sticky;top:20px;background:#fff;border:1px solid #dee4d4;border-radius:16px;padding:12px;box-shadow:0 10px 30px -20px rgba(19,73,75,.4);}
#dry-lg-{{ section.id }} .lg-nav-t{font-size:12px;line-height:16px;font-weight:700;color:var(--lg-sage);text-transform:uppercase;letter-spacing:.08em;padding:8px 12px 10px;}
#dry-lg-{{ section.id }} .lg-nav a{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:10px;font-size:15px;line-height:20px;font-weight:600;color:#1f2a24;text-decoration:none;transition:background .2s,color .2s;}
#dry-lg-{{ section.id }} .lg-nav a:hover{background:var(--lg-lt);}
#dry-lg-{{ section.id }} .lg-nav a.is-active{background:var(--lg-dark);color:#fff;}
#dry-lg-{{ section.id }} .lg-nav a svg{width:18px;height:18px;flex-shrink:0;}
#dry-lg-{{ section.id }} .lg-card{background:#fff;border:1px solid #dee4d4;border-radius:18px;padding:45px 50px;box-shadow:0 10px 30px -18px rgba(19,73,75,.35);min-width:0;}
#dry-lg-{{ section.id }} .lg-rte{font-size:16px;line-height:27px;color:#1f2a24;overflow-wrap:anywhere;}
#dry-lg-{{ section.id }} .lg-rte p{margin:0 0 16px;}
#dry-lg-{{ section.id }} .lg-rte h1,#dry-lg-{{ section.id }} .lg-rte h2,#dry-lg-{{ section.id }} .lg-rte h3,#dry-lg-{{ section.id }} .lg-rte h4{color:var(--lg-dark);font-weight:700;margin:32px 0 12px;line-height:1.3;}
#dry-lg-{{ section.id }} .lg-rte h1{font-size:26px;}
#dry-lg-{{ section.id }} .lg-rte h2{font-size:22px;}
#dry-lg-{{ section.id }} .lg-rte h3,#dry-lg-{{ section.id }} .lg-rte h4{font-size:18px;}
#dry-lg-{{ section.id }} .lg-rte > :first-child{margin-top:0;}
/* títulos escritos en negrita (como hace el generador de políticas de Shopify) */
#dry-lg-{{ section.id }} .lg-rte p > strong:only-child,#dry-lg-{{ section.id }} .lg-rte p > b:only-child{display:block;color:var(--lg-dark);font-size:17px;line-height:24px;margin-top:30px;padding-top:22px;border-top:1px solid #e6ede7;}
#dry-lg-{{ section.id }} .lg-rte > p:first-child > strong:only-child,#dry-lg-{{ section.id }} .lg-rte > p:first-child > b:only-child{margin-top:0;padding-top:0;border-top:0;}
#dry-lg-{{ section.id }} .lg-rte ul,#dry-lg-{{ section.id }} .lg-rte ol{margin:0 0 18px;padding-left:22px;}
#dry-lg-{{ section.id }} .lg-rte li{margin-bottom:8px;}
#dry-lg-{{ section.id }} .lg-rte li::marker{color:var(--lg-sage);}
#dry-lg-{{ section.id }} .lg-rte a{color:var(--lg-dark);text-decoration:underline;text-underline-offset:3px;}
#dry-lg-{{ section.id }} .lg-rte table{width:100%;border-collapse:collapse;margin:0 0 18px;font-size:15px;}
#dry-lg-{{ section.id }} .lg-rte th,#dry-lg-{{ section.id }} .lg-rte td{border:1px solid #e0e6d7;padding:10px;text-align:left;}
#dry-lg-{{ section.id }} .lg-empty{color:#5b665e;font-style:italic;}
#dry-lg-{{ section.id }} .lg-help{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:35px;background:var(--lg-lt);border-radius:14px;padding:22px 25px;}
#dry-lg-{{ section.id }} .lg-help-t{font-size:18px;line-height:24px;font-weight:700;color:var(--lg-dark);}
#dry-lg-{{ section.id }} .lg-help-d{font-size:15px;line-height:21px;margin-top:3px;}
#dry-lg-{{ section.id }} .lg-btn{flex-shrink:0;display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 26px;border-radius:50px;color:#fff;font-size:16px;font-weight:700;text-decoration:none;background:var(--lg-btn1);background:linear-gradient(90deg,var(--lg-btn1),var(--lg-btn2));box-shadow:0 4px 8px 1px color-mix(in srgb,var(--lg-btn1) 30%,transparent);}
#dry-lg-{{ section.id }} .lg-btn svg{width:16px;height:16px;}
@media (max-width:900px){
  #dry-lg-{{ section.id }} .lg-body{grid-template-columns:1fr;gap:16px;}
  #dry-lg-{{ section.id }} .lg-nav{position:static;display:flex;flex-wrap:wrap;gap:6px;padding:10px;}
  #dry-lg-{{ section.id }} .lg-nav-t{width:100%;padding:4px 6px 2px;}
  #dry-lg-{{ section.id }} .lg-nav a{padding:8px 12px;font-size:14px;background:var(--lg-lt);}
  #dry-lg-{{ section.id }} .lg-nav a svg{display:none;}
}
@media (max-width:767px){
  #dry-lg-{{ section.id }} .lg-container{padding:0 15px;}
  #dry-lg-{{ section.id }} .lg-hero{padding:35px 0 75px;}
  #dry-lg-{{ section.id }} .lg-title{font-size:30px;line-height:36px;}
  #dry-lg-{{ section.id }} .lg-sub{font-size:15px;line-height:22px;}
  #dry-lg-{{ section.id }} .lg-leaf{width:90px;}
  #dry-lg-{{ section.id }} .lg-card{padding:26px 20px;border-radius:14px;}
  #dry-lg-{{ section.id }} .lg-rte{font-size:15px;line-height:25px;}
  #dry-lg-{{ section.id }} .lg-help{flex-direction:column;align-items:stretch;text-align:center;}
  #dry-lg-{{ section.id }} .lg-btn{justify-content:center;}
}
</style>

{%- capture leaf -%}<svg viewBox="0 0 120 200" fill="currentColor" aria-hidden="true"><path d="M58 198c2-60 4-120 2-190h4c2 70 0 130-2 190z"/><path d="M60 150c-25-5-45-25-50-55 25 5 45 25 50 55z"/><path d="M62 120c25-5 45-25 50-55-25 5-45 25-50 55z"/><path d="M60 85c-20-5-35-22-38-45 20 5 35 22 38 45z"/><path d="M62 60c18-5 32-20 35-40-18 5-32 20-35 40z"/></svg>{%- endcapture -%}
{%- capture ic_doc -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>{%- endcapture -%}
{%- capture ic_lock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>{%- endcapture -%}
{%- capture ic_refund -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>{%- endcapture -%}
{%- capture ic_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture ic_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture ic_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>{%- endcapture -%}

<section id="dry-lg-{{ section.id }}" class="drylg">
  <div class="lg-hero">
    <span class="lg-leaf l1">{{ leaf }}</span>
    <span class="lg-leaf l2">{{ leaf }}</span>
    <div class="lg-container">
      {%- if s.pre != blank -%}<p class="lg-pre">{{ ic_shield }}{{ s.pre }}</p>{%- endif -%}
      <h1 class="lg-title">{{ doc_title }}</h1>
      {%- if s.sub != blank -%}<p class="lg-sub">{{ s.sub }}</p>{%- endif -%}
    </div>
  </div>

  <div class="lg-container">
    <div class="lg-body">
      {%- if s.show_nav -%}
        <nav class="lg-nav" aria-label="{{ s.nav_title | escape }}">
          {%- if s.nav_title != blank -%}<p class="lg-nav-t">{{ s.nav_title }}</p>{%- endif -%}
          {%- if s.terms_label != blank -%}<a href="/pages/{{ s.terms_handle }}"{% if current == 'terms' %} class="is-active" aria-current="page"{% endif %}>{{ ic_doc }}{{ s.terms_label }}</a>{%- endif -%}
          {%- if s.privacy_label != blank -%}<a href="/pages/{{ s.privacy_handle }}"{% if current == 'privacy' %} class="is-active" aria-current="page"{% endif %}>{{ ic_lock }}{{ s.privacy_label }}</a>{%- endif -%}
          {%- if s.refund_label != blank -%}<a href="/pages/{{ s.refund_handle }}"{% if current == 'refund' %} class="is-active" aria-current="page"{% endif %}>{{ ic_refund }}{{ s.refund_label }}</a>{%- endif -%}
          {%- if s.shipping_label != blank -%}<a href="/pages/{{ s.shipping_handle }}"{% if current == 'shipping' %} class="is-active" aria-current="page"{% endif %}>{{ ic_truck }}{{ s.shipping_label }}</a>{%- endif -%}
        </nav>
      {%- endif -%}

      <article class="lg-card">
        <div class="lg-rte">
          {%- if doc_body != blank -%}{{ doc_body }}{%- else -%}<p class="lg-empty">{{ s.empty_text }}</p>{%- endif -%}
        </div>
        {%- if s.help_title != blank -%}
          <div class="lg-help">
            <div>
              <p class="lg-help-t">{{ s.help_title }}</p>
              {%- if s.help_text != blank -%}<p class="lg-help-d">{{ s.help_text }}</p>{%- endif -%}
            </div>
            {%- if s.help_button != blank -%}<a class="lg-btn" href="{{ s.help_link | default: '/pages/contact' }}">{{ s.help_button }}{{ ic_arrow }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dryniva · Legal",
  "tag": "div",
  "class": "dryniva-legal",
  "settings": [
    { "type": "paragraph", "content": "Muestra el texto de Configuración → Políticas según la URL de la página: terms-of-service, privacy-policy, refund-policy o shipping-policy. Si escribes contenido en la propia página, se muestra ese en su lugar." },
    { "type": "header", "content": "Cabecera" },
    { "type": "text", "id": "pre", "label": "Antetítulo", "default": "Dryniva · Legal" },
    { "type": "text", "id": "sub", "label": "Texto bajo el título", "default": "Everything you need to know, written clearly. If anything is unclear, we're happy to help." },

    { "type": "header", "content": "Menú de políticas" },
    { "type": "checkbox", "id": "show_nav", "label": "Mostrar menú lateral", "default": true },
    { "type": "text", "id": "nav_title", "label": "Título del menú", "default": "Policies" },
    { "type": "text", "id": "terms_label", "label": "Términos: texto", "default": "Terms of Service", "info": "Vacío = no aparece en el menú." },
    { "type": "text", "id": "terms_handle", "label": "Términos: URL de la página", "default": "terms-of-service" },
    { "type": "text", "id": "privacy_label", "label": "Privacidad: texto", "default": "Privacy Policy" },
    { "type": "text", "id": "privacy_handle", "label": "Privacidad: URL de la página", "default": "privacy-policy" },
    { "type": "text", "id": "refund_label", "label": "Reembolsos: texto", "default": "Refund Policy" },
    { "type": "text", "id": "refund_handle", "label": "Reembolsos: URL de la página", "default": "refund-policy" },
    { "type": "text", "id": "shipping_label", "label": "Envíos: texto", "default": "Shipping Policy" },
    { "type": "text", "id": "shipping_handle", "label": "Envíos: URL de la página", "default": "shipping-policy" },

    { "type": "header", "content": "Caja de ayuda (al final)" },
    { "type": "text", "id": "help_title", "label": "Título", "default": "Still have questions?", "info": "Vacío = no se muestra la caja." },
    { "type": "text", "id": "help_text", "label": "Texto", "default": "Our team is here to help with anything about your order." },
    { "type": "text", "id": "help_button", "label": "Botón", "default": "Contact Us" },
    { "type": "url", "id": "help_link", "label": "Enlace del botón", "info": "Vacío = /pages/contact" },
    { "type": "text", "id": "empty_text", "label": "Texto si la política está vacía", "default": "This policy will be available soon." },

    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "c_dark", "label": "Verde oscuro (títulos)", "default": "#13494B" },
    { "type": "color", "id": "c_sage", "label": "Verde salvia", "default": "#5C735E" },
    { "type": "color", "id": "c_light", "label": "Fondo verde claro", "default": "#F1F7F2" },
    { "type": "color", "id": "c_btn1", "label": "Botón: degradado 1", "default": "#02B432" },
    { "type": "color", "id": "c_btn2", "label": "Botón: degradado 2", "default": "#13DB3F" }
  ],
  "presets": [{ "name": "Dryniva · Legal" }]
}
{% endschema %}
