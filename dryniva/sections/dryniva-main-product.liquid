  .dry .acdn-heading .acdn-ic{right:12px;width:12px;height:12px;margin-top:-6px;}
  .dry .faq-header-img{width:40px;height:40px;}
  .dry .faq-subheading{font-size:13px;line-height:18px;}
  .dry .faq-heading{font-size:16px;line-height:20px;}
  .dry .acdn-content{padding:0 15px;}
  .dry .acdn-para,.dry .acdn-para p{font-size:15px;line-height:21px;}
  .dry .acdn-para p{margin-bottom:15px;}
  .dry .call-btn{display:block;padding:0 15px 10px;position:fixed;bottom:0;left:0;right:0;z-index:99;transform:translateY(130%);transition:transform .4s ease;pointer-events:none;}
  .dry .call-btn.is-visible{transform:none;pointer-events:auto;}
  .dry .call-btn .common_button{height:56px;}
}
@media only screen and (max-width:375px){
  .dry .banner_heading{font-size:27px;line-height:34px;}
  .dry .banner_text{font-size:14px;letter-spacing:-.3px;}
  .dry ul.banner_point li{letter-spacing:-.4px;}
  .dry .common_heading{font-size:27px;line-height:33px;}
  .dry .sec2_doct_text{letter-spacing:-.5px;}
  .dry .section5_row{padding:0 5px;}
  .dry .section5_col{padding:16px;}
}
@media only screen and (max-width:480px){
  .dry-ugc-modal .video-container{width:280px;min-height:480px;}
}
@media (prefers-reduced-motion:reduce){
  .dry .slider_track,.dry .low_stock span.fade{animation:none;}
  .dry .res-track,.dry .vid-track{scroll-behavior:auto;}
}
</style>

{%- liquid
  assign s = section.settings
  assign p = product
  if s.product != blank
    assign p = s.product
  endif
  if p != blank
    assign current_variant = p.selected_or_first_available_variant
  endif

  assign result_blocks = section.blocks | where: 'type', 'result'
  assign problem_blocks = section.blocks | where: 'type', 'problem'
  assign area_blocks = section.blocks | where: 'type', 'area'
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign package_blocks = section.blocks | where: 'type', 'package'
  assign faq_blocks = section.blocks | where: 'type', 'faq'

  assign pack_id = 'dry-pack-' | append: section.id
-%}

{%- comment -%} ---------- Iconos (SVG en línea, sin imágenes externas) ---------- {%- endcomment -%}
{%- capture svg_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture svg_tick -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{%- endcapture -%}
{%- capture svg_check_circle -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#02b432"/><path d="M6.8 12.3l3.4 3.4 7-7.2" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture svg_shield -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5.2 3.4 9.9 8 11 4.6-1.1 8-5.8 8-11V5l-8-3z"/><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture svg_star_path -%}<path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/>{%- endcapture -%}
{%- capture tp_stars -%}<span class="tp-stars" aria-label="5/5">{%- for i in (1..5) -%}<span><svg viewBox="0 0 24 24" aria-hidden="true">{{ svg_star_path }}</svg></span>{%- endfor -%}</span>{%- endcapture -%}
{%- capture svg_quote -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 6H6a3 3 0 0 0-3 3v4h4v5h3V6zm11 0h-4a3 3 0 0 0-3 3v4h4v5h3V6z"/></svg>{%- endcapture -%}
{%- capture svg_watch -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6M12 2v3"/></svg>{%- endcapture -%}
{%- capture svg_calendar -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8.5 15l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture svg_play -%}<svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" fill="rgba(255,255,255,.9)"/><path d="M23 18.5v19l15-9.5z" fill="#13494b"/></svg>{%- endcapture -%}
{%- capture svg_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture svg_verify -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.3l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture svg_close -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>{%- endcapture -%}
{%- capture svg_plus -%}<svg class="acdn-ic" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M2 9h14"/><path class="v" d="M9 2v14"/></svg>{%- endcapture -%}
{%- capture svg_prev -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>{%- endcapture -%}
{%- capture svg_next -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>{%- endcapture -%}
{%- capture svg_cmp_yes -%}<svg class="cmp-ic yes" viewBox="0 0 30 30" aria-label="Sí"><circle cx="15" cy="15" r="15" fill="#02b432"/><path d="M8.5 15.5l4.2 4.2 8.8-9" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture svg_cmp_yes_light -%}<svg class="cmp-ic yes" viewBox="0 0 30 30" aria-label="Sí"><circle cx="15" cy="15" r="15" fill="#fff"/><path d="M8.5 15.5l4.2 4.2 8.8-9" fill="none" stroke="#02b432" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture svg_cmp_no -%}<svg class="cmp-ic no" viewBox="0 0 22 22" aria-label="No"><circle cx="11" cy="11" r="11" fill="#e53935"/><path d="M7.3 7.3l7.4 7.4M14.7 7.3l-7.4 7.4" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture svg_cmp_warn -%}<svg class="cmp-ic warn" viewBox="0 0 26 26" aria-label="A medias"><path d="M13 2 25 23H1z" fill="#f5a623" stroke="#f5a623" stroke-width="1.5" stroke-linejoin="round"/><path d="M13 9.5v6" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="13" cy="19" r="1.4" fill="#fff"/></svg>{%- endcapture -%}
{%- capture def_ic -%}<span class="def-ic">{{ svg_tick }}</span>{%- endcapture -%}

{%- comment -%} ---------- Bloque del botón (se repite como en la competencia) ---------- {%- endcomment -%}
{%- capture cta_inner -%}
  {%- if s.cta_show_bar -%}
    <ul class="button_shipp">
      <li class="green_dot"><span class="sale_fire" aria-hidden="true">🔥</span><span><strong>{{ s.cta_sale_label }}</strong>{{ s.cta_sale_text }}</span></li>
      <li class="stock_level">{{ s.cta_stock_label }} <span class="red-text">{{ s.cta_stock_value }}</span>
        <div class="low_stock" aria-hidden="true"><span class="active fade"></span><span></span><span></span><span></span><span></span></div>
      </li>
    </ul>
  {%- endif -%}
  <a class="common_button" href="#{{ pack_id }}" data-dry-scroll><p>{{ s.cta_text }}</p>{{ svg_arrow }}</a>
  {%- if s.cta_guarantee != blank -%}<p class="button_mbk_text">{{ svg_shield }}{{ s.cta_guarantee }}</p>{%- endif -%}
{%- endcapture -%}
{%- capture cta -%}<div class="clearall"></div><div class="common_button_box hideMob">{{ cta_inner }}</div>{%- endcapture -%}

<div
  id="dry-{{ section.id }}"
  class="dry"
  data-dry-root
  data-after-add="{{ s.after_add }}"
  data-added-msg="{{ s.added_message | escape }}"
  data-error-msg="{{ s.error_message | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-timer-h="{{ s.timer_hours }}"
  data-timer-m="{{ s.timer_minutes }}"
  data-cutoff="{{ s.ship_cutoff }}"
  style="--dk:{{ s.c_dark }};--sage:{{ s.c_sage }};--lt:{{ s.c_light }};--gray:{{ s.c_gray }};--hero:{{ s.c_hero }};--btn1:{{ s.c_btn1 }};--btn2:{{ s.c_btn2 }};--red:{{ s.c_red }};--star:{{ s.c_star }};--marquee-speed:{{ s.marquee_speed }}s;"
>

  {%- comment -%} ================= 1. BANNER ================= {%- endcomment -%}
  {%- if s.show_banner -%}
    {%- capture banner_right -%}
      <div class="banner_prod_box">
        {%- if s.hero_ba_image != blank -%}
          <div class="banner_bfr_aftr">{{ s.hero_ba_image | image_url: width: 600 | image_tag: loading: 'eager', alt: s.hero_ba_image.alt, widths: '300, 450, 600' }}</div>
        {%- endif -%}
        <div class="banner_prod">
          {%- if s.hero_product_image != blank -%}
            {{ s.hero_product_image | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.hero_product_image.alt, widths: '400, 600, 800' }}
          {%- elsif p != blank and p.featured_image != blank -%}
            {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: p.title, widths: '400, 600, 800' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'dry-ph' }}
          {%- endif -%}
        </div>
        {%- if s.hero_seal != blank -%}{{ s.hero_seal | image_url: width: 260 | image_tag: class: 'banner-prod-seal', loading: 'eager', alt: s.hero_seal.alt }}{%- endif -%}
      </div>
    {%- endcapture -%}
    {%- capture works_box -%}
      {%- assign works_lines = s.works_items | newline_to_br | split: '<br />' -%}
      <div class="banner_right_workBox">
        {%- if s.works_heading != blank -%}<p class="bnr_work_heading"><span>{{ s.works_heading }}</span></p>{%- endif -%}
        <ul class="bnr_work_list">
          {%- assign wi = 0 -%}
          {%- for line in works_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              {%- assign wi = wi | plus: 1 -%}
              {%- assign ic_key = 'works_icon_' | append: wi -%}
              <li>
                <div class="ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div>
                <p>{{ line | replace: '|', '<br>' }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endcapture -%}

    <section class="banner dry-sec"{% if s.hero_bg != blank %} style="background-image:url('{{ s.hero_bg | image_url: width: 2400 }}')"{% endif %}>
      <div class="container">
        <div class="banner_row">
          <div class="banner_content">
            <div class="bnr_trusted_text">
              <span class="stars-row" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" fill="{{ s.c_star }}">{{ svg_star_path }}</svg>{%- endfor -%}</span>
              <p>{{ s.hero_trusted }}</p>
              {%- if s.hero_people != blank -%}{{ s.hero_people | image_url: width: 220 | image_tag: class: 'trust_people', loading: 'eager', alt: '' }}{%- endif -%}
            </div>
            <h1 class="banner_heading">{{ s.hero_heading }}</h1>
            {%- assign strip_lines = s.hero_strip | newline_to_br | split: '<br />' -%}
            {%- if s.hero_strip != blank -%}
              <div class="banner_strip">
                <ul class="banner_strip_list">
                  {%- for line in strip_lines -%}{%- assign line = line | strip -%}{%- if line != blank -%}<li>{{ svg_tick }}{{ line }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            <div class="showMob"><div class="banner_right">{{ banner_right }}</div></div>
            {%- if s.hero_text != blank -%}<p class="banner_text">{{ s.hero_text }}</p>{%- endif -%}
            {%- assign point_lines = s.hero_points | newline_to_br | split: '<br />' -%}
            <ul class="banner_point">
              {%- for line in point_lines -%}{%- assign line = line | strip -%}{%- if line != blank -%}<li>{{ svg_check_circle }}<span>{{ line }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
            <div class="showMob">{{ works_box }}</div>
            <div class="clearall"></div>
            <div class="common_button_box" data-sticky-trigger>{{ cta_inner }}</div>
          </div>
          <div class="banner_right hideMob">
            {{ banner_right }}
            {{ works_box }}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 2. CINTA EN MOVIMIENTO ================= {%- endcomment -%}
  {%- if s.show_marquee and s.marquee_items != blank -%}
    {%- assign mq_lines = s.marquee_items | newline_to_br | split: '<br />' -%}
    <div class="scroll_strip dry-sec" aria-hidden="true">
      <div class="scroll_slider">
        {%- for k in (1..5) -%}
          <ul class="slider_track">
            {%- for line in mq_lines -%}{%- assign line = line | strip -%}{%- if line != blank -%}<li><p>{{ line }}</p></li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= 3. RESULTADOS ================= {%- endcomment -%}
  {%- if s.show_results and result_blocks.size > 0 -%}
    <section class="section_1 dry-sec">
      <div class="container">
        <h2 class="common_heading color_heading_green1">{{ s.res_heading | newline_to_br }}</h2>
        {%- if s.res_text != blank -%}<p class="common_parahraph">{{ s.res_text | newline_to_br }}</p>{%- endif -%}
        <div class="section1_result_block" data-res>
          <div class="nav_row" role="tablist">
            {%- for block in result_blocks -%}
              <button type="button" class="res-tab{% if forloop.first %} is-active{% endif %}" data-res-tab="{{ forloop.index0 }}" role="tab"><p>{{ block.settings.tab | replace: '|', '<br>' }}</p></button>
            {%- endfor -%}
          </div>
          <div class="result_inner_swipe">
            <div class="res-track" data-res-track>
              {%- for block in result_blocks -%}
                <div class="women_result_slider__box{% if forloop.first %} is-active{% endif %}" data-res-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  <div class="women_result_slider_image_box">
                    {%- if block.settings.area != blank -%}<p class="women_prob_text_name">{{ block.settings.area }}</p>{%- endif -%}
                    <div class="women_res_bef_img_box">
                      {%- if block.settings.before != blank -%}{{ block.settings.before | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.before.alt }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
                      <p>{{ s.label_before }}</p>
                    </div>
                    <div class="women_res_aft_img_box">
                      {%- if block.settings.after != blank -%}{{ block.settings.after | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.after.alt }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
                      <p>{{ s.label_after }}</p>
                    </div>
                  </div>
                  <div class="women_result_slider_content">
                    <div class="women_result_contet_inner">
                      <p class="women_result_head">{{ block.settings.title }}</p>
                      {{ tp_stars }}
                      <p class="women_result_text">{{ block.settings.text }}</p>
                    </div>
                    <div class="women_details_row"><p class="women_name"><span>{{ block.settings.name }}</span></p></div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
            {%- if result_blocks.size > 1 -%}
              <button type="button" class="res-arrow res-prev" data-res-prev aria-label="Anterior">{{ svg_prev }}</button>
              <button type="button" class="res-arrow res-next" data-res-next aria-label="Siguiente">{{ svg_next }}</button>
              <div class="res-dots" data-res-dots>
                {%- for block in result_blocks -%}<button type="button" class="{% if forloop.first %}is-active{% endif %}" data-res-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}"></button>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- if s.res_trust_image != blank -%}
          <div class="sec1_trust_box">
            {%- if s.res_trust_image_mob != blank -%}
              <div class="hideMob">{{ s.res_trust_image | image_url: width: 1140 | image_tag: loading: 'lazy', alt: s.res_trust_image.alt }}</div>
              <div class="showMob">{{ s.res_trust_image_mob | image_url: width: 900 | image_tag: loading: 'lazy', alt: s.res_trust_image_mob.alt }}</div>
            {%- else -%}
              {{ s.res_trust_image | image_url: width: 1140 | image_tag: loading: 'lazy', alt: s.res_trust_image.alt }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 4. EL PROBLEMA ================= {%- endcomment -%}
  {%- if s.show_problem -%}
    <section class="section_2 dry-sec">
      <div class="container">
        {%- if s.pb_pre != blank -%}<p class="common_preHeading color_red mob_text_left">{{ s.pb_pre }}</p>{%- endif -%}
        <h2 class="common_heading color_black mob_text_left">{{ s.pb_heading | newline_to_br }}</h2>
        {%- if s.pb_image_mob != blank or s.pb_image != blank -%}
          {%- assign pb_m = s.pb_image_mob | default: s.pb_image -%}
          <div class="showMob"><div class="sec2_row_image_box_m">{{ pb_m | image_url: width: 900 | image_tag: loading: 'lazy', alt: pb_m.alt }}</div></div>
        {%- endif -%}
        {%- if s.pb_text != blank -%}<div class="common_parahraph mob_text_left">{{ s.pb_text }}</div>{%- endif -%}
        {%- if problem_blocks.size > 0 -%}
          <div class="section2_row">
            <div class="sec2_row_image_box hideMob">
              {%- if s.pb_image != blank -%}{{ s.pb_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: s.pb_image.alt, widths: '450, 700, 900' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
            </div>
            <div class="sec2_row_content">
              <div class="sec2_row_cont_inr">
                {%- for block in problem_blocks -%}
                  <div class="sec2_row_cont_box" {{ block.shopify_attributes }}>
                    {%- if block.settings.pretitle != blank -%}<p class="s2_row_pretile">{{ block.settings.pretitle }}</p>{%- endif -%}
                    <div class="sec2_row_cont_box_left">
                      <p class="sec2_row_heading">{{ block.settings.heading }}</p>
                      <p class="sec2_row_text">{{ block.settings.text }}</p>
                    </div>
                    <div class="sec2_row_cont_box_right">
                      {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="def-ic">{{ svg_close }}</span>{%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
        {%- if s.doc_text != blank or s.doc_name != blank -%}
          <div class="section2_doct_row">
            <div class="sec2_doct_rowLeft">
              <div class="sec2_doct_lefttop">
                <div class="sec2_doct_text">{{ s.doc_text }}</div>
                <span class="quote_icon">{{ svg_quote }}</span>
                {%- if s.doc_image != blank -%}
                  <div class="showMob"><div class="sec2_doct_imag_box">{{ s.doc_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: s.doc_name }}</div></div>
                {%- endif -%}
              </div>
              <div class="sec2_doct_leftbtm">
                {%- if s.doc_sign != blank -%}{{ s.doc_sign | image_url: width: 460 | image_tag: class: 'doct_sign', loading: 'lazy', alt: '' }}{%- endif -%}
                <p class="doct_name_text"><span class="doctnme_green">{{ s.doc_name }}</span>{% if s.doc_role != blank %}<span class="sep hideMob">|</span>{{ s.doc_role }}{% endif %}</p>
              </div>
            </div>
            {%- if s.doc_image != blank -%}
              <div class="sec2_doct_imag_box hideMob">{{ s.doc_image | image_url: width: 920 | image_tag: loading: 'lazy', alt: s.doc_name }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 5. LA SOLUCIÓN ================= {%- endcomment -%}
  {%- if s.show_solution -%}
    {%- capture s3_lists -%}
      {%- assign s3_lines = s.s3_badges | newline_to_br | split: '<br />' -%}
      {%- assign s3_clean = '' -%}
      {%- for line in s3_lines -%}{%- assign line = line | strip -%}{%- if line != blank -%}{%- assign s3_clean = s3_clean | append: line | append: '§' -%}{%- endif -%}{%- endfor -%}
      {%- assign s3_items = s3_clean | split: '§' -%}
      {%- assign s3_half = s3_items.size | plus: 1 | divided_by: 2 -%}
      <ul class="sec3_list">
        {%- for line in s3_items limit: s3_half -%}
          {%- assign ic_key = 's3_badge_icon_' | append: forloop.index -%}
          <li><div class="ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div><p>{{ line | replace: '|', '<br>' }}</p></li>
        {%- endfor -%}
      </ul>
      {%- capture s3_prod_mob -%}
        {%- if s.s3_mob_bg == blank -%}
          {%- if s.s3_product != blank -%}{{ s.s3_product | image_url: width: 400 | image_tag: class: 'section3_prod', loading: 'lazy', alt: s.s3_product.alt }}{%- endif -%}
        {%- endif -%}
      {%- endcapture -%}
      {{ s3_prod_mob }}
      <ul class="sec3_list">
        {%- for line in s3_items offset: s3_half -%}
          {%- assign idx = forloop.index | plus: s3_half -%}
          {%- assign ic_key = 's3_badge_icon_' | append: idx -%}
          <li><div class="ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div><p>{{ line | replace: '|', '<br>' }}</p></li>
        {%- endfor -%}
      </ul>
    {%- endcapture -%}
    <section class="section_3 dry-sec">
      <div class="container">
        {%- if s.s3_pre != blank -%}<p class="common_preHeading">{{ s.s3_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.s3_heading | newline_to_br }}</h2>
        {%- if s.s3_text != blank -%}<div class="common_parahraph">{{ s.s3_text }}</div>{%- endif -%}
        <div class="section3_row">
          <div class="section3_left{% if s.s3_mob_bg == blank %} no-bg{% endif %}">
            <div class="hideMob">
              {%- if s.s3_bg != blank -%}{{ s.s3_bg | image_url: width: 1100 | image_tag: class: 's3-bg', loading: 'lazy', alt: '' }}{%- endif -%}
              <div class="section3_left_iner">
                {%- if s.s3_product != blank -%}{{ s.s3_product | image_url: width: 800 | image_tag: class: 'section3_prod', loading: 'lazy', alt: s.s3_product.alt }}{%- elsif p != blank and p.featured_image != blank -%}{{ p.featured_image | image_url: width: 800 | image_tag: class: 'section3_prod', loading: 'lazy', alt: p.title }}{%- endif -%}
                {%- if s.s3_seal_1 != blank -%}{{ s.s3_seal_1 | image_url: width: 260 | image_tag: class: 's3-usa-seal', loading: 'lazy', alt: '' }}{%- endif -%}
                {%- if s.s3_seal_2 != blank -%}{{ s.s3_seal_2 | image_url: width: 260 | image_tag: class: 's3-moneyback-seal', loading: 'lazy', alt: '' }}{%- endif -%}
              </div>
            </div>
            <div class="showMob">
              <div class="s3-mob{% if s.s3_mob_bg == blank %} no-bg{% endif %}">
                {%- if s.s3_mob_bg != blank -%}{{ s.s3_mob_bg | image_url: width: 900 | image_tag: class: 's3-mob-bg', loading: 'lazy', alt: '' }}{%- endif -%}
                <div class="section3_left_iner">{{ s3_lists }}</div>
              </div>
            </div>
          </div>
          {%- assign s3f_lines = s.s3_features | newline_to_br | split: '<br />' -%}
          <div class="section3_right">
            {%- assign fi = 0 -%}
            {%- for line in s3f_lines -%}
              {%- assign line = line | strip -%}
              {%- if line != blank -%}
                {%- assign fi = fi | plus: 1 -%}
                {%- assign parts = line | split: '|' -%}
                {%- assign ic_key = 's3_feat_icon_' | append: fi -%}
                <div class="sec3_right_col">
                  <div class="sec3_right_col_iconBx ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div>
                  <div class="sec3_right_col_content">
                    <h3>{{ parts[0] | strip }}</h3>
                    {%- if parts[1] != blank -%}<p>{{ parts[1] | strip }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 6. CÓMO FUNCIONA ================= {%- endcomment -%}
  {%- if s.show_how -%}
    <section class="section_4 dry-sec">
      <div class="container">
        <div class="section4_box">
          <div class="section4_header_box">
            {%- if s.s4_pre != blank -%}<p class="common_preHeading">{{ s.s4_pre }}</p>{%- endif -%}
            <h2 class="common_heading">{{ s.s4_heading | newline_to_br }}</h2>
            {%- if s.s4_text != blank -%}<p class="sec4_text">{{ s.s4_text | newline_to_br }}</p>{%- endif -%}
            {%- if s.s4_image != blank -%}{{ s.s4_image | image_url: width: 700 | image_tag: class: 'sec4_hand_prod', loading: 'lazy', alt: '' }}{%- endif -%}
          </div>
          <div class="sec4_work_stepBox">
            {%- for n in (1..3) -%}
              {%- assign k_time = 's4_step' | append: n | append: '_time' -%}
              {%- assign k_title = 's4_step' | append: n | append: '_title' -%}
              {%- assign k_text = 's4_step' | append: n | append: '_text' -%}
              {%- assign k_img = 's4_step' | append: n | append: '_image' -%}
              <div class="sec4_work_step_col">
                <div class="sec4_step_number">{{ n }}</div>
                <div class="sec4work_step_iner">
                  <div class="sec4_step_col_top">
                    {%- if s[k_time] != blank -%}<p class="sec4_step_time_text">{{ s[k_time] }}</p>{%- endif -%}
                    <p class="sec4_step_heading">{{ s[k_title] }}</p>
                    <p class="sec4_step_text">{{ s[k_text] }}</p>
                  </div>
                  {%- if s[k_img] != blank -%}<div class="sec4_step_img_box">{{ s[k_img] | image_url: width: 600 | image_tag: loading: 'lazy', alt: s[k_title] }}</div>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          {%- if s.s4_protect_items != blank -%}
            {%- assign pr_lines = s.s4_protect_items | newline_to_br | split: '<br />' -%}
            <div class="section4_protext_box">
              {%- if s.s4_protect_title != blank -%}<p class="sec4_protect_text"><span>{{ s.s4_protect_title }}</span></p>{%- endif -%}
              <ul class="sec4_protect_list">
                {%- assign pi = 0 -%}
                {%- for line in pr_lines -%}
                  {%- assign line = line | strip -%}
                  {%- if line != blank -%}
                    {%- assign pi = pi | plus: 1 -%}
                    {%- assign ic_key = 's4_protect_icon_' | append: pi -%}
                    <li><div class="ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div><p>{{ line }}</p></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 7. ZONAS DE APLICACIÓN ================= {%- endcomment -%}
  {%- if s.show_areas and area_blocks.size > 0 -%}
    <section class="section_5 dry-sec">
      <div class="container">
        {%- if s.s5_pre != blank -%}<p class="common_preHeading">{{ s.s5_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.s5_heading | newline_to_br }}</h2>
        {%- if s.s5_text != blank -%}<p class="common_parahraph">{{ s.s5_text }}</p>{%- endif -%}
        <div class="section5_row">
          {%- for block in area_blocks -%}
            <div class="section5_col" {{ block.shopify_attributes }}>
              <div class="sec5_col_content">
                <p class="sec5_col_haeding">{{ block.settings.heading }}</p>
                <p class="sec5_col_text">{{ block.settings.text }}</p>
              </div>
              <div class="sec5_col_image_row">
                <div class="sec5_col_befr_image_Box">
                  {%- if block.settings.before != blank -%}{{ block.settings.before | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.before.alt }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
                  <p>{{ s.label_before }}</p>
                </div>
                <div class="sec5_col_aftr_image_Box">
                  {%- if block.settings.after != blank -%}{{ block.settings.after | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.after.alt }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
                  <p>{{ s.label_after }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 8. INGREDIENTES ================= {%- endcomment -%}
  {%- if s.show_ingredients and ingredient_blocks.size > 0 -%}
    {%- capture s6_prod -%}
      {%- if s.s6_product != blank -%}{{ s.s6_product | image_url: width: 800 | image_tag: class: 'sec6_product', loading: 'lazy', alt: s.s6_product.alt }}{%- elsif p != blank and p.featured_image != blank -%}{{ p.featured_image | image_url: width: 800 | image_tag: class: 'sec6_product', loading: 'lazy', alt: p.title }}{%- endif -%}
      {%- if s.s6_seal != blank -%}{{ s.s6_seal | image_url: width: 260 | image_tag: class: 's6-made-usa-seal', loading: 'lazy', alt: '' }}{%- endif -%}
    {%- endcapture -%}
    {%- assign ing_half = ingredient_blocks.size | plus: 1 | divided_by: 2 -%}
    <section class="section_6 dry-sec">
      <div class="container">
        {%- if s.s6_pre != blank -%}<p class="common_preHeading">{{ s.s6_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.s6_heading | newline_to_br }}</h2>
        {%- if s.s6_text != blank -%}<p class="common_parahraph">{{ s.s6_text }}</p>{%- endif -%}
        <div class="sec6-prod-box showTab">{{ s6_prod }}</div>
        <div class="section6_row">
          {%- for half in (1..2) -%}
            {%- if half == 1 -%}{%- assign ing_off = 0 -%}{%- assign ing_lim = ing_half -%}{%- else -%}{%- assign ing_off = ing_half -%}{%- assign ing_lim = 50 -%}{%- endif -%}
            {%- if half == 2 -%}<div class="sec6-prod-box showDesk">{{ s6_prod }}</div>{%- endif -%}
            <div class="section6_col">
              {%- for block in ingredient_blocks offset: ing_off limit: ing_lim -%}
                <div class="sec6_col_inner" {{ block.shopify_attributes }}>
                  <div class="sec6_col_icon_box ic">{%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 220 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}{{ def_ic }}{%- endif -%}</div>
                  <div class="sec6_col_content">
                    <p class="sec6_col_heading">{{ block.settings.name }}</p>
                    {%- if block.settings.strip != blank -%}<p class="sec6_col_strip">{{ block.settings.strip }}</p>{%- endif -%}
                    <p class="sec6_col_text">{{ block.settings.text }}</p>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if s.s6_benefits != blank -%}
          {%- assign bn_lines = s.s6_benefits | newline_to_br | split: '<br />' -%}
          <ul class="sec6_benefits_list">
            {%- assign bi = 0 -%}
            {%- for line in bn_lines -%}
              {%- assign line = line | strip -%}
              {%- if line != blank -%}
                {%- assign bi = bi | plus: 1 -%}
                {%- assign ic_key = 's6_benefit_icon_' | append: bi -%}
                <li><div class="ic">{%- if s[ic_key] != blank -%}{{ s[ic_key] | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ def_ic }}{%- endif -%}</div><p>{{ line }}</p></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 9. CÓMO SE USA ================= {%- endcomment -%}
  {%- if s.show_howuse -%}
    <section class="howuse-section dry-sec">
      <div class="container">
        {%- if s.hu_pre != blank -%}<p class="common_preHeading">{{ s.hu_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.hu_heading | newline_to_br }}</h2>
        {%- if s.hu_text != blank -%}<p class="common_parahraph">{{ s.hu_text }}</p>{%- endif -%}
        <div class="step-row">
          {%- for n in (1..3) -%}
            {%- assign k_title = 'hu_step' | append: n | append: '_title' -%}
            {%- assign k_text = 'hu_step' | append: n | append: '_text' -%}
            {%- assign k_img = 'hu_step' | append: n | append: '_image' -%}
            <div class="step-col">
              <p class="step-col-no-text hideMob">{{ n }}</p>
              <div class="step-col-top">
                {%- if s[k_img] != blank -%}{{ s[k_img] | image_url: width: 600 | image_tag: loading: 'lazy', alt: s[k_title] }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'dry-ph' }}{%- endif -%}
              </div>
              <div class="step-col-btm">
                <div class="showMob"><p class="step-col-no-text">{{ n }}</p></div>
                <p class="step-col-text1">{{ s[k_title] }}</p>
                <p class="step-col-text2">{{ s[k_text] }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 10. LÍNEA DE TIEMPO ================= {%- endcomment -%}
  {%- if s.show_timeline and s.tl_items != blank -%}
    {%- assign tl_lines = s.tl_items | newline_to_br | split: '<br />' -%}
    <section class="timeline-section dry-sec">
      <div class="container">
        {%- if s.tl_pre != blank -%}<p class="common_preHeading">{{ s.tl_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.tl_heading | newline_to_br }}</h2>
        {%- if s.tl_text != blank -%}<p class="common_parahraph">{{ s.tl_text }}</p>{%- endif -%}
        {%- if s.tl_image_mob != blank -%}<div class="showMob">{{ s.tl_image_mob | image_url: width: 600 | image_tag: class: 'timeline-prod-mob', loading: 'lazy', alt: '' }}</div>{%- endif -%}
        <div class="timeline-inner-box">
          <div class="timeline__mid" data-timeline>
            {%- assign ti = 0 -%}
            {%- for line in tl_lines -%}
              {%- assign line = line | strip -%}
              {%- if line != blank -%}
                {%- assign parts = line | split: '|' -%}
                {%- assign odd = ti | modulo: 2 -%}
                <div class="timeline__mid_row{% if ti == 0 %} timeline__entry_point{% endif %}{% if odd == 1 %} reverse{% endif %}">
                  <div class="timeline__row_center_step"></div>
                  <div class="timeline_mid_week_box"><div class="week_heading">{% if ti == 0 %}{{ svg_watch }}{% else %}{{ svg_calendar }}{% endif %}<span>{{ parts[0] | strip }}</span></div></div>
                  <div class="timeline__row_content_box"><p class="timeline_row_text1">{{ parts[1] | strip }}</p></div>
                </div>
                {%- assign ti = ti | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 11. LA CIENCIA ================= {%- endcomment -%}
  {%- if s.show_science -%}
    <section class="science-section dry-sec">
      <div class="science-top-sec">
        <div class="container">
          <div class="science-content-box">
            {%- if s.sc_pre != blank -%}<p class="common_preHeading">{{ s.sc_pre }}</p>{%- endif -%}
            <h2 class="common_heading">{{ s.sc_heading | newline_to_br }}</h2>
            {%- if s.sc_text != blank -%}<p class="common_parahraph hideMob">{{ s.sc_text }}</p>{%- endif -%}
          </div>
          {%- if s.sc_image != blank -%}<div class="hideMob">{{ s.sc_image | image_url: width: 940 | image_tag: class: 'science-doctor-img', loading: 'lazy', alt: s.sc_name }}</div>{%- endif -%}
        </div>
      </div>
      <div class="science-bottom-sec" data-stats>
        <div class="container">
          <div class="science-bottom-box">
            <div class="science-btm-left">
              <div class="result_box">
                {%- if s.sc_box_title != blank -%}<div class="result_box-heading">{{ s.sc_box_title }}</div>{%- endif -%}
                <div class="result_box-mdl">
                  {%- assign st_lines = s.sc_stats | newline_to_br | split: '<br />' -%}
                  {%- for line in st_lines -%}
                    {%- assign line = line | strip -%}
                    {%- if line != blank -%}
                      {%- assign parts = line | split: '|' -%}
                      {%- assign pct = parts[0] | strip | remove: '%' | plus: 0 -%}
                      <div class="result_box-row" data-pct="{{ pct }}">
                        <div class="result_per"><span data-count>{{ pct }}</span>%</div>
                        <div class="result_col">
                          <h3>{{ parts[1] | strip }}</h3>
                          <div class="result_bar"><span class="result_bar_inr"></span></div>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
            <div class="science-btm-right">
              {%- assign sc_mob = s.sc_image_mob | default: s.sc_image -%}
              {%- if sc_mob != blank -%}<div class="showMob">{{ sc_mob | image_url: width: 500 | image_tag: class: 'sci-doc-mob', loading: 'lazy', alt: s.sc_name }}</div>{%- endif -%}
              <div class="science-doctor-text">{{ s.sc_quote }}</div>
              {%- if s.sc_name != blank -%}<p class="science-doctor-name">{{ s.sc_name }}</p>{%- endif -%}
              {%- if s.sc_about != blank -%}<p class="science-doctor-about">{{ s.sc_about }}</p>{%- endif -%}
            </div>
          </div>
          {{ cta }}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 12. COMPARATIVA ================= {%- endcomment -%}
  {%- if s.show_compare and s.cmp_rows != blank -%}
    {%- assign cmp_lines = s.cmp_rows | newline_to_br | split: '<br />' -%}
    {%- assign cmp_clean = '' -%}
    {%- for line in cmp_lines -%}{%- assign line = line | strip -%}{%- if line != blank -%}{%- assign cmp_clean = cmp_clean | append: line | append: '§' -%}{%- endif -%}{%- endfor -%}
    {%- assign cmp_items = cmp_clean | split: '§' -%}
    <section class="comparison-section dry-sec">
      <div class="container">
        {%- if s.cmp_pre != blank -%}<p class="common_preHeading">{{ s.cmp_pre }}</p>{%- endif -%}
        <h2 class="common_heading">{{ s.cmp_heading | newline_to_br }}</h2>
        <div class="compare-Box" role="table" aria-label="{{ s.cmp_heading | escape }}">
          <div class="compare-col1">
            <div class="compare-top"></div>
            <ul class="compare-list">
              {%- for line in cmp_items -%}{%- assign parts = line | split: '|' -%}<li role="rowheader">{{ parts[0] | strip }}</li>{%- endfor -%}
            </ul>
          </div>
          <div class="compare-col2">
            <div class="compare-top">
              {%- if s.cmp_logo != blank -%}{{ s.cmp_logo | image_url: width: 200 | image_tag: class: 'compare-logo', loading: 'lazy', alt: s.cmp_brand }}{%- else -%}<p class="compare-logo-txt">{{ s.cmp_brand }}</p>{%- endif -%}
              {%- if s.cmp_product != blank -%}{{ s.cmp_product | image_url: width: 240 | image_tag: class: 'compare-prod-img', loading: 'lazy', alt: s.cmp_brand }}{%- elsif p != blank and p.featured_image != blank -%}{{ p.featured_image | image_url: width: 240 | image_tag: class: 'compare-prod-img', loading: 'lazy', alt: p.title }}{%- endif -%}
            </div>
            <ul class="compare-list">
              {%- for line in cmp_items -%}
                {%- assign parts = line | split: '|' -%}
                {%- assign v = parts[1] | strip | downcase -%}
                <li role="cell">{%- case v -%}{%- when 'no' -%}{{ svg_cmp_no }}{%- when 'aviso', 'a medias', '!' -%}{{ svg_cmp_warn }}{%- else -%}{{ svg_cmp_yes_light }}{%- endcase -%}</li>
              {%- endfor -%}
            </ul>
          </div>
          <div class="compare-space-col"></div>
          {%- for c in (1..3) -%}
            {%- assign k_name = 'cmp_col' | append: c | append: '_name' -%}
            {%- assign k_img = 'cmp_col' | append: c | append: '_image' -%}
            {%- assign col_i = c | plus: 1 -%}
            <div class="compare-col3">
              <div class="compare-top">
                <p>{{ s[k_name] | replace: '|', '<br>' }}</p>
                {%- if s[k_img] != blank -%}{{ s[k_img] | image_url: width: 120 | image_tag: class: 'compare-brand-img', loading: 'lazy', alt: '' }}{%- endif -%}
              </div>
              <ul class="compare-list">
                {%- for line in cmp_items -%}
                  {%- assign parts = line | split: '|' -%}
                  {%- assign v = parts[col_i] | strip | downcase -%}
                  <li role="cell">{%- case v -%}{%- when 'si', 'sí', 'yes' -%}{{ svg_cmp_yes }}{%- when 'aviso', 'a medias', '!' -%}{{ svg_cmp_warn }}{%- else -%}{{ svg_cmp_no }}{%- endcase -%}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 13. GARANTÍA ================= {%- endcomment -%}
  {%- if s.show_guarantee -%}
    <section class="guarantee-section dry-sec">
      <div class="container">
        <div class="guarantee-sec-inner">
          <div class="guarantee-box">
            {%- if s.gu_badge != blank -%}<p class="guarantee-risk-free">{{ s.gu_badge }}</p>{%- endif -%}
            {%- if s.gu_seal != blank -%}
              {{ s.gu_seal | image_url: width: 320 | image_tag: class: 'guarantee-seal', loading: 'lazy', alt: s.gu_heading }}
            {%- else -%}
              <div class="guarantee-seal-def">{{ svg_shield }}</div>
            {%- endif -%}
            <p class="guarantee-heading">{{ s.gu_heading }}</p>
            {%- if s.gu_text != blank -%}<p class="guarantee-text">{{ s.gu_text }}</p>{%- endif -%}
            {%- if s.gu_text_bold != blank -%}<p class="guarantee-text fw-600">{{ s.gu_text_bold }}</p>{%- endif -%}
            <div class="common_button_box hideMob">{{ cta_inner }}</div>
          </div>
          <div class="guarantee-right">
            {%- if s.gu_image != blank -%}{{ s.gu_image | image_url: width: 1300 | image_tag: class: 'guarantee-girl', loading: 'lazy', alt: '' }}{%- endif -%}
            {%- if s.gu_benefit_1 != blank or s.gu_benefit_2 != blank or s.gu_benefit_3 != blank -%}
              <div class="guarantee-benefit-box">
                {%- for n in (1..3) -%}
                  {%- assign k = 'gu_benefit_' | append: n -%}
                  {%- if s[k] != blank -%}<div class="guarantee-benefit-col">{{ s[k] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 14. TESTIMONIOS ================= {%- endcomment -%}
  {%- if s.show_reviews -%}
    <section class="testimonial-section dry-sec">
      <div class="container">
        <h2 class="common_heading">{{ s.rv_heading | newline_to_br }}</h2>
        <div class="testimonial-trustpilot">
          {%- if s.rv_rating_text != blank -%}<p>{{ s.rv_rating_text }}</p>{%- endif -%}
          {{ tp_stars }}
          {%- if s.rv_logo != blank -%}{{ s.rv_logo | image_url: width: 260 | image_tag: class: 'trustpilot-logo', loading: 'lazy', alt: '' }}{%- endif -%}
        </div>

        {%- if video_blocks.size > 0 -%}
          <div class="video_slide_row" data-vid>
            <div class="vid-track" data-vid-track>
              {%- for block in video_blocks -%}
                {%- liquid
                  assign vsrc = ''
                  if block.settings.video != blank
                    for src in block.settings.video.sources
                      if src.mime_type == 'video/mp4'
                        assign vsrc = src.url
                        break
                      endif
                    endfor
                    if vsrc == ''
                      assign vsrc = block.settings.video.sources.first.url
                    endif
                  endif
                  if vsrc == '' and block.settings.video_url != blank
                    assign vsrc = block.settings.video_url
                  endif
                -%}
                <div class="video_slide_col" data-vdo="{{ vsrc }}" role="button" tabindex="0" aria-label="Ver vídeo {{ forloop.index }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.poster != blank -%}
                    {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}
                  {%- elsif block.settings.video != blank -%}
                    {{ block.settings.video.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'dry-ph' }}
                  {%- endif -%}
                  <span class="ugc-play">{{ svg_play }}</span>
                </div>
              {%- endfor -%}
            </div>
            <button type="button" class="vid-btn vid-prev" data-vid-prev aria-label="Anterior">{{ svg_prev }}</button>
            <button type="button" class="vid-btn vid-next" data-vid-next aria-label="Siguiente">{{ svg_next }}</button>
            <div class="vid-dots" data-vid-dots></div>
          </div>
        {%- endif -%}

        {%- if review_blocks.size > 0 -%}
          {%- assign rv_visible = s.rv_visible | default: 3 -%}
          {%- capture review_html -%}
            {%- for block in review_blocks -%}
              {%- if forloop.index0 == rv_visible -%}
                <div class="more-review-link"><button type="button" class="more-review" data-more-reviews>{{ s.rv_more }}</button></div>
                <div class="testimonial-hide" data-hidden-reviews>
              {%- endif -%}
              <div class="testimonial-col" {{ block.shopify_attributes }}>
                <div class="testimonial-col-top">
                  {{ tp_stars }}
                  <p class="testimonial-about">{{ block.settings.text }}</p>
                </div>
                <div class="testi-verify-row">
                  <div class="testi-profile-pic">
                    {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}{{ block.settings.name | slice: 0 }}{%- endif -%}
                  </div>
                  <div class="testi-verify-col">
                    <p class="testi-verify-name">{{ block.settings.name }}{% if s.rv_verified != blank %}<span class="testi-verify-text">{{ svg_verify }}{{ s.rv_verified }}</span>{% endif %}</p>
                    {%- if block.settings.area != blank -%}<p class="testi-verify-text2">{{ block.settings.area }}</p>{%- endif -%}
                  </div>
                </div>
              </div>
              {%- if forloop.last and forloop.length > rv_visible -%}</div>{%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          <div class="testimonial-box">{{ review_html }}</div>
        {%- endif -%}
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 15. OFERTA + PACKS ================= {%- endcomment -%}
  {%- if package_blocks.size > 0 -%}
    <div class="discount-offer-section dry-sec">
      <div class="container">
        <div class="discount-offer-icn">{{ svg_watch }}</div>
        <p class="discount-offer-heading">{{ s.of_heading | newline_to_br }}</p>
      </div>
    </div>
    {%- if s.of_timer_text != blank -%}
      <div class="discount-offer-timer dry-sec">
        <div class="container">
          <p>{{ svg_watch }}{{ s.of_timer_text }} <span data-dry-timer>{{ s.timer_hours | prepend: '0' | slice: -2, 2 }}:{{ s.timer_minutes | prepend: '0' | slice: -2, 2 }}:00</span></p>
        </div>
      </div>
    {%- endif -%}
    <section class="package_section dry-sec" id="{{ pack_id }}">
      <div class="container">
        <div class="package_section-row">
          {%- for block in package_blocks -%}
            {%- liquid
              assign b = block.settings
              assign pk_variant = current_variant
              if p != blank and b.variant_index > 0 and p.variants.size >= b.variant_index
                assign vi = b.variant_index | minus: 1
                assign pk_variant = p.variants[vi]
              endif
              assign pk_qty = b.qty | default: 1
              if pk_qty < 1
                assign pk_qty = 1
              endif
              assign pk_left = 100 | minus: b.discount
              assign pk_full = 0
              assign pk_offer = 0
              assign pk_compare = 0
              if pk_variant
                assign pk_full = pk_variant.price | times: pk_qty
                assign pk_offer = pk_full | times: pk_left | divided_by: 100.0 | round
                if b.compare_price != blank
                  assign pk_compare = b.compare_price | remove: '€' | remove: '$' | strip | replace: ',', '.' | times: 100 | round
                elsif pk_variant.compare_at_price > pk_variant.price
                  assign pk_compare = pk_variant.compare_at_price | times: pk_qty
                elsif b.discount > 0
                  assign pk_compare = pk_full
                endif
              endif
              assign pk_can = false
              if pk_variant.available or s.ignore_stock
                assign pk_can = true
              endif
            -%}
            <div class="package{% if b.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
              {%- if b.badge != blank -%}<div class="most-popular" style="background:{{ b.badge_color }}">{{ b.badge }}</div>{%- endif -%}
              <p class="pkage_heading">{{ b.heading }}</p>
              {%- if b.subtitle != blank -%}<p class="areas_text">{{ b.subtitle }}</p>{%- endif -%}
              <div class="pkage_prod_box">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.heading, widths: '300, 450, 600' }}
                {%- elsif p != blank and p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.heading }}
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'dry-ph' }}
                {%- endif -%}
              </div>
              <div class="pkage_price-row">
                {%- if pk_compare > pk_offer -%}<p class="pkage_retail-price">{{ s.pk_regular_label }} <span>{{ pk_compare | money }}</span></p>{%- endif -%}
                <p class="pkage_offer-price">{% if b.price_text != blank %}{{ b.price_text }}{% else %}{{ pk_offer | money }}{% endif %}</p>
                {%- if b.show_per_unit and pk_qty > 1 -%}
                  {%- assign per_unit = pk_offer | divided_by: pk_qty -%}
                  <p class="pkage_per-unit">{{ per_unit | money }} {{ s.pk_per_unit }}</p>
                {%- endif -%}
              </div>
              <div class="btn_box">
                {%- if b.shipping_text != blank -%}<p class="btn-text1">{{ svg_truck }}<span>{{ b.shipping_text }}</span></p>{%- endif -%}
                <button type="button" class="package_btn" data-pkg-add data-variant-id="{{ pk_variant.id }}" data-qty="{{ pk_qty }}"{% unless pk_can %} disabled{% endunless %}>
                  <span>{% if pk_can %}{{ s.pk_btn }}{% else %}{{ s.sold_out_text }}{% endif %}</span>{{ svg_arrow }}
                </button>
                <p class="pkg-error" data-pkg-error hidden></p>
                {%- if s.cta_guarantee != blank -%}<p class="btn-text2">{{ svg_shield }}{{ s.cta_guarantee }}</p>{%- endif -%}
              </div>
              {%- if s.pk_card_image != blank -%}{{ s.pk_card_image | image_url: width: 400 | image_tag: class: 'pkage-card-img', loading: 'lazy', alt: '' }}{%- endif -%}
              {%- if s.show_ship_msg -%}
                <div class="shipping-calculate-date">
                  <div class="shipping__message shipping__message--today"><strong class="shipping__message-highlight">{{ s.ship_today }}</strong> {{ s.ship_within }} <span class="remain-time"></span></div>
                  <div class="shipping__message shipping__message--tomorrow"><strong class="shipping__message-highlight">{{ s.ship_tomorrow }}</strong> {{ s.ship_within }} <span class="within-time"></span></div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 16. PREGUNTAS FRECUENTES ================= {%- endcomment -%}
  {%- if s.show_faq and faq_blocks.size > 0 -%}
    <section class="faq-section dry-sec">
      <div class="container">
        <h2 class="common_heading">{{ s.faq_heading | newline_to_br }}</h2>
        <div class="faq-container" data-faq>
          {%- for block in faq_blocks -%}
            {%- assign open = false -%}
            {%- if forloop.first and s.faq_first_open -%}{%- assign open = true -%}{%- endif -%}
            <div class="faq-row" {{ block.shopify_attributes }}>
              <div class="acdn-heading{% if open %} accordion-open{% endif %}" role="button" tabindex="0" aria-expanded="{{ open }}" aria-controls="faq-{{ block.id }}">
                <div class="faq-header-img">
                  {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ block.settings.asker | slice: 0 }}{%- endif -%}
                </div>
                <div class="faq-header">
                  {%- if block.settings.asker != blank -%}<p class="faq-subheading">{{ block.settings.asker }}</p>{%- endif -%}
                  <p class="faq-heading">{{ block.settings.question }}</p>
                </div>
                {{ svg_plus }}
              </div>
              <div class="acdn-content" id="faq-{{ block.id }}"{% if open %} style="max-height:none"{% endif %}>
                <div class="acdn-content-inner acdn-para">{{ block.settings.answer }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {{ cta }}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= BOTÓN FIJO EN MÓVIL ================= {%- endcomment -%}
  {%- if s.show_mobile_sticky and package_blocks.size > 0 -%}
    <div class="call-btn" data-call-btn>
      <a class="common_button" href="#{{ pack_id }}" data-dry-scroll><p>{{ s.cta_text }}</p>{{ svg_arrow }}</a>
    </div>
  {%- endif -%}

  <div class="dry-ugc-modal" data-ugc-modal aria-hidden="true">
    <div class="video-container">
      <button type="button" class="ugc-close" data-ugc-close aria-label="Cerrar">{{ svg_close }}</button>
      <video playsinline controls preload="none"></video>
    </div>
  </div>
  <div class="dry-toast" data-dry-toast role="status" aria-live="polite"></div>
</div>

<script>
(function () {
  if (window.DrynivaLanding) { window.DrynivaLanding.initAll(); return; }

  function $$(root, sel) { return [].slice.call(root.querySelectorAll(sel)); }
  function debounce(fn, ms) { var t; return function () { clearTimeout(t); t = setTimeout(fn, ms); }; }
  function pad(n) { return String(n).padStart(2, '0'); }

  function Landing(root) {
    this.root = root;
    var self = this;
    ['initScroll', 'initResults', 'initVideos', 'initReviews', 'initFaq', 'initTimer',
     'initTimeline', 'initStats', 'initShipping', 'initSticky', 'initCart'].forEach(function (fn) {
      try { self[fn](); } catch (err) { console.error('[Dryniva] ' + fn, err); }
    });
  }

  /* ---------- botones "Pedir ahora": bajan hasta los packs ---------- */
  Landing.prototype.initScroll = function () {
    this.root.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-dry-scroll]');
      if (!a) return;
      var target = document.querySelector(a.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - 10, behavior: 'smooth' });
    });
  };

  /* ---------- slider de resultados (infinito, con pestañas) ---------- */
  Landing.prototype.initResults = function () {
    var wrap = this.root.querySelector('[data-res]');
    if (!wrap) return;
    var track = wrap.querySelector('[data-res-track]');
    track.style.position = 'relative';
    var originals = $$(track, '[data-res-slide]');
    var n = originals.length;
    var tabs = $$(wrap, '[data-res-tab]');
    var dots = $$(wrap, '[data-res-dot]');
    if (n < 2) return;

    function cloneAll(before) {
      var frag = document.createDocumentFragment();
      originals.forEach(function (el) {
        var c = el.cloneNode(true);
        c.removeAttribute('data-shopify-editor-block');
        c.setAttribute('aria-hidden', 'true');
        c.classList.remove('is-active');
        frag.appendChild(c);
      });
      if (before) track.insertBefore(frag, track.firstChild); else track.appendChild(frag);
    }
    cloneAll(true); cloneAll(false);
    var slides = $$(track, '[data-res-slide]');
    var pos = n;

    function leftFor(i) { var sl = slides[i]; return sl.offsetLeft + sl.offsetWidth / 2 - track.clientWidth / 2; }
    function jump(i) {
      track.classList.add('no-smooth');
      track.scrollTo({ left: leftFor(i), behavior: 'instant' });
      requestAnimationFrame(function () { track.classList.remove('no-smooth'); });
    }
    function mark(i) {
      pos = i;
      var real = ((i % n) + n) % n;
      slides.forEach(function (sl, k) { sl.classList.toggle('is-active', k === i); });
      tabs.forEach(function (t, k) { t.classList.toggle('is-active', k === real); });
      dots.forEach(function (d, k) { d.classList.toggle('is-active', k === real); });
    }
    function go(i) { mark(i); track.scrollTo({ left: leftFor(i), behavior: 'smooth' }); }
    function nearest() {
      var c = track.scrollLeft + track.clientWidth / 2, best = 0, bd = Infinity;
      slides.forEach(function (sl, k) { var d = Math.abs(sl.offsetLeft + sl.offsetWidth / 2 - c); if (d < bd) { bd = d; best = k; } });
      return best;
    }
    var settle = debounce(function () {
      var i = nearest();
      if (i < n || i >= 2 * n) { i = n + (i % n); jump(i); }
      mark(i);
    }, 120);
    track.addEventListener('scroll', function () {
      var i = nearest();
      if (i !== pos) mark(i);
      settle();
    }, { passive: true });

    tabs.forEach(function (t) { t.addEventListener('click', function () { go(n + (+t.dataset.resTab)); }); });
    dots.forEach(function (d) { d.addEventListener('click', function () { go(n + (+d.dataset.resDot)); }); });
    var prev = wrap.querySelector('[data-res-prev]'), next = wrap.querySelector('[data-res-next]');
    if (prev) prev.addEventListener('click', function () { go(pos - 1); });
    if (next) next.addEventListener('click', function () { go(pos + 1); });
    slides.forEach(function (sl, k) { sl.addEventListener('click', function () { if (k !== pos) go(k); }); });

    function reset() { jump(pos); mark(pos); }
    requestAnimationFrame(reset);
    window.addEventListener('load', reset);
    window.addEventListener('resize', debounce(reset, 150));
    this.root.addEventListener('shopify:block:select', function (e) {
      var k = originals.indexOf(e.target);
      if (k > -1) go(n + k);
    });
  };

  /* ---------- vídeos de clientes ---------- */
  Landing.prototype.initVideos = function () {
    var root = this.root;
    var wrap = root.querySelector('[data-vid]');
    var modal = root.querySelector('[data-ugc-modal]');
    if (modal) {
      // El visor va directo al <body> para quedar por encima de todo
      var old = document.getElementById('dry-modal-' + root.id);
      if (old && old !== modal) old.remove();
      modal.id = 'dry-modal-' + root.id;
      document.body.appendChild(modal);
    }
    if (!wrap) return;
    var track = wrap.querySelector('[data-vid-track]');
    var cards = $$(track, '.video_slide_col');
    var dotsBox = wrap.querySelector('[data-vid-dots]');
    var dots = cards.map(function (c, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.setAttribute('aria-label', String(i + 1));
      b.addEventListener('click', function () { goTo(i); });
      dotsBox.appendChild(b);
      return b;
    });
    function step() { return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
    function centered() { return window.matchMedia('(max-width:767px)').matches; }
    function current() {
      var best = 0, bd = Infinity;
      var ref = centered() ? track.scrollLeft + track.clientWidth / 2 : track.scrollLeft;
      cards.forEach(function (c, i) {
        var p = centered() ? c.offsetLeft + c.offsetWidth / 2 : c.offsetLeft - cards[0].offsetLeft;
        var d = Math.abs(p - ref); if (d < bd) { bd = d; best = i; }
      });
      return best;
    }
    function goTo(i) {
      i = Math.max(0, Math.min(cards.length - 1, i));
      var c = cards[i];
      var left = centered() ? c.offsetLeft + c.offsetWidth / 2 - track.clientWidth / 2 : c.offsetLeft - cards[0].offsetLeft;
      track.scrollTo({ left: left, behavior: 'smooth' });
    }
    function paint() { var i = current(); dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); }); }
    track.style.position = 'relative';
    track.addEventListener('scroll', debounce(paint, 60), { passive: true });
    paint();
    wrap.querySelector('[data-vid-prev]').addEventListener('click', function () { var i = current(); goTo(i <= 0 ? cards.length - 1 : i - 1); });
    wrap.querySelector('[data-vid-next]').addEventListener('click', function () { var i = current(); var max = cards.length - 1; goTo(i >= max || track.scrollLeft + track.clientWidth >= track.scrollWidth - 4 ? 0 : i + 1); });

    if (!modal) return;
    var video = modal.querySelector('video');
    function open(src) {
      if (!src) return;
      video.src = src; video.load();
      modal.classList.add('active'); modal.setAttribute('aria-hidden', 'false');
      var pr = video.play(); if (pr && pr.catch) pr.catch(function () {});
    }
    function close() { video.pause(); video.removeAttribute('src'); video.load(); modal.classList.remove('active'); modal.setAttribute('aria-hidden', 'true'); }
    cards.forEach(function (c) {
      c.addEventListener('click', function () { open(c.dataset.vdo); });
      c.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(c.dataset.vdo); } });
    });
    modal.addEventListener('click', function (e) { if (e.target === modal || e.target.closest('[data-ugc-close]')) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('active')) close(); });
  };

  /* ---------- "Leer más reseñas" ---------- */
  Landing.prototype.initReviews = function () {
    var btn = this.root.querySelector('[data-more-reviews]');
    var box = this.root.querySelector('[data-hidden-reviews]');
    if (!btn || !box) return;
    btn.addEventListener('click', function () { box.classList.add('is-open'); btn.parentNode.style.display = 'none'; });
  };

  /* ---------- preguntas frecuentes (una abierta a la vez) ---------- */
  Landing.prototype.initFaq = function () {
    var root = this.root;
    var heads = $$(root, '[data-faq] .acdn-heading');
    function setOpen(h, open) {
      var body = h.nextElementSibling;
      h.classList.toggle('accordion-open', open);
      h.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        body.style.maxHeight = body.scrollHeight + 'px';
      } else {
        if (body.style.maxHeight === 'none') { body.style.maxHeight = body.scrollHeight + 'px'; body.offsetHeight; }
        body.style.maxHeight = '0px';
      }
    }
    heads.forEach(function (h) {
      function toggle() {
        var open = !h.classList.contains('accordion-open');
        heads.forEach(function (o) { if (o !== h && o.classList.contains('accordion-open')) setOpen(o, false); });
        setOpen(h, open);
      }
      h.addEventListener('click', toggle);
      h.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
    });
  };

  /* ---------- cuenta atrás del descuento ---------- */
  Landing.prototype.initTimer = function () {
    var el = this.root.querySelector('[data-dry-timer]');
    if (!el) return;
    var total = ((+this.root.dataset.timerH || 0) * 3600 + (+this.root.dataset.timerM || 0) * 60) * 1000;
    if (!total) return;
    var key = 'dryTimer-' + this.root.id, end = 0;
    try { end = +sessionStorage.getItem(key) || 0; } catch (e) {}
    if (!end || end < Date.now()) { end = Date.now() + total; try { sessionStorage.setItem(key, end); } catch (e) {} }
    function tick() {
      var left = end - Date.now();
      if (left <= 0) { end = Date.now() + total; try { sessionStorage.setItem(key, end); } catch (e) {} left = total; }
      var sec = Math.floor(left / 1000);
      el.textContent = pad(Math.floor(sec / 3600)) + ':' + pad(Math.floor(sec % 3600 / 60)) + ':' + pad(sec % 60);
    }
    tick(); setInterval(tick, 1000);
  };

  /* ---------- línea de tiempo que se va rellenando al hacer scroll ---------- */
  Landing.prototype.initTimeline = function () {
    var box = this.root.querySelector('[data-timeline]');
    if (!box) return;
    var steps = $$(box, '.timeline__row_center_step');
    var contents = $$(box, '.timeline__row_content_box');
    var entry = box.querySelector('.timeline__mid_row');
    if (!steps.length) return;
    function center(el) { var r = el.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }
    function dist(a, b) { var p = center(a), q = center(b); return Math.sqrt(Math.pow(q.x - p.x, 2) + Math.pow(q.y - p.y, 2)); }
    var total = 0, stepD = [], ticking = false;
    function measure() {
      total = dist(steps[0], steps[steps.length - 1]);
      entry.style.setProperty('--timeline-height', total + 'px');
      stepD = steps.map(function (s) { return dist(steps[0], s); });
    }
    function update() {
      ticking = false;
      var r = box.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      var off = r.top - window.innerHeight * 0.85, h, force = null;
      if (off > 0) { h = 0; force = false; }
      else if (off <= -r.height) { h = total; force = true; }
      else { h = Math.min(Math.abs(off) / r.height, 1) * total; }
      entry.style.setProperty('--timeline-height-dynamic', h + 'px');
      steps.forEach(function (s, i) {
        var on = force !== null ? force : h >= stepD[i] - 1;
        s.classList.toggle('viewing', on);
        if (contents[i]) contents[i].classList.toggle('viewing', on);
      });
    }
    measure(); update();
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', debounce(function () { measure(); update(); }, 150));
    window.addEventListener('load', function () { measure(); update(); });
  };

  /* ---------- barras y porcentajes animados ---------- */
  Landing.prototype.initStats = function () {
    var box = this.root.querySelector('[data-stats]');
    if (!box) return;
    var rows = $$(box, '[data-pct]');
    var done = false;
    function run() {
      if (done) return; done = true;
      rows.forEach(function (row) {
        var end = +row.dataset.pct || 0;
        var bar = row.querySelector('.result_bar_inr'); if (bar) bar.style.width = end + '%';
        var num = row.querySelector('[data-count]'); if (!num || !end) return;
        var t0 = null;
        function frame(t) {
          if (!t0) t0 = t;
          var k = Math.min((t - t0) / 1500, 1);
          num.textContent = Math.round(end * k);
          if (k < 1) requestAnimationFrame(frame);
        }
        num.textContent = '0';
        requestAnimationFrame(frame);
      });
    }
    if (!('IntersectionObserver' in window) || document.documentElement.classList.contains('shopify-design-mode')) { run(); return; }
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { run(); io.disconnect(); } }); }, { threshold: 0.2 });
    io.observe(box);
  };

  /* ---------- "Se envía hoy si lo pides en…" ---------- */
  Landing.prototype.initShipping = function () {
    var root = this.root;
    var today = $$(root, '.shipping__message--today');
    if (!today.length) return;
    var tomorrow = $$(root, '.shipping__message--tomorrow');
    var remain = $$(root, '.remain-time'), within = $$(root, '.within-time');
    var cutoff = +root.dataset.cutoff; if (isNaN(cutoff)) cutoff = 14;
    function fmt(ms) {
      var s = Math.floor(ms / 1000);
      return Math.floor(s / 3600) + 'h ' + Math.floor(s % 3600 / 60) + 'min ' + (s % 60) + 's';
    }
    function tick() {
      var now = new Date();
      var cut = new Date(now.getFullYear(), now.getMonth(), now.getDate(), cutoff, 0, 0);
      var isToday = now < cut;
      if (!isToday) cut = new Date(cut.getTime() + 86400000);
      var txt = fmt(cut - now);
      today.forEach(function (el) { el.style.display = isToday ? 'block' : 'none'; });
      tomorrow.forEach(function (el) { el.style.display = isToday ? 'none' : 'block'; });
      (isToday ? remain : within).forEach(function (el) { el.textContent = txt; });
    }
    tick(); setInterval(tick, 1000);
  };

  /* ---------- botón fijo en móvil ---------- */
  Landing.prototype.initSticky = function () {
    var root = this.root;
    var btn = root.querySelector('[data-call-btn]');
    if (!btn) return;
    var trigger = root.querySelector('[data-sticky-trigger]');
    var packs = root.querySelector('.package_section');
    var packsVisible = false;
    if (packs && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { packsVisible = e.isIntersecting; }); update(); }).observe(packs);
    }
    function update() {
      var past = trigger ? trigger.getBoundingClientRect().bottom + 100 < 0 : window.pageYOffset > 600;
      var rr = root.getBoundingClientRect();
      var inside = rr.bottom > window.innerHeight * 0.6;
      btn.classList.toggle('is-visible', past && !packsVisible && inside);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  };

  /* ---------- añadir al carrito ---------- */
  Landing.prototype.toast = function (msg) {
    var t = this.root.querySelector('[data-dry-toast]') || document.getElementById('dry-toast-' + this.root.id);
    if (!t || !msg) return;
    if (t.parentNode !== document.body) { t.id = 'dry-toast-' + this.root.id; document.body.appendChild(t); }
    t.textContent = msg; t.classList.add('is-visible');
    clearTimeout(this._tt); this._tt = setTimeout(function () { t.classList.remove('is-visible'); }, 3500);
  };
  Landing.prototype.initCart = function () {
    var self = this, root = this.root;
    $$(root, '[data-pkg-add]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = +btn.dataset.variantId, qty = +btn.dataset.qty || 1;
        if (!id) return;
        var err = btn.parentNode.querySelector('[data-pkg-error]');
        if (err) err.hidden = true;
        btn.classList.add('is-loading');
        var mode = root.dataset.afterAdd;
        var drawer = document.querySelector('cart-drawer');
        var body = { items: [{ id: id, quantity: qty }] };
        if (mode === 'drawer' && drawer && typeof drawer.getSectionsToRender === 'function') {
          body.sections = drawer.getSectionsToRender().map(function (s) { return s.id; });
          body.sections_url = window.location.pathname;
        }
        fetch(root.dataset.cartAddUrl + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.data.description || res.data.message || root.dataset.errorMsg);
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('dryniva:added', { detail: res.data }));
            if (mode === 'checkout') { window.location.href = '/checkout'; return; }
            if (mode === 'toast') { self.toast(root.dataset.addedMsg); return; }
            if (mode === 'drawer') {
              if (window.WakeCartDrawer && window.WakeCartDrawer.open) { window.WakeCartDrawer.open(); return; }
              if (drawer && typeof drawer.renderContents === 'function' && res.data.sections) {
                drawer.classList.remove('is-empty');
                drawer.renderContents(res.data);
                return;
              }
            }
            window.location.href = root.dataset.cartUrl;
          })
          .catch(function (e) {
            var m = (e && e.message) || root.dataset.errorMsg;
            if (err) { err.textContent = m; err.hidden = false; }
            self.toast(m);
          })
          .finally(function () { btn.classList.remove('is-loading'); });
      });
    });
  };

  Landing.initAll = function () {
    document.querySelectorAll('[data-dry-root]').forEach(function (root) {
      if (root.__dry) return;
      root.__dry = new Landing(root);
    });
  };

  window.DrynivaLanding = Landing;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', Landing.initAll);
  else Landing.initAll();
  document.addEventListener('shopify:section:load', Landing.initAll);
})();
</script>
