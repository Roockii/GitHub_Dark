.dry .sec4_work_stepBox{display:flex;flex-wrap:wrap;justify-content:space-between;width:100%;background:#f4fcf5;border-radius:10px;box-shadow:0 0 7px 3px rgba(0,0,0,.2);padding:30px;position:relative;}
