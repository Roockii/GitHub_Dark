{%- comment -%}
  DRYNIVA — LANDING DE PRODUCTO (todo en un archivo)
  Añádela a la plantilla "Producto predeterminado" desde Personalizar.
  No incluye header ni footer: esos van en sus propias secciones del tema.
  Usa el producto de la página, así que funciona para todos los productos.
{%- endcomment -%}

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

/* =========================================================
   BASE — todo va dentro de .dry para no interferir con el tema
   ========================================================= */
.dry{
  --dk:#13494b;--sage:#5c735e;--lt:#f1f7f2;--gray:#f5f5f5;--hero:#f9fcf9;
  --btn1:#02b432;--btn2:#13db3f;--red:#d21113;--ink:#000;--star:#00b67a;
  font-family:'Inter',ui-sans-serif,system-ui,sans-serif;font-weight:400;color:var(--ink);background:#fff;
  text-align:center;font-size:16px;line-height:1.4;-webkit-font-smoothing:antialiased;overflow-x:clip;
}
.dry *,.dry *::before,.dry *::after{box-sizing:border-box;}
.dry div,.dry ul,.dry h1,.dry h2,.dry h3,.dry h4,.dry li,.dry p,.dry img,.dry form{margin:0;padding:0;}
.dry h1,.dry h2,.dry h3,.dry h4{font-family:inherit;letter-spacing:normal;text-transform:none;}
.dry li{list-style:none;}
.dry a{color:inherit;text-decoration:none;outline:none;}
.dry img{border:none;height:auto;max-width:100%;}
.dry button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;}
.dry .container{width:1170px;max-width:100%;margin:0 auto;padding:0;position:relative;}
.dry .showMob,.dry .showTab{display:none;}
.dry .dry-ph{display:block;width:100%;height:auto;background:#e8eee9;fill:#b9c7bb;border-radius:10px;}
.dry .dry-sec{width:100%;}

/* ---------- títulos comunes ---------- */
.dry .common_preHeading{font-size:20px;line-height:20px;color:var(--sage);font-weight:700;margin-bottom:8px;}
.dry .common_heading{font-size:40px;line-height:46px;font-weight:700;color:var(--dk);}
.dry .common_parahraph{font-size:17px;line-height:25px;color:#000;margin-top:20px;}
.dry .common_parahraph p+p{margin-top:12px;}
.dry .color_heading_green1{color:#14331f;}
.dry .color_red{color:#f70000;}
.dry .color_black{color:#000;}

/* ---------- caja del botón (se repite en cada sección) ---------- */
.dry .common_button_box{display:inline-block;vertical-align:middle;width:100%;max-width:415px;margin-top:35px;text-align:center;}
.dry .button_shipp{display:flex;align-items:center;justify-content:center;width:100%;margin-bottom:10px;}
.dry .button_shipp li{display:flex;align-items:center;font-size:14px;line-height:14px;color:#000;font-weight:500;padding:0 10px;column-gap:6px;}
.dry .button_shipp li.green_dot{border-right:1px solid #000;padding-left:0;}
.dry .button_shipp li.stock_level{padding-right:0;}
.dry .sale_fire{font-size:13px;line-height:1;}
.dry .low_stock{display:flex;justify-content:space-between;width:68px;margin:0 3px;}
.dry .low_stock span{width:16.38%;height:11px;background:#fff;border:1px solid #000;}
.dry .low_stock span.active{background:red;}
.dry .low_stock span.fade{animation:dry-fade 1.2s ease-in-out infinite;background:red;}
@keyframes dry-fade{0%{opacity:1}50%{opacity:.1}to{opacity:1}}
.dry .red-text{color:red;text-transform:uppercase;font-weight:700;}
.dry .common_button{width:100%;height:62px;background:var(--btn1);background:linear-gradient(90deg,var(--btn1),var(--btn2));display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 4px 8px 2px color-mix(in srgb,var(--btn1) 30%,transparent);overflow:hidden;font-size:22px;font-weight:700;color:#fff;border-radius:50px;column-gap:15px;cursor:pointer;transition:filter .2s,transform .2s;padding:0 22px;line-height:1.15;text-align:center;}
.dry .common_button:hover{filter:brightness(1.06);transform:translateY(-1px);}
.dry .common_button p{margin-top:-2px;}
.dry .common_button svg{width:19px;height:19px;flex-shrink:0;}
.dry .button_mbk_text{display:flex;align-items:center;justify-content:center;margin:12px auto 0;font-size:13px;line-height:13px;color:#000;font-weight:500;column-gap:5px;}
.dry .button_mbk_text svg{width:14px;height:14px;flex-shrink:0;color:var(--sage);}

/* =========================================================
   1. BANNER (hero)
   ========================================================= */
.dry .banner{width:100%;padding:45px 0 55px;background-color:var(--hero);background-repeat:no-repeat;background-position:center top;background-size:cover;overflow:hidden;}
.dry .banner_row{display:flex;flex-wrap:wrap;justify-content:flex-start;width:100%;}
.dry .banner_content{width:55%;text-align:left;}
.dry .bnr_trusted_text{font-size:15px;line-height:21px;color:#000;font-weight:500;display:flex;align-items:center;justify-content:flex-start;column-gap:7px;margin-bottom:5px;flex-wrap:wrap;}
.dry .bnr_trusted_text .stars-row{display:inline-flex;gap:2px;}
.dry .bnr_trusted_text .stars-row svg{width:18px;height:18px;}
.dry .trust_people{width:102px;flex-shrink:0;}
.dry .banner_heading{font-size:50px;line-height:60px;font-weight:800;color:var(--dk);}
.dry .banner_strip{display:inline-block;vertical-align:middle;width:85%;margin-top:20px;background:linear-gradient(90deg,#e7e7e7 0% 57%,rgba(231,231,231,0));padding:1px 0;}
.dry ul.banner_strip_list{display:flex;align-items:center;justify-content:flex-start;width:100%;background:var(--hero);padding:10px 0;column-gap:20px;}
.dry ul.banner_strip_list li{display:flex;align-items:center;gap:5px;font-size:18px;line-height:26px;color:#000;font-weight:600;text-align:left;}
.dry ul.banner_strip_list li svg{width:15px;height:15px;flex-shrink:0;color:var(--btn1);}
.dry .banner_text{font-size:16px;line-height:23px;color:#0e213a;margin-top:25px;padding-right:20px;}
.dry ul.banner_point{display:inline-block;width:100%;margin-top:20px;}
.dry ul.banner_point li{display:flex;align-items:flex-start;gap:11px;width:100%;margin-top:10px;text-align:left;font-size:18px;line-height:26px;color:#000;font-weight:600;}
.dry ul.banner_point li svg{width:17px;height:17px;flex-shrink:0;margin-top:4px;}
.dry .banner_right{width:38%;}
.dry .banner_prod_box{display:flex;align-items:center;justify-content:center;width:100%;margin:0 auto;position:relative;}
.dry .banner_bfr_aftr{width:236px;flex-shrink:0;margin:60px -70px 0 0;position:relative;z-index:1;}
.dry .banner_bfr_aftr img{border-radius:10px;}
.dry .banner_prod{width:307px;flex-shrink:0;}
.dry .banner-prod-seal{position:absolute;right:-30px;top:-10px;width:120px;z-index:2;}
.dry .banner_right_workBox{display:inline-table;vertical-align:middle;width:90%;margin-top:20px;}
.dry .bnr_work_heading{display:flex;align-items:center;justify-content:center;font-size:16px;line-height:22px;color:#000;font-weight:700;width:85%;column-gap:15px;margin:0 auto;}
.dry .bnr_work_heading:before,.dry .bnr_work_heading:after{content:"";height:1px;width:100%;background:color-mix(in srgb,var(--sage) 20%,transparent);}
.dry .bnr_work_heading span{flex-shrink:0;}
.dry ul.bnr_work_list{display:flex;align-items:flex-start;justify-content:space-between;width:100%;margin:15px auto 0;}
.dry ul.bnr_work_list li{text-align:center;flex:1;}
.dry ul.bnr_work_list li .ic{width:45px;height:45px;margin:0 auto 5px;display:flex;align-items:center;justify-content:center;}
.dry ul.bnr_work_list li p{font-size:12px;line-height:16px;color:#000;font-weight:700;}

/* iconos por defecto (cuando no subes imagen) */
.dry .def-ic{width:100%;height:100%;border-radius:50%;background:#e9faeb;color:var(--sage);display:flex;align-items:center;justify-content:center;}
.dry .def-ic svg{width:55%;height:55%;}
.dry .ic img{width:100%;height:100%;object-fit:contain;}

/* =========================================================
   2. CINTA EN MOVIMIENTO
   ========================================================= */
.dry .scroll_strip{position:relative;width:100%;overflow:hidden;background:var(--dk);padding:17px 0;}
.dry .scroll_slider{width:100%;display:flex;flex-wrap:nowrap;}
.dry .slider_track{display:flex;flex-wrap:nowrap;align-items:center;justify-content:center;flex-shrink:0;animation:dry-marquee var(--marquee-speed,30s) linear infinite;}
@keyframes dry-marquee{0%{transform:translate(0)}to{transform:translate(-100%)}}
.dry .slider_track li{font-size:15px;line-height:17px;color:#fff;font-weight:700;position:relative;padding:0 30px;letter-spacing:.5px;white-space:nowrap;}
.dry .slider_track li:after{content:"";position:absolute;top:6px;right:-2px;background:#d3e7e8;width:6px;height:6px;border-radius:50%;}

/* =========================================================
   3. RESULTADOS (slider antes/después)
   ========================================================= */
.dry .section_1{padding:65px 0 70px;}
.dry .section_1 .common_parahraph{margin-top:10px;}
.dry .section1_result_block{display:flex;flex-direction:column;justify-content:center;margin:40px auto 0;width:100%;row-gap:20px;}
.dry .nav_row{display:flex;justify-content:center;max-width:645px;width:100%;margin:0 auto;gap:8px;}
.dry .res-tab{cursor:pointer;border-radius:4px;border:1px solid var(--sage);background:#fff;padding:7px 12px 9px;flex:1;transition:background .2s,color .2s;}
.dry .res-tab p{font-size:15px;line-height:20px;color:#000;font-weight:600;}
.dry .res-tab.is-active{background:var(--sage);border-radius:5px;}
.dry .res-tab.is-active p{color:#fff;}
.dry .result_inner_swipe{position:relative;width:100%;padding:0 50px;}
.dry .res-track{display:flex;gap:21px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:13px 0;scroll-behavior:smooth;}
.dry .res-track::-webkit-scrollbar{display:none;}
.dry .res-track.no-smooth{scroll-behavior:auto;}
.dry .women_result_slider__box{flex:0 0 calc((100% - 42px)/3);scroll-snap-align:center;position:relative;text-align:center;background:#fff;border-radius:12px;border:1px solid #d7d7d7;padding:10px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;box-shadow:0 0 7px 3px rgba(0,0,0,.1);transition:border-color .3s;}
.dry .women_result_slider__box.is-active{border-color:var(--sage);}
.dry .women_result_slider_image_box{display:flex;justify-content:space-between;width:100%;position:relative;}
.dry .women_res_bef_img_box,.dry .women_res_aft_img_box{width:49.4%;position:relative;aspect-ratio:1/1.15;overflow:hidden;}
.dry .women_res_bef_img_box img,.dry .women_res_aft_img_box img,.dry .women_res_bef_img_box .dry-ph,.dry .women_res_aft_img_box .dry-ph{width:100%;height:100%;object-fit:cover;display:block;}
.dry .women_res_bef_img_box img,.dry .women_res_bef_img_box .dry-ph{border-radius:10px 0 0 0;}
.dry .women_res_aft_img_box img,.dry .women_res_aft_img_box .dry-ph{border-radius:0 10px 0 0;}
.dry .women_res_bef_img_box p,.dry .women_res_aft_img_box p{position:absolute;font-size:11px;line-height:12px;font-weight:700;color:#000;background:#fff;border-radius:4px;padding:4px 5px;left:10px;top:10px;text-transform:uppercase;min-width:65px;text-align:center;}
.dry .women_res_aft_img_box p{background:#000;color:#fff;}
.dry .women_prob_text_name{font-size:11px;line-height:14px;color:var(--sage);font-weight:700;background:#fff;border-radius:50px;position:absolute;bottom:-11px;left:50%;transform:translate(-50%);min-width:110px;z-index:1;text-transform:uppercase;padding:6px 12px 5px;white-space:nowrap;}
.dry .women_result_slider_content{display:flex;justify-content:space-between;flex-direction:column;flex:1;width:100%;text-align:center;padding:25px 9px 14px;}
.dry .women_result_contet_inner{width:100%;padding-bottom:25px;}
.dry .women_result_head{font-size:17px;line-height:25px;color:#000;font-weight:700;}
.dry .tp-stars{display:inline-flex;gap:2px;margin:10px auto 0;}
.dry .tp-stars span{width:16px;height:16px;background:var(--star);display:inline-flex;align-items:center;justify-content:center;}
.dry .tp-stars svg{width:12px;height:12px;fill:#fff;}
.dry .women_result_text{font-size:16px;line-height:24px;color:#000;margin-top:15px;}
.dry .women_name{font-size:15px;line-height:20px;color:#000;}
.dry .women_name span{font-weight:700;}
.dry .res-arrow{position:absolute;top:50%;margin-top:-20px;width:40px;height:40px;border:1px solid var(--sage);border-radius:50%;background:#fff;color:var(--sage);display:flex;align-items:center;justify-content:center;z-index:2;}
.dry .res-arrow svg{width:18px;height:18px;}
.dry .res-prev{left:0;}.dry .res-next{right:0;}
.dry .res-dots{display:none;justify-content:center;gap:6px;margin-top:8px;}
.dry .res-dots button{width:8px;height:8px;border-radius:50%;background:#c7d1c8;}
.dry .res-dots button.is-active{background:var(--sage);}
.dry .sec1_trust_box{display:flex;justify-content:center;align-items:center;width:100%;margin:30px auto 0;max-width:570px;border-radius:10px;overflow:hidden;box-shadow:0 0 0 1px #819182;}
.dry .sec1_trust_box img{display:block;width:100%;}

/* =========================================================
   4. EL PROBLEMA
   ========================================================= */
.dry .section_2{padding:65px 0 0;background:var(--gray);overflow:hidden;}
.dry .section2_row{display:flex;flex-wrap:wrap;justify-content:space-between;margin:50px auto 0;width:100%;max-width:970px;}
.dry .sec2_row_image_box{width:46.09%;}
.dry .sec2_row_image_box img{display:block;margin:0 auto;border-radius:10px;}
.dry .sec2_row_content{width:50%;text-align:left;}
.dry .sec2_row_cont_inr{display:flex;flex-direction:column;width:100%;row-gap:15px;}
.dry .sec2_row_cont_box{display:flex;justify-content:space-between;align-items:center;width:100%;border:1px solid var(--red);position:relative;padding:10px 17px;margin-top:5px;}
.dry .s2_row_pretile{font-size:12px;line-height:16px;color:var(--red);font-weight:600;position:absolute;padding:0 8px;background:var(--gray);left:15px;top:-8px;text-transform:uppercase;}
.dry .sec2_row_cont_box_left{text-align:left;padding-right:5px;}
.dry .sec2_row_heading{font-size:20px;line-height:24px;color:#000;font-weight:600;}
.dry .sec2_row_text{font-size:17px;line-height:22px;color:#000;margin-top:5px;}
.dry .sec2_row_cont_box_right{flex-shrink:0;width:66px;height:66px;}
.dry .sec2_row_cont_box_right img{width:100%;height:100%;object-fit:contain;}
.dry .sec2_row_cont_box_right .def-ic{background:#fdecec;color:var(--red);}
.dry .section2_doct_row{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;margin:30px auto 0;width:100%;max-width:970px;}
.dry .sec2_doct_rowLeft{width:57%;text-align:left;padding-top:40px;}
.dry .sec2_doct_lefttop{width:100%;position:relative;padding-bottom:35px;border-bottom:1px solid #c9cfc9;}
.dry .sec2_doct_text{font-size:20px;line-height:28px;color:#000;font-weight:500;}
.dry .sec2_doct_text p+p{margin-top:30px;}
.dry .sec2_doct_text strong{color:var(--dk);font-weight:500;}
.dry .quote_icon{width:34px;height:34px;position:absolute;right:0;bottom:-17px;background:var(--gray);color:var(--sage);padding:2px;}
.dry .sec2_doct_leftbtm{width:100%;margin-top:30px;}
.dry .doct_sign{display:block;width:228px;}
.dry .doct_name_text{font-size:16px;line-height:22px;color:#000;margin-top:10px;}
.dry .doct_name_text .doctnme_green{font-size:20px;line-height:24px;color:var(--sage);font-weight:700;padding-right:10px;}
.dry .doct_name_text .sep{padding-right:10px;}
.dry .sec2_doct_imag_box{width:43%;}
.dry .sec2_doct_imag_box img{display:block;margin:0 auto -35px;width:460px;}

/* =========================================================
   5. LA SOLUCIÓN
   ========================================================= */
.dry .section_3{padding:65px 0 70px;background:var(--lt);}
.dry .section3_row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;margin:50px auto 10px;width:100%;max-width:950px;}
.dry .section3_left{width:45%;position:relative;padding-top:20px;}
.dry .section3_left .s3-bg{position:absolute;left:0;top:-80px;width:543px;max-width:none;pointer-events:none;}
.dry .section3_left_iner{display:flex;justify-content:flex-end;width:100%;align-items:center;position:relative;}
