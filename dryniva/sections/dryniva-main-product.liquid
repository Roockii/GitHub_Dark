.dry ul.sec4_protect_list,.dry ul.sec6_benefits_list{display:flex;flex-wrap:wrap;justify-content:center;width:100%;margin:35px auto 10px;}
.dry ul.sec4_protect_list li,.dry ul.sec6_benefits_list li{text-align:center;padding:0 40px;position:relative;}
.dry ul.sec4_protect_list li:after,.dry ul.sec6_benefits_list li:after{position:absolute;content:"";right:0;top:0;bottom:0;border-right:1px solid #d0ded2;}
.dry ul.sec4_protect_list li:first-child,.dry ul.sec6_benefits_list li:first-child{padding-left:0;}
.dry ul.sec4_protect_list li:last-child,.dry ul.sec6_benefits_list li:last-child{padding-right:0;}
.dry ul.sec4_protect_list li:last-child:after,.dry ul.sec6_benefits_list li:last-child:after{display:none;}
.dry ul.sec4_protect_list li .ic{width:35px;height:35px;margin:0 auto 5px;}
.dry ul.sec4_protect_list li p{font-size:16px;line-height:20px;color:#000;font-weight:500;}

/* =========================================================
   7. ZONAS DE APLICACIÓN
   ========================================================= */
.dry .section_5{padding:65px 0 70px;background:var(--lt);}
.dry .section5_row{display:flex;flex-wrap:wrap;justify-content:space-between;margin:30px auto 10px;width:100%;max-width:1050px;row-gap:15px;}
