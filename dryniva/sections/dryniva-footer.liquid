{%- comment -%}
  DRYNIVA — FOOTER (suscripción por email + logo + enlaces legales + copyright)
  Añádela en Personalizar → Pie de página (Footer) → Añadir sección → "Dryniva · Footer",
  y oculta el pie de página original del tema.
  Los emails se guardan en Clientes de Shopify con la etiqueta "newsletter".
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign terms_url = s.terms_link | default: shop.terms_of_service.url | default: '#'
  assign privacy_url = s.privacy_link | default: shop.privacy_policy.url | default: '#'
  assign contact_url = s.contact_link | default: '/pages/contact'
  assign logo_alt = s.logo.alt | default: shop.name
  assign form_id = 'dryft-form-' | append: section.id
-%}

<style>
#dry-ft-{{ section.id }}{
  --ft-dark:{{ s.c_dark }};--ft-sage:{{ s.c_sage }};--ft-nl-bg:{{ s.c_nl_bg }};--ft-bg:{{ s.c_bg }};
  --ft-btn1:{{ s.c_btn1 }};--ft-btn2:{{ s.c_btn2 }};--ft-sep:{{ s.c_sep }};
  --ft-logo-h:{{ s.logo_height }}px;--ft-zoom:{{ s.logo_zoom | divided_by: 100.0 }};
  font-family:'Inter',ui-sans-serif,system-ui,sans-serif;width:100%;text-align:center;color:#000;
}
#dry-ft-{{ section.id }} *,#dry-ft-{{ section.id }} *::before,#dry-ft-{{ section.id }} *::after{box-sizing:border-box;}
:where(#dry-ft-{{ section.id }}) :where(p,h2,form){margin:0;padding:0;}
#dry-ft-{{ section.id }} a{color:inherit;text-decoration:none;}
.dryft-container{width:1170px;max-width:100%;margin:0 auto;position:relative;}

/* ---------- suscripción ---------- */
.dryft-nl{width:100%;background:var(--ft-nl-bg);padding:50px 0;position:relative;overflow:hidden;}
.dryft-nl-box{max-width:760px;margin:0 auto;position:relative;z-index:1;}
.dryft-nl-pre{display:inline-block;font-size:14px;line-height:18px;font-weight:700;color:var(--ft-sage);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;}
.dryft-nl-title{font-size:34px;line-height:40px;font-weight:700;color:var(--ft-dark);letter-spacing:-.3px;}
.dryft-nl-text{font-size:17px;line-height:25px;color:#000;margin-top:12px;}
.dryft-nl-form{display:flex;align-items:center;max-width:560px;margin:25px auto 0;background:#fff;border:1px solid #d0ded2;border-radius:50px;padding:5px;box-shadow:0 6px 18px -10px rgba(19,73,75,.35);}
.dryft-nl-form input[type=email]{flex:1;min-width:0;border:0;outline:none;background:transparent;font:inherit;font-size:16px;color:#000;padding:0 20px;height:48px;}
.dryft-nl-form input[type=email]::placeholder{color:#8a948b;}
.dryft-nl-btn{flex-shrink:0;display:flex;align-items:center;gap:8px;height:48px;padding:0 26px;border:0;border-radius:50px;cursor:pointer;color:#fff;font:inherit;font-size:16px;font-weight:700;background:var(--ft-btn1);background:linear-gradient(90deg,var(--ft-btn1),var(--ft-btn2));box-shadow:0 4px 8px 1px color-mix(in srgb,var(--ft-btn1) 30%,transparent);transition:filter .2s;}
.dryft-nl-btn:hover{filter:brightness(1.06);}
.dryft-nl-btn svg{width:16px;height:16px;}
.dryft-nl-note{font-size:13px;line-height:18px;color:#4b5563;margin-top:12px;display:flex;align-items:center;justify-content:center;gap:6px;}
.dryft-nl-note svg{width:14px;height:14px;color:var(--ft-sage);flex-shrink:0;}
.dryft-nl-msg{max-width:560px;margin:20px auto 0;padding:12px 18px;border-radius:12px;font-size:15px;font-weight:600;}
.dryft-nl-msg.ok{background:#e3f6e7;color:#0f5f2a;}
.dryft-nl-msg.err{background:#fdecec;color:#a11313;}
.dryft-leaf{position:absolute;color:var(--ft-sage);opacity:.12;pointer-events:none;}
.dryft-leaf svg{width:100%;height:100%;display:block;}
.dryft-leaf.l1{left:-10px;bottom:-20px;width:150px;height:200px;transform:rotate(18deg);}
.dryft-leaf.l2{right:-10px;top:-30px;width:150px;height:200px;transform:rotate(200deg);}

/* ---------- pie ---------- */
.dryft-main{width:100%;background:var(--ft-bg);border-top:1px solid var(--ft-sep);padding:45px 15px;}
.dryft-logo{display:inline-flex;align-items:center;justify-content:center;margin:0 auto 30px;height:var(--ft-logo-h);}
.dryft-logo img{display:block;height:var(--ft-logo-h);width:auto;max-width:none;transform:scale(var(--ft-zoom));}
.dryft-logo-text{font-size:28px;line-height:1;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--ft-dark);}
.dryft-links{font-size:16px;line-height:20px;color:#000;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;}
.dryft-links a{padding:0 10px;transition:color .2s;}
.dryft-links a:hover{color:var(--ft-sage);text-decoration:underline;}
.dryft-links .sep{width:1px;height:18px;background:#e59021;display:inline-block;flex-shrink:0;}
.dryft-copy{font-size:16px;line-height:20px;color:#000;margin-top:12px;}
.dryft-pay{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:20px;}
.dryft-pay svg{width:38px;height:24px;}

@media only screen and (max-width:1200px){.dryft-container{width:1004px;}}
@media only screen and (max-width:1023px){.dryft-container{width:750px;}}
@media only screen and (max-width:767px){
  .dryft-container{width:100%;padding:0 15px;max-width:600px;}
  .dryft-nl{padding:35px 0;}
  .dryft-nl-pre{font-size:12px;}
  .dryft-nl-title{font-size:26px;line-height:32px;}
  .dryft-nl-text{font-size:15px;line-height:22px;}
  .dryft-nl-form{flex-direction:column;background:none;border:0;box-shadow:none;padding:0;gap:10px;}
  .dryft-nl-form input[type=email]{width:100%;flex:none;background:#fff;border:1px solid #d0ded2;border-radius:50px;height:52px;text-align:center;}
  .dryft-nl-btn{width:100%;justify-content:center;height:52px;font-size:17px;}
  .dryft-leaf{display:none;}
  .dryft-main{padding:25px 15px 90px;border:none;}
  .dryft-logo{margin:0 auto 25px;height:calc(var(--ft-logo-h) * .8);}
  .dryft-logo img{height:calc(var(--ft-logo-h) * .8);}
  .dryft-links{font-size:14px;line-height:20px;flex-wrap:nowrap;white-space:nowrap;}
  .dryft-copy{font-size:14px;line-height:20px;}
  .dryft-links a{padding:0 6px;}
}
</style>

{%- capture leaf_branch -%}
<svg viewBox="0 0 34 46" fill="currentColor" aria-hidden="true">
  <path d="M27 46 Q22 30 12 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  <path d="M24 36 C16 36 10 32 7 26 C14 26 21 30 24 36Z"/><path d="M24 34 C27 27 32 24 34 22 C33 29 29 33 24 34Z"/>
  <path d="M19 24 C12 23 8 18 6 13 C13 14 18 18 19 24Z"/><path d="M19 22 C21 16 26 13 29 11 C28 18 24 21 19 22Z"/>
  <path d="M14 12 C10 10 8 6 8 2 C12 4 14 8 14 12Z"/>
</svg>
{%- endcapture -%}

<footer id="dry-ft-{{ section.id }}" class="dryft">
  {%- if s.show_newsletter -%}
    <div class="dryft-nl" id="dryft-nl-{{ section.id }}">
      <span class="dryft-leaf l1" aria-hidden="true">{{ leaf_branch }}</span>
      <span class="dryft-leaf l2" aria-hidden="true">{{ leaf_branch }}</span>
      <div class="dryft-container">
        <div class="dryft-nl-box">
          {%- if s.nl_pre != blank -%}<p class="dryft-nl-pre">{{ s.nl_pre }}</p>{%- endif -%}
          <h2 class="dryft-nl-title">{{ s.nl_title }}</h2>
          {%- if s.nl_text != blank -%}<p class="dryft-nl-text">{{ s.nl_text }}</p>{%- endif -%}
          {%- form 'customer', id: form_id -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="dryft-nl-msg ok" role="status">{{ s.nl_success }}</p>
            {%- else -%}
              <div class="dryft-nl-form">
                <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.nl_placeholder | escape }}" aria-label="{{ s.nl_placeholder | escape }}" value="{{ form.email }}">
                <button type="submit" class="dryft-nl-btn">{{ s.nl_button }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></button>
              </div>
              {%- if form.errors -%}
                <p class="dryft-nl-msg err" role="alert">{{ s.nl_error }}</p>
              {%- endif -%}
              {%- if s.nl_note != blank -%}
                <p class="dryft-nl-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>{{ s.nl_note }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="dryft-main">
    <div class="dryft-container">
      <a href="{{ routes.root_url }}" class="dryft-logo" aria-label="{{ shop.name | escape }}">
        {%- if s.logo != blank -%}
          {{ s.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: logo_alt, widths: '200, 400, 600', sizes: '200px' }}
        {%- else -%}
          <span class="dryft-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <p class="dryft-links">
        {%- if s.terms_text != blank -%}<a href="{{ terms_url }}">{{ s.terms_text }}</a>{%- endif -%}
        {%- if s.terms_text != blank and s.privacy_text != blank -%}<span class="sep" aria-hidden="true"></span>{%- endif -%}
        {%- if s.privacy_text != blank -%}<a href="{{ privacy_url }}">{{ s.privacy_text }}</a>{%- endif -%}
        {%- if s.contact_text != blank -%}<span class="sep" aria-hidden="true"></span><a href="{{ contact_url }}">{{ s.contact_text }}</a>{%- endif -%}
      </p>
      <p class="dryft-copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ s.copyright }}</p>
      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <div class="dryft-pay">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- if s.show_newsletter -%}
<script>
(function () {
  // Tras enviar el formulario la página se recarga: baja hasta el mensaje en vez de quedarse arriba
  var box = document.getElementById('dryft-nl-{{ section.id }}');
  if (box && (location.search.indexOf('customer_posted=true') > -1 || box.querySelector('.dryft-nl-msg'))) {
    window.addEventListener('load', function () { box.scrollIntoView({ block: 'center' }); });
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Dryniva · Footer",
  "tag": "div",
  "class": "dryniva-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Suscripción por email" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar suscripción", "default": true },
    { "type": "text", "id": "nl_pre", "label": "Antetítulo", "default": "Únete a la comunidad Dryniva" },
    { "type": "text", "id": "nl_title", "label": "Título", "default": "Recibe un 10% de descuento en tu primer pedido" },
    { "type": "textarea", "id": "nl_text", "label": "Texto", "default": "Suscríbete y recibe ofertas exclusivas, consejos para cuidar tu piel y acceso anticipado a nuevos productos." },
    { "type": "text", "id": "nl_placeholder", "label": "Texto dentro de la casilla", "default": "Tu correo electrónico" },
    { "type": "text", "id": "nl_button", "label": "Texto del botón", "default": "Unirme" },
    { "type": "text", "id": "nl_note", "label": "Nota debajo", "default": "Sin spam. Puedes darte de baja cuando quieras." },
    { "type": "text", "id": "nl_success", "label": "Mensaje al suscribirse", "default": "¡Gracias por unirte! Revisa tu correo." },
    { "type": "text", "id": "nl_error", "label": "Mensaje de error", "default": "Revisa tu correo electrónico o puede que ya estés suscrita." },
    { "type": "paragraph", "content": "Los emails se guardan en Clientes con la etiqueta 'newsletter'. Si prometes un descuento, crea el código en Descuentos y mándalo con Shopify Email o una automatización de bienvenida." },
    { "type": "color", "id": "c_nl_bg", "label": "Fondo de la suscripción", "default": "#F1F7F2" },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Vacío = nombre de la tienda en texto." },
    { "type": "range", "id": "logo_height", "label": "Alto del logo", "min": 24, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "logo_zoom", "label": "Zoom del logo", "min": 100, "max": 300, "step": 10, "unit": "%", "default": 100, "info": "Súbelo si tu PNG tiene mucho espacio transparente alrededor." },

    { "type": "header", "content": "Enlaces" },
    { "type": "text", "id": "terms_text", "label": "Texto términos", "default": "Términos de uso" },
    { "type": "url", "id": "terms_link", "label": "Enlace términos", "info": "Vacío = tu política de Términos del servicio (Configuración → Políticas)." },
    { "type": "text", "id": "privacy_text", "label": "Texto privacidad", "default": "Política de privacidad" },
    { "type": "url", "id": "privacy_link", "label": "Enlace privacidad", "info": "Vacío = tu Política de privacidad." },
    { "type": "text", "id": "contact_text", "label": "Texto contacto", "default": "Contacto" },
    { "type": "url", "id": "contact_link", "label": "Enlace contacto", "info": "Vacío = /pages/contact" },
    { "type": "text", "id": "copyright", "label": "Texto del copyright", "default": "Todos los derechos reservados." },
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar iconos de pago", "default": false },

    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "c_dark", "label": "Verde oscuro (títulos)", "default": "#13494B" },
    { "type": "color", "id": "c_sage", "label": "Verde salvia", "default": "#5C735E" },
    { "type": "color", "id": "c_btn1", "label": "Botón: degradado 1", "default": "#02B432" },
    { "type": "color", "id": "c_btn2", "label": "Botón: degradado 2", "default": "#13DB3F" },
    { "type": "color", "id": "c_bg", "label": "Fondo del pie", "default": "#FFFFFF" },
    { "type": "color", "id": "c_sep", "label": "Línea de arriba", "default": "#C5D7C7" }
  ],
  "presets": [{ "name": "Dryniva · Footer" }]
}
{% endschema %}
