{%- assign accent = '#13494B' -%}
{%- assign btn = '#02B432' -%}
{%- assign lt = '#F1F7F2' -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ email_title }}</title>
  <style>
    body{margin:0;padding:0;background:#F1F7F2;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2a24;}
    a{color:#13494B;}
    @media (max-width:600px){ .card{padding:24px 18px !important;} .h1{font-size:24px !important;line-height:30px !important;} .btn a{display:block !important;} }
  </style>
</head>
<body>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F1F7F2;padding:30px 12px;">
<tr><td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
  <tr><td align="center" style="padding:6px 0 22px;">
    <a href="{{ shop.url }}" style="text-decoration:none;">
      {%- if shop.email_logo_url -%}
        <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 160 }}" style="max-width:220px;height:auto;border:0;">
      {%- else -%}
        <span style="font-size:28px;font-weight:700;letter-spacing:3px;color:#13494B;">{{ shop.name | upcase }}</span>
      {%- endif -%}
    </a>
  </td></tr>
  <tr><td class="card" style="background:#ffffff;border:1px solid #DEE4D4;border-radius:18px;padding:36px 34px;">
    <p style="margin:0;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#5C735E;">Order {{ order_name }}</p>
    <h1 class="h1" style="margin:8px 0 0;font-size:28px;line-height:34px;font-weight:700;color:#13494B;">Thank you{% if customer.first_name %}, {{ customer.first_name }}{% endif %}! &#127807;</h1>
    <p style="margin:12px 0 0;font-size:16px;line-height:24px;">Your order is confirmed and we're getting it ready. We'll send you another email with your tracking link as soon as it ships.</p>
    <table role="presentation" cellpadding="0" cellspacing="0" class="btn" style="margin:24px 0 6px;"><tr><td>
      <a href="{{ order_status_url }}" style="display:inline-block;background:#02B432;color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;padding:15px 34px;border-radius:50px;">View Your Order &rarr;</a>
    </td></tr></table>

    <h2 style="margin:30px 0 12px;font-size:18px;line-height:24px;font-weight:700;color:#13494B;">Order summary</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      {%- for line in subtotal_line_items -%}
      <tr>
        <td width="72" style="padding:12px 0;border-top:1px solid #E6EDE7;">
          {%- if line.image -%}<img src="{{ line | img_url: 'compact_cropped' }}" width="60" height="60" alt="" style="display:block;border-radius:10px;background:#F1F7F2;">{%- endif -%}
        </td>
        <td style="padding:12px 10px;border-top:1px solid #E6EDE7;font-size:15px;line-height:20px;">
          <strong style="color:#13494B;">{{ line.product.title | default: line.title }}</strong>
          {%- if line.variant.title != 'Default Title' and line.variant.title != blank -%}<br><span style="display:inline-block;margin-top:4px;font-size:12px;font-weight:600;color:#5C735E;background:#F1F7F2;border-radius:50px;padding:3px 9px;">{{ line.variant.title }}</span>{%- endif -%}
          <br><span style="font-size:13px;color:#5b665e;">Qty: {{ line.quantity }}</span>
        </td>
        <td align="right" style="padding:12px 0;border-top:1px solid #E6EDE7;font-size:15px;font-weight:700;white-space:nowrap;">{{ line.final_line_price | money }}</td>
      </tr>
      {%- endfor -%}
    </table>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px;border-top:1px solid #E6EDE7;">
      <tr><td style="padding:10px 0 4px;font-size:15px;">Subtotal</td><td align="right" style="padding:10px 0 4px;font-size:15px;">{{ subtotal_price | money }}</td></tr>
      {%- if total_discounts > 0 -%}<tr><td style="padding:4px 0;font-size:15px;color:#0d7a2d;">Discount</td><td align="right" style="padding:4px 0;font-size:15px;color:#0d7a2d;">-{{ total_discounts | money }}</td></tr>{%- endif -%}
      <tr><td style="padding:4px 0;font-size:15px;">Shipping</td><td align="right" style="padding:4px 0;font-size:15px;">{% if shipping_price == 0 %}FREE{% else %}{{ shipping_price | money }}{% endif %}</td></tr>
      {%- if tax_price > 0 -%}<tr><td style="padding:4px 0;font-size:15px;">Taxes</td><td align="right" style="padding:4px 0;font-size:15px;">{{ tax_price | money }}</td></tr>{%- endif -%}
      <tr><td style="padding:12px 0 0;font-size:19px;font-weight:700;border-top:1px solid #E6EDE7;">Total</td><td align="right" style="padding:12px 0 0;font-size:19px;font-weight:700;border-top:1px solid #E6EDE7;">{{ total_price | money_with_currency }}</td></tr>
    </table>

    {%- if shipping_address -%}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:26px;background:#F1F7F2;border-radius:12px;">
      <tr><td style="padding:16px 18px;font-size:14px;line-height:21px;">
        <strong style="color:#13494B;">Shipping to</strong><br>
        {{ shipping_address.name }}<br>
        {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}<br>
        {{ shipping_address.city }}{% if shipping_address.province_code %}, {{ shipping_address.province_code }}{% endif %} {{ shipping_address.zip }}<br>
        {{ shipping_address.country }}
      </td></tr>
    </table>
    {%- endif -%}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:22px;border:1px solid #DEE4D4;border-radius:12px;">
      <tr><td style="padding:16px 18px;font-size:14px;line-height:21px;">
        <strong style="color:#13494B;">&#128161; Tip for best results</strong><br>
        Apply a thin layer to clean, dry skin twice a day and let it set into a powder-soft finish before getting dressed.
      </td></tr>
    </table>
  </td></tr>
  <tr><td style="padding:22px 10px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #DEE4D4;border-radius:14px;">
      <tr>
        <td align="center" style="padding:16px 8px;font-size:13px;line-height:18px;color:#13494B;font-weight:600;" width="33%">&#128737;&#65039;<br>30-Day Money-Back<br>Guarantee</td>
        <td align="center" style="padding:16px 8px;font-size:13px;line-height:18px;color:#13494B;font-weight:600;border-left:1px solid #E6EDE7;border-right:1px solid #E6EDE7;" width="34%">&#128666;<br>Free Shipping<br>on 2+ Tubes</td>
        <td align="center" style="padding:16px 8px;font-size:13px;line-height:18px;color:#13494B;font-weight:600;" width="33%">&#128172;<br>Real People,<br>Fast Replies</td>
      </tr>
    </table>
  </td></tr>
  <tr><td align="center" style="padding:24px 10px 10px;font-size:13px;line-height:20px;color:#5b665e;">
    Questions? Just reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#13494B;">{{ shop.email }}</a><br>
    <a href="{{ shop.url }}/apps/track123" style="color:#13494B;">Track your order</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/pages/refund-policy" style="color:#13494B;">Refund Policy</a> &nbsp;·&nbsp; <a href="{{ shop.url }}" style="color:#13494B;">{{ shop.name }}</a><br>
    <span style="color:#8a948b;">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
