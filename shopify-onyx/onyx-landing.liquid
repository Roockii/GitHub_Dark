{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
  if p != blank
    assign current_variant = p.selected_or_first_available_variant
  endif

  assign quantity_blocks = section.blocks | where: 'type', 'quantity'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign compare_blocks = section.blocks | where: 'type', 'compare_row'
  assign expert_blocks = section.blocks | where: 'type', 'expert'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign link_blocks = section.blocks | where: 'type', 'footer_link'
  assign social_blocks = section.blocks | where: 'type', 'social'

  assign first_qty_block = quantity_blocks | first
  assign start_qty = 1
  assign start_discount = 0
  if first_qty_block
    assign start_qty = first_qty_block.settings.qty
    assign start_discount = first_qty_block.settings.discount
  endif

  assign can_buy = false
  if current_variant.available or section.settings.ignore_stock
    assign can_buy = true
  endif

  assign display_title = section.settings.title_override
  if display_title == blank and p != blank
    assign display_title = p.title
  endif
  assign offer_title = section.settings.offer_title | default: display_title

  if current_variant
    assign pct_left = 100 | minus: start_discount
    assign unit_price = current_variant.price | times: pct_left | divided_by: 100.0 | round
    # Precio de comparación: el de los ajustes de la sección si está relleno;
    # si no, el "Precio de comparación" de la variante; si no, el precio normal
    # (así en las opciones de 2 y 3 unidades se ve el precio sin descuento tachado).
    assign compare_override = 0
    if section.settings.compare_price_manual != blank
      assign compare_override = section.settings.compare_price_manual | remove: '€' | remove: '$' | strip | replace: ',', '.' | times: 100 | round
    endif
    assign base_compare = current_variant.price
    if compare_override > 0
      assign base_compare = compare_override
    elsif current_variant.compare_at_price > current_variant.price
      assign base_compare = current_variant.compare_at_price
    endif

    # Si la primera opción de cantidad tiene su propio "Precio tachado", manda ese.
    assign first_block_compare = 0
    if first_qty_block and first_qty_block.settings.compare_price != blank
      assign first_block_compare = first_qty_block.settings.compare_price | remove: '€' | remove: '$' | strip | replace: ',', '.' | times: 100 | round
    endif

    assign current_compare = base_compare
    if first_block_compare > 0
      assign current_compare = first_block_compare
    endif
    assign compare_price = nil
    if current_compare > unit_price
      assign compare_price = current_compare
    endif

    assign offer_base = base_compare
    if first_block_compare > 0
      assign offer_base = first_block_compare
    endif
    assign offer_compare = nil
    if offer_base > current_variant.price
      assign offer_compare = offer_base
    endif
  endif
-%}

<div
  id="onyx-{{ section.id }}"
  class="onyx"
  data-onyx-product
  data-after-add="{{ section.settings.after_add }}"
  data-added-msg="{{ section.settings.added_message | escape }}"
  data-error-msg="{{ section.settings.error_message | escape }}"
  data-sold-out="{{ section.settings.sold_out_text | escape }}"
  data-compare-override="{{ compare_override | default: 0 }}"
  data-variant-price="{{ current_variant.price }}"
  data-variant-compare="{{ current_variant.compare_at_price }}"
  data-variant-available="{{ current_variant.available }}"
  data-ignore-stock="{{ section.settings.ignore_stock }}"
  data-each-always="{{ section.settings.each_always }}"
  data-pct-suffix="{{ section.settings.pct_suffix | escape }}"
  data-sticky-offset="{{ section.settings.sticky_offset }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  style="--wiggle-every:{{ section.settings.wiggle_every }}s;--sunrise-1:{{ section.settings.color_1 }};--sunrise-2:{{ section.settings.color_2 }};--sunrise-3:{{ section.settings.color_3 }};--ink:{{ section.settings.color_ink }};--secondary:{{ section.settings.color_secondary }};--tick-color:{{ section.settings.tick_color }};"
>
  {%- if section.settings.title_custom_font -%}
    <style>{{ section.settings.title_font | font_face: font_display: 'swap' }}</style>
  {%- endif -%}
  {%- comment -%} Tipografía de los títulos de Preguntas, Ondas y Características.
    Si se deja Helvetica (el valor por defecto) se mantiene la fuente original del diseño. {%- endcomment -%}
  {%- assign sid = '#onyx-' | append: section.id -%}
  <style>
    {%- assign pf = section.settings.faq_font -%}
    {%- unless pf.family == 'Helvetica' and pf.weight == 700 and pf.style == 'normal' -%}
      {{ pf | font_face: font_display: 'swap' }}
      {{ sid }} #faq h2{font-family:{{ pf.family }},{{ pf.fallback_families }};font-weight:{{ pf.weight }};font-style:{{ pf.style }};}
    {%- endunless -%}
    {%- assign pf = section.settings.ripple_font -%}
    {%- unless pf.family == 'Helvetica' and pf.weight == 700 and pf.style == 'normal' -%}
      {{ pf | font_face: font_display: 'swap' }}
      {{ sid }} .ripple-section h2{font-family:{{ pf.family }},{{ pf.fallback_families }};font-weight:{{ pf.weight }};font-style:{{ pf.style }};}
    {%- endunless -%}
    {%- assign pf = section.settings.compare_font -%}
    {%- unless pf.family == 'Helvetica' and pf.weight == 700 and pf.style == 'normal' -%}
      {{ pf | font_face: font_display: 'swap' }}
      {{ sid }} .cmp-section .cmp-head h2{font-family:{{ pf.family }},{{ pf.fallback_families }};font-weight:{{ pf.weight }};font-style:{{ pf.style }};}
    {%- endunless -%}
    {%- assign pf = section.settings.features_font -%}
    {%- unless pf.family == 'Helvetica' and pf.weight == 700 and pf.style == 'normal' -%}
      {{ pf | font_face: font_display: 'swap' }}
      {{ sid }} .features-section .feat-head h2{font-family:{{ pf.family }},{{ pf.fallback_families }};font-weight:{{ pf.weight }};font-style:{{ pf.style }};}
    {%- endunless -%}
  </style>
  <style>#onyx-{{ section.id }} .p-title{font-size:{{ section.settings.title_size_mobile }}px;}@media(min-width:768px){#onyx-{{ section.id }} .p-title{font-size:{{ section.settings.title_size }}px;}}</style>
  {%- if section.settings.show_progress -%}
    <div class="onyx-progress" aria-hidden="true"></div>
  {%- endif -%}

  {%- comment -%} ================= 1. PRODUCTO ================= {%- endcomment -%}
  <section id="top" class="hero onyx-wrap">
    <div class="hero-gallery">
      <div class="main-media placeholder-img" data-main-media>
        {%- if p != blank and p.media.size > 0 -%}
          {%- for media in p.media -%}
            {%- if media.preview_image -%}
              {%- assign media_alt = media.alt | default: p.title | escape -%}
              {{
                media.preview_image
                | image_url: width: 1400
                | image_tag:
                  class: 'media-cover',
                  loading: 'eager',
                  sizes: '(min-width: 1024px) 45vw, 100vw',
                  widths: '400, 700, 1000, 1400',
                  alt: media_alt,
                  data-media-index: forloop.index0,
                  data-media-id: media.id
              }}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <svg width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--sunrise-2)" stroke-width="1.2" aria-hidden="true"><circle cx="12" cy="12" r="7"/><path d="M12 9v3l2 1"/><path d="M5 3l2 2M19 3l-2 2"/></svg>
        {%- endif -%}
      </div>

      {%- if p != blank and p.media.size > 1 -%}
        <div class="thumbs no-scrollbar">
          {%- for media in p.media -%}
            {%- if media.preview_image -%}
              <button type="button" class="thumb placeholder-img{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Imagen {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 200 | image_tag: class: 'media-cover', loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="info">
      {%- if section.settings.rating_text != blank -%}
        <a href="#reviews" class="rating-link">
          <span class="star-boxes" aria-hidden="true">
            {%- for i in (1..5) -%}
              <span class="star-box"><svg viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1z"/></svg></span>
            {%- endfor -%}
          </span>
          {{ section.settings.rating_text }}
        </a>
      {%- endif -%}

      <h1 class="p-title"{% if section.settings.title_custom_font %} style="font-family:{{ section.settings.title_font.family }},{{ section.settings.title_font.fallback_families }};font-weight:{{ section.settings.title_font.weight }};font-style:{{ section.settings.title_font.style }};"{% endif %}>{{ display_title }}</h1>

      {%- if current_variant -%}
        <div class="price-row">
          <span class="price-now" data-price-now>{{ unit_price | money }}</span>
          {%- if section.settings.each_text != blank -%}
            <span class="price-each" data-price-each{% unless section.settings.each_always or start_qty > 1 %} hidden{% endunless %}>{{ section.settings.each_text }}</span>
          {%- endif -%}
          <span class="price-compare" data-price-compare{% if compare_price == nil %} hidden{% endif %}>{% if compare_price %}{{ compare_price | money }}{% endif %}</span>
          {%- if section.settings.show_pct_badge -%}
            {%- liquid
              assign pct_off = ''
              if compare_price
                assign pct_off = unit_price | times: 100.0 | divided_by: compare_price | round
                assign pct_off = 100 | minus: pct_off
              endif
            -%}
            <span class="pct-badge bg-sunrise" data-pct-off{% if pct_off == '' %} hidden{% endif %}>{{ pct_off }}{{ section.settings.pct_suffix }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if p != blank -%}
        {%- form 'product', p, data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="{{ start_qty }}" data-qty-input>

          {%- liquid
            assign show_colors = false
            if section.settings.show_variant_picker and p.has_only_default_variant == false
              assign show_colors = true
            endif
          -%}
          {%- if quantity_blocks.size > 0 -%}
            <div style="margin-bottom:calc(1.5*var(--r,16px))">
              {%- if section.settings.qty_heading != blank -%}
                <p class="label-sm">{{ section.settings.qty_heading }}</p>
              {%- endif -%}
              <div class="qty-list bg-secondary" role="radiogroup" aria-label="{{ section.settings.qty_heading | escape }}">
                {%- for block in quantity_blocks -%}
                  {%- liquid
                    assign block_compare = 0
                    if block.settings.compare_price != blank
                      assign block_compare = block.settings.compare_price | remove: '€' | remove: '$' | strip | replace: ',', '.' | times: 100 | round
                    endif
                    assign opt_left = 100 | minus: block.settings.discount
                    assign opt_unit = current_variant.price | times: opt_left | divided_by: 100.0 | round
                    assign opt_compare = base_compare
                    if block_compare > 0
                      assign opt_compare = block_compare
                    endif
                  -%}
                  <div class="qty-opt qty-card{% if forloop.first %} is-selected{% endif %}" data-qty="{{ block.settings.qty }}" data-discount="{{ block.settings.discount }}" data-compare="{{ block_compare }}" {{ block.shopify_attributes }}>
                    <div class="qty-head" role="radio" tabindex="0" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}">
                      <span class="qty-radio"></span>
                      {%- if block.settings.image != blank -%}
                        <span class="qty-img">{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.label }}</span>
                      {%- endif -%}
                      <span class="qty-info">
                        <span class="qty-label">{{ block.settings.label }}</span>
                        {%- if block.settings.badge != blank -%}<span class="qty-save">{{ block.settings.badge }}</span>{%- endif -%}
                        {%- if block.settings.subtitle != blank -%}<span class="qty-sub">{{ block.settings.subtitle }}</span>{%- endif -%}
                      </span>
                      <span class="qty-prices">
                        <span class="qp-now" data-opt-price>{{ opt_unit | money }}</span>
                        <span class="qp-old" data-opt-compare{% unless opt_compare > opt_unit %} hidden{% endunless %}>{{ opt_compare | money }}</span>
                      </span>
                    </div>
                    {%- if show_colors -%}
                      <div class="qty-colors">
                        {%- for n in (1..block.settings.qty) -%}
                          <div class="color-row" data-color-row>
                            <span class="cr-label">{{ section.settings.variant_label }} {{ n }}</span>
                            <div class="swatches">
                              {%- for v in p.variants -%}
                                <button type="button" class="swatch{% if v.id == current_variant.id %} is-active{% endif %}" data-variant="{{ v.id }}" title="{{ v.title | escape }}" aria-label="{{ v.title | escape }}"{% unless v.available or section.settings.ignore_stock %} disabled{% endunless %}>
                                  {%- if v.featured_image -%}
                                    {{ v.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: v.title }}
                                  {%- else -%}
                                    <span class="sw-txt">{{ v.title | truncate: 12 }}</span>
                                  {%- endif -%}
                                </button>
                              {%- endfor -%}
                            </div>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <button type="submit" name="add" class="btn-main atc{% if section.settings.wiggle %} wiggle{% endif %}" data-atc{% unless can_buy %} disabled{% endunless %}>
            <span class="btn-bg"></span>
            <span class="btn-label" data-atc-label>{% if can_buy %}{{ section.settings.atc_text }}{% else %}{{ section.settings.sold_out_text }}{% endif %}</span>
          </button>
          <p class="atc-error" data-atc-error hidden></p>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_offer_box and current_variant -%}
        <div class="offer-box bg-secondary">
          <div class="offer-inner">
            {%- if section.settings.offer_badge != blank -%}<span class="pill bg-sunrise">{{ section.settings.offer_badge }}</span>{%- endif -%}
            <div class="offer-head">
              <h3>{{ offer_title }}</h3>
              <div class="r">
                <p class="n"><span data-offer-price>{{ unit_price | money }}</span>{% if section.settings.each_text != blank %}<span class="price-each" data-price-each{% unless section.settings.each_always or start_qty > 1 %} hidden{% endunless %}>{{ section.settings.each_text }}</span>{% endif %}</p>
                <p class="o" data-offer-compare{% if compare_price == nil %} hidden{% endif %}>{% if compare_price %}{{ compare_price | money }}{% endif %}</p>
              </div>
            </div>
            {%- assign offer_lines = section.settings.offer_bullets | newline_to_br | split: '<br />' -%}
            <ul class="checks">
              {%- for line in offer_lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}<li><span class="ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>{{ line }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      {%- assign trust_lines = section.settings.trust_lines | newline_to_br | split: '<br />' -%}
      <div class="trust">
        {%- for line in trust_lines -%}
          {%- assign line = line | strip -%}
          {%- if line != blank -%}<span>{{ line }}</span>{%- endif -%}
        {%- endfor -%}
      </div>

      {%- if accordion_blocks.size > 0 -%}
        <div class="accordion bg-secondary" data-accordion>
          {%- for block in accordion_blocks -%}
            <div class="acc-item{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="acc-btn" aria-expanded="{{ block.settings.open }}" aria-controls="acc-{{ block.id }}">
                {{ block.settings.title }}<span class="acc-arrow" aria-hidden="true">⌄</span>
              </button>
              <div class="acc-body" id="acc-{{ block.id }}"{% if block.settings.open %} style="max-height:none"{% endif %}>
                <div class="acc-content">{{ block.settings.content }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ================= 2. PREGUNTAS RÁPIDAS ================= {%- endcomment -%}
  {%- if section.settings.show_faq and faq_blocks.size > 0 -%}
    <section id="faq" class="onyx-wrap py-lg" style="scroll-margin-top:calc(2*var(--r,16px))">
      {%- if section.settings.faq_heading != blank -%}
        <h2 class="fade-in h2-lg" style="margin-bottom:calc(2.5*var(--r,16px))">{{ section.settings.faq_heading }}</h2>
      {%- endif -%}
      <div class="faq-grid">
        {%- for block in faq_blocks -%}
          <div class="fade-in faq-card bg-secondary" {{ block.shopify_attributes }}>
            <p class="q">{{ block.settings.question }}</p>
            <div class="a">{{ block.settings.answer }}</div>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 3. ONDAS ================= {%- endcomment -%}
  {%- if section.settings.show_ripple -%}
    {%- assign left_lines = section.settings.ripple_left | newline_to_br | split: '<br />' -%}
    {%- assign right_lines = section.settings.ripple_right | newline_to_br | split: '<br />' -%}
    <section class="ripple-section" style="background:{{ section.settings.ripple_bg }};color:{{ section.settings.ripple_text }};">
      <div class="fade-in ripple-head">
        <h2>
          {{ section.settings.ripple_heading }}
          {%- if section.settings.ripple_highlight != blank %} <em class="onyx-serif text-sunrise">{{ section.settings.ripple_highlight }}</em>{%- endif -%}
        </h2>
      </div>
      <div class="ripple-grid">
        <div class="ripple-col">
          {%- for line in left_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              <div class="ripple-item left"><span>{{ line }}</span><span class="ripple-diamond"></span><span class="ripple-line"></span><span class="dot"></span></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ripple-center">
          <div class="ripple-rings" aria-hidden="true">
            <span class="ripple-glow"></span>
            <span class="ring-static r-outer"></span>
            <span class="ring-static r-mid"></span>
            <span class="ring-static r-inner"></span>
            <span class="ripple-ring" style="animation-delay:0s"></span>
            <span class="ripple-ring" style="animation-delay:-1.5s"></span>
            <span class="ripple-ring" style="animation-delay:-3s"></span>
          </div>
          <div class="ripple-product vibrate">
            {%- if section.settings.ripple_image != blank -%}
              {{ section.settings.ripple_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.ripple_image.alt, widths: '350, 500, 700' }}
            {%- else -%}
              <svg width="130" height="130" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--sunrise-2)" stroke-width="1" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
            {%- endif -%}
          </div>
        </div>
        <div class="ripple-col">
          {%- for line in right_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              <div class="ripple-item right"><span class="dot"></span><span class="ripple-line"></span><span class="ripple-diamond"></span><span>{{ line }}</span></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ripple-mobile">
          {%- assign all_lines = left_lines | concat: right_lines -%}
          {%- for line in all_lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}<div class="ripple-item"><span class="dot"></span> {{ line }}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 4. CARACTERÍSTICAS ================= {%- endcomment -%}
  {%- if section.settings.show_features and feature_blocks.size > 0 -%}
    <section class="features-section onyx-wrap py-xl" style="background:{{ section.settings.features_bg }};color:{{ section.settings.features_text }};">
      <div class="fade-in feat-head">
        <h2>{{ section.settings.features_heading }} {% if section.settings.features_highlight != blank %}<span class="text-sunrise">{{ section.settings.features_highlight }}</span>{% endif %}</h2>
        {%- if section.settings.features_sub != blank -%}<p>{{ section.settings.features_sub }}</p>{%- endif -%}
      </div>
      <div class="feat-list">
        {%- for block in feature_blocks -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          <div class="feat{% if mod == 1 %} reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="fade-in feat-media">
              <div class="feat-img placeholder-img">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'media-cover' }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'media-cover', loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 768px) 40vw, 100vw', alt: block.settings.image.alt }}
                {%- else -%}
                  <svg width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--sunrise-2)" stroke-width="1" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
                {%- endif -%}
              </div>
            </div>
            <div class="fade-in">
              {%- assign bf = block.settings.title_font -%}
              {%- if bf and bf.family != 'Helvetica' or bf.weight != 700 or bf.style != 'normal' -%}
                <style>{{ bf | font_face: font_display: 'swap' }}</style>
                <h3 style="font-family:{{ bf.family }},{{ bf.fallback_families }};font-weight:{{ bf.weight }};font-style:{{ bf.style }};">{{ block.settings.title }}</h3>
              {%- else -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}<div class="txt">{{ block.settings.text }}</div>{%- endif -%}
              <div class="stats">
                {%- if block.settings.stat1_value != blank -%}
                  <div class="stat"><p class="n text-sunrise">{{ block.settings.stat1_value }}</p><p class="l">{{ block.settings.stat1_label }}</p></div>
                {%- endif -%}
                {%- if block.settings.stat2_value != blank -%}
                  <div class="stat"><p class="n text-sunrise">{{ block.settings.stat2_value }}</p><p class="l">{{ block.settings.stat2_label }}</p></div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 5. COMPARATIVA ================= {%- endcomment -%}
  {%- if section.settings.show_compare and compare_blocks.size > 0 -%}
    {%- assign cmp_rows = compare_blocks.size | plus: 1 -%}
    <section class="cmp-section onyx-wrap py-xl">
      <div class="fade-in cmp-head">
        {%- if section.settings.compare_eyebrow != blank -%}<p class="eyebrow text-sunrise">{{ section.settings.compare_eyebrow }}</p>{%- endif -%}
        <h2 class="h2-xl">{{ section.settings.compare_heading }}</h2>
        {%- if section.settings.compare_sub != blank -%}<p class="sub">{{ section.settings.compare_sub }}</p>{%- endif -%}
      </div>

      <div
        class="fade-in cmp2"
        role="table"
        aria-label="{{ section.settings.compare_heading | escape }}"
        style="--cmp-bg:{{ section.settings.compare_bg }};--cmp-col-bg:{{ section.settings.compare_col_bg }};--cmp-text:{{ section.settings.compare_text }};--cmp-yes:{{ section.settings.compare_yes }};--cmp-no:{{ section.settings.compare_no }};--cmp-best-icon:{{ section.settings.compare_best_icon }};"
      >
        <div class="cmp2-grid" style="--rows:{{ cmp_rows }}">
          {%- for c in (1..3) -%}
            <div class="cmp2-colbg cmp2-c{{ c }}{% if c == 1 %} best{% endif %}" aria-hidden="true"></div>
          {%- endfor -%}

          {%- for c in (1..3) -%}
            {%- assign name_key = 'compare_col_' | append: c -%}
            {%- assign img_key = 'compare_img_' | append: c -%}
            {%- assign col_img = section.settings[img_key] -%}
            <div class="cmp2-head cmp2-c{{ c }}{% if c == 1 %} best{% endif %}" style="grid-row:1" role="columnheader">
              <div class="cmp2-img">
                {%- if col_img != blank -%}
                  {{ col_img | image_url: width: 300 | image_tag: loading: 'lazy', alt: section.settings[name_key] }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 9"/></svg>
                {%- endif -%}
              </div>
              <p class="cmp2-name">{{ section.settings[name_key] }}</p>
            </div>
          {%- endfor -%}

          {%- for block in compare_blocks -%}
            {%- assign last_row = forloop.last -%}
            {%- assign grid_row = forloop.index | plus: 1 -%}
            {%- for c in (1..3) -%}
              {%- assign has_key = 'col_' | append: c -%}
              {%- assign has = block.settings[has_key] -%}
              <div class="cmp2-cell cmp2-c{{ c }}{% if c == 1 %} best{% endif %}{% if last_row %} last{% endif %}" style="grid-row:{{ grid_row }}" role="cell" {% if c == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <span class="cmp2-ic{% if has %} yes{% else %} no{% endif %}" aria-label="{% if has %}Sí{% else %}No{% endif %}">
                  {%- if has -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 12.5l3.5 3.5 7.5-8"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M8 8l8 8M16 8l-8 8"/></svg>
                  {%- endif -%}
                </span>
                <span class="cmp2-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 6. EXPERTOS ================= {%- endcomment -%}
  {%- if section.settings.show_experts and expert_blocks.size > 0 -%}
    <section class="exp-section onyx-wrap py-xl bg-secondary">
      <div class="fade-in exp-head">
        <h2 class="h2-xl">{{ section.settings.experts_heading }}</h2>
        {%- if section.settings.experts_text != blank -%}<div>{{ section.settings.experts_text }}</div>{%- endif -%}
      </div>
      <div class="exp-grid">
        {%- for block in expert_blocks -%}
          <div class="fade-in exp-card hover-glow" {{ block.shopify_attributes }}>
            <span class="stars" aria-label="{{ block.settings.stars }} de 5">{%- for i in (1..block.settings.stars) -%}★{%- endfor -%}</span>
            <p class="t">{{ block.settings.title }}</p>
            <div class="x">{{ block.settings.text }}</div>
            <div class="who">
              {%- if block.settings.photo != blank -%}
                {{ block.settings.photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- endif -%}
              <div><p class="n">{{ block.settings.name }}</p><p class="r">{{ block.settings.role }}</p></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 7. RESEÑAS ================= {%- endcomment -%}
  {%- if section.settings.show_reviews -%}
    {%- liquid
      assign initial = section.settings.reviews_initial
      assign bars = '5,4,3,2,1' | split: ','
      assign total_reviews = section.settings.total_reviews | default: 0
    -%}
    <section id="reviews" class="onyx-wrap py-xl" style="scroll-margin-top:calc(2*var(--r,16px))">
      <div class="fade-in rev-top">
        <div>
          <h2 class="h2-xl">{{ section.settings.reviews_heading }} {% if section.settings.reviews_highlight != blank %}<span class="text-sunrise">{{ section.settings.reviews_highlight }}</span>{% endif %}</h2>
          {%- if section.settings.reviews_summary != blank -%}<p class="rev-summary">{{ section.settings.reviews_summary }}</p>{%- endif -%}
        </div>
        {%- if total_reviews > 0 -%}
          <div class="bars">
            {%- for s in bars -%}
              {%- liquid
                assign count_key = 'count_' | append: s
                assign count = section.settings[count_key] | default: 0
                assign pct = count | times: 100.0 | divided_by: total_reviews | round
              -%}
              <div class="bar">
                <span class="s">{{ s }} {{ section.settings.stars_word }}</span>
                <div class="track bg-secondary"><div class="fill" style="width:{{ pct }}%"></div></div>
                <span class="c">{{ count }} ({{ pct }}%)</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="rev-grid">
        {%- for block in review_blocks -%}
          <div class="rev-card{% if forloop.index > initial %} is-hidden{% endif %}" {{ block.shopify_attributes }}>
            <div class="rev-author">
              <span class="avatar bg-sunrise">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.name }}
                {%- else -%}
                  {{ block.settings.name | slice: 0 }}
                {%- endif -%}
              </span>
              <div>
                <p class="n">{{ block.settings.name }}</p>
                <span class="st stars" aria-label="{{ block.settings.stars }} de 5">{%- for i in (1..block.settings.stars) -%}★{%- endfor -%}</span>
              </div>
            </div>
            <p class="t">{{ block.settings.title }}</p>
            <div class="x">{{ block.settings.text }}</div>
            {%- if block.settings.photo != blank -%}
              <div class="ph">{{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', class: 'media-cover', alt: block.settings.title }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if review_blocks.size > initial -%}
        <div class="more-wrap">
          <button type="button" class="btn-outline border-sunrise hover-glow" data-more-reviews>{{ section.settings.reviews_more }}</button>
        </div>
      {%- endif -%}
    </section>
  {%- endif -%}

  {%- comment -%} ================= 8. PIE DE PÁGINA ================= {%- endcomment -%}
  {%- if section.settings.show_footer -%}
    <footer class="onyx-footer onyx-wrap" style="background:{{ section.settings.footer_bg }};color:{{ section.settings.footer_text }};">
      <div class="foot-top">
        <div>
          <p class="foot-logo onyx-display">
            {%- if section.settings.footer_logo != blank -%}
              {{ section.settings.footer_logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
            {%- else -%}
              {{ section.settings.footer_logo_text }}<span class="text-sunrise">{{ section.settings.footer_logo_accent }}</span>
            {%- endif -%}
          </p>
          {%- if section.settings.footer_desc != blank -%}<div class="foot-desc">{{ section.settings.footer_desc }}</div>{%- endif -%}
        </div>
        <nav class="foot-nav" aria-label="Pie de página">
          {%- for block in link_blocks -%}
            <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endfor -%}
        </nav>
      </div>
      <div class="foot-bottom">
        {%- assign year = 'now' | date: '%Y' -%}
        <p>{{ section.settings.footer_copyright | replace: '[year]', year }}</p>
        <div class="socials">
          {%- for block in social_blocks -%}
            <a href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endfor -%}
        </div>
      </div>
    </footer>
  {%- endif -%}

  {%- comment -%} ================= BARRA FIJA + AVISO ================= {%- endcomment -%}
  {%- if section.settings.show_sticky and current_variant -%}
    <div class="sticky-bar" data-sticky-bar>
      <div class="sticky-inner">
        <div class="sticky-thumb placeholder-img">
          {%- if p.featured_media -%}
            {{ p.featured_media.preview_image | image_url: width: 120 | image_tag: class: 'media-cover', loading: 'lazy', alt: '' }}
          {%- endif -%}
        </div>
        <div class="sticky-info">
          <p class="t">{{ display_title }}</p>
          <p class="p"><strong data-sticky-price>{{ unit_price | money }}</strong> <s data-sticky-compare{% if compare_price == nil %} hidden{% endif %}>{% if compare_price %}{{ compare_price | money }}{% endif %}</s></p>
        </div>
        <button type="button" class="btn-main sticky-btn{% if section.settings.wiggle %} wiggle{% endif %}" data-sticky-atc{% unless can_buy %} disabled{% endunless %}>
          <span class="btn-bg"></span>
          <span class="btn-label">{{ section.settings.atc_text }}</span>
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="onyx-toast" data-toast role="status" aria-live="polite"></div>

  {%- if p != blank -%}
    <script type="application/json" data-product-json>{{ p | json }}</script>
  {%- endif -%}
</div>

<script>
/* ONYX — animaciones compartidas (aparición al hacer scroll + barra de progreso) */
(function () {
  if (window.__onyxInit) return;
  window.__onyxInit = true;

  var io = 'IntersectionObserver' in window
    ? new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.1, rootMargin: '-40px' })
    : null;

  function observe(root) {
    (root || document).querySelectorAll('.onyx .fade-in:not(.in)').forEach(function (el) {
      if (io) io.observe(el); else el.classList.add('in');
    });
  }

  function onScroll() {
    var bar = document.querySelector('.onyx-progress');
    if (!bar) return;
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  }

  document.addEventListener('DOMContentLoaded', function () { observe(); onScroll(); });
  window.addEventListener('scroll', onScroll, { passive: true });
  // Editor de temas: re-observar al añadir/editar secciones
  document.addEventListener('shopify:section:load', function (e) { observe(e.target); });
  if (document.readyState !== 'loading') { observe(); onScroll(); }
})();

  (function () {
    if (window.OnyxProduct) { window.OnyxProduct.initAll(); return; }

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      var value = '';
      var placeholder = /\{\{\s*(\w+)\s*\}\}/;
      function withDelimiters(number, precision, thousands, decimal) {
        precision = precision == null ? 2 : precision;
        thousands = thousands || ',';
        decimal = decimal || '.';
        if (isNaN(number) || number == null) return 0;
        number = (number / 100.0).toFixed(precision);
        var parts = number.split('.');
        var dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return dollars + (parts[1] ? decimal + parts[1] : '');
      }
      var m = format ? format.match(placeholder) : null;
      switch (m ? m[1] : 'amount') {
        case 'amount': value = withDelimiters(cents, 2); break;
        case 'amount_no_decimals': value = withDelimiters(cents, 0); break;
        case 'amount_with_comma_separator': value = withDelimiters(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = withDelimiters(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': value = withDelimiters(cents, 2, "'", '.'); break;
        case 'amount_with_space_separator': value = withDelimiters(cents, 2, ' ', ','); break;
        default: value = withDelimiters(cents, 2);
      }
      return m ? format.replace(placeholder, value) : value;
    }

    function OnyxProduct(root) {
      this.root = root;
      var self = this;
      this.fmt = root.dataset.moneyFormat;
      this.qty = 1;
      this.discount = 0;
      var first = root.querySelector('.qty-opt');
      if (first) { this.qty = +first.dataset.qty || 1; this.discount = +first.dataset.discount || 0; }

      // Selector de cantidad: se engancha lo primero y con delegación,
      // para que funcione aunque otra parte del script o del tema falle.
      function selectOption(b) {
        root.querySelectorAll('.qty-opt').forEach(function (o) {
          o.classList.remove('is-selected');
          var h = o.querySelector('[role="radio"]'); if (h) h.setAttribute('aria-checked', 'false');
        });
        b.classList.add('is-selected');
        var head = b.querySelector('[role="radio"]'); if (head) head.setAttribute('aria-checked', 'true');
        self.qty = +b.dataset.qty || 1;
        self.discount = +b.dataset.discount || 0;
      }
      root.addEventListener('click', function (e) {
        if (!e.target.closest) return;
        var b = e.target.closest('.qty-opt');
        if (!b || !root.contains(b)) return;
        var sw = e.target.closest('.swatch');
        if (sw && sw.disabled) return;
        e.preventDefault();
        if (!b.classList.contains('is-selected')) selectOption(b);
        if (sw) {
          var row = sw.closest('[data-color-row]');
          row.querySelectorAll('.swatch').forEach(function (x) { x.classList.remove('is-active'); });
          sw.classList.add('is-active');
          self.pickVariant(+sw.dataset.variant, true);
        } else {
          self.syncVariantFromCard();
        }
        try { self.update(); } catch (err) { console.error('[Onyx]', err); }
      });
      root.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        var h = e.target.closest && e.target.closest('.qty-head');
        if (!h) return;
        e.preventDefault(); h.click();
      });

      this.product = null;
      try {
        var json = root.querySelector('[data-product-json]');
        this.product = json ? JSON.parse(json.textContent) : null;
      } catch (err) { console.error('[Onyx] product JSON', err); }

      var idInput = root.querySelector('[data-variant-id]');
      var id = idInput ? +idInput.value : null;
      this.variant = null;
      if (this.product && this.product.variants) {
        this.variant = this.product.variants.find(function (v) { return v.id === id; }) || this.product.variants[0];
      }
      if (!this.variant && root.dataset.variantPrice) {
        // Respaldo: datos de la variante escritos directamente en el HTML
        this.variant = {
          id: id,
          price: +root.dataset.variantPrice,
          compare_at_price: +root.dataset.variantCompare || null,
          available: root.dataset.variantAvailable === 'true'
        };
      }
      try { this.bind(); } catch (err) { console.error('[Onyx] bind', err); }
      try { this.update(); } catch (err) { console.error('[Onyx] update', err); }
    }

    OnyxProduct.prototype.canBuy = function (v) {
      return !!v && (v.available || this.root.dataset.ignoreStock === 'true');
    };

    // Variante activa = la elegida en la primera fila de color de la opción seleccionada
    OnyxProduct.prototype.pickVariant = function (id, showImage) {
      if (!this.product || !this.product.variants) return;
      var v = this.product.variants.find(function (x) { return x.id === id; });
      if (!v) return;
      this.variant = v;
      if (showImage && v.featured_media) {
        var img = this.root.querySelector('[data-media-id="' + v.featured_media.id + '"]');
        if (img) this.showMedia(+img.dataset.mediaIndex);
      }
    };
    OnyxProduct.prototype.syncVariantFromCard = function () {
      var card = this.root.querySelector('.qty-opt.is-selected');
      var sw = card && card.querySelector('[data-color-row] .swatch.is-active');
      if (sw) this.pickVariant(+sw.dataset.variant, false);
    };
    OnyxProduct.prototype.cartItems = function () {
      var card = this.root.querySelector('.qty-opt.is-selected');
      var rows = card ? card.querySelectorAll('[data-color-row]') : [];
      if (!rows.length) return [{ id: this.variant.id, quantity: this.qty }];
      var counts = {}, order = [];
      rows.forEach(function (row) {
        var sw = row.querySelector('.swatch.is-active') || row.querySelector('.swatch:not([disabled])');
        if (!sw) return;
        var id = +sw.dataset.variant;
        if (!counts[id]) { counts[id] = 0; order.push(id); }
        counts[id]++;
      });
      return order.map(function (id) { return { id: id, quantity: counts[id] }; });
    };

    OnyxProduct.prototype.$ = function (sel) { return this.root.querySelector(sel); };

    OnyxProduct.prototype.bind = function () {
      var self = this, root = this.root;

      // Galería
      root.querySelectorAll('[data-thumb]').forEach(function (t) {
        t.addEventListener('click', function () { self.showMedia(+t.dataset.thumb); });
      });
      this.showMedia(0);

      // Variantes
      var sel = this.$('[data-variant-select]');
      if (sel) sel.addEventListener('change', function () {
        self.variant = self.product.variants.find(function (v) { return v.id === +sel.value; });
        if (self.variant && self.variant.featured_media) {
          var img = root.querySelector('[data-media-id="' + self.variant.featured_media.id + '"]');
          if (img) self.showMedia(+img.dataset.mediaIndex);
        }
        self.update();
      });

      // Ticks escritos a mano (✓ al inicio del párrafo) → tick de color
      root.querySelectorAll('.acc-content p').forEach(function (p) {
        var walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT);
        var node = walker.nextNode();
        while (node && !node.nodeValue.trim()) node = walker.nextNode();
        if (!node) return;
        var re = /^\s*[\u2713\u2714\u2705\u2611]\uFE0F?\s*/;
        if (re.test(node.nodeValue)) {
          node.nodeValue = node.nodeValue.replace(re, '');
          var span = document.createElement('span');
          while (p.firstChild) span.appendChild(p.firstChild);
          p.appendChild(span);
          p.classList.add('tick-line');
        }
      });

      // Acordeón (uno abierto a la vez)
      root.querySelectorAll('[data-accordion] .acc-item').forEach(function (item) {
        var btn = item.querySelector('.acc-btn'), body = item.querySelector('.acc-body');
        btn.addEventListener('click', function () {
          var open = item.classList.contains('is-open');
          root.querySelectorAll('[data-accordion] .acc-item').forEach(function (i) {
            i.classList.remove('is-open');
            i.querySelector('.acc-body').style.maxHeight = '0px';
            i.querySelector('.acc-btn').setAttribute('aria-expanded', 'false');
          });
          if (!open) {
            item.classList.add('is-open');
            body.style.maxHeight = body.scrollHeight + 'px';
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Añadir al carrito
      var form = this.$('[data-product-form]');
      if (form) form.addEventListener('submit', function (e) { e.preventDefault(); self.addToCart(); });
      var sticky = this.$('[data-sticky-atc]');
      if (sticky) sticky.addEventListener('click', function () { self.addToCart(); });

      // Barra fija
      var bar = this.$('[data-sticky-bar]');
      if (bar) {
        var offset = +root.dataset.stickyOffset || 900;
        var onScroll = function () { bar.classList.toggle('is-visible', window.scrollY > offset); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    };

    OnyxProduct.prototype.showMedia = function (index) {
      var imgs = this.root.querySelectorAll('[data-main-media] img');
      if (!imgs.length) return;
      imgs.forEach(function (img) { img.classList.toggle('is-active', +img.dataset.mediaIndex === index); });
      if (!this.root.querySelector('[data-main-media] img.is-active')) imgs[0].classList.add('is-active');
      this.root.querySelectorAll('[data-thumb]').forEach(function (t) { t.classList.toggle('is-active', +t.dataset.thumb === index); });
    };

    OnyxProduct.prototype.update = function () {
      var v = this.variant;
      if (!v) return;
      var self = this, root = this.root, fmt = this.fmt;
      var unit = Math.round(v.price * (100 - this.discount) / 100);
      var override = +root.dataset.compareOverride || 0;
      var base = override > 0 ? override : (v.compare_at_price && v.compare_at_price > v.price ? v.compare_at_price : v.price);
      // "Precio tachado" propio de la opción elegida y de la primera opción
      var selectedOpt = root.querySelector('.qty-opt.is-selected');
      var selCompare = selectedOpt ? +selectedOpt.dataset.compare || 0 : 0;
      var current = selCompare > 0 ? selCompare : base;
      var compare = current > unit ? current : null;
      var showEach = root.dataset.eachAlways === 'true' || this.qty > 1;
      root.querySelectorAll('[data-price-each]').forEach(function (el) { el.hidden = !showEach; });

      function set(sel, text, hide) {
        root.querySelectorAll(sel).forEach(function (el) {
          if (text != null) el.textContent = text;
          el.hidden = !!hide;
        });
      }
      root.querySelectorAll('.qty-opt').forEach(function (o) {
        var d = +o.dataset.discount || 0;
        var u = Math.round(v.price * (100 - d) / 100);
        var c = (+o.dataset.compare || 0) > 0 ? +o.dataset.compare : base;
        var pn = o.querySelector('[data-opt-price]'); if (pn) pn.textContent = formatMoney(u, fmt);
        var pc = o.querySelector('[data-opt-compare]');
        if (pc) { pc.textContent = formatMoney(c, fmt); pc.hidden = !(c > u); }
      });
      set('[data-price-now]', formatMoney(unit, fmt));
      set('[data-sticky-price]', formatMoney(unit, fmt));
      set('[data-offer-price]', formatMoney(unit, fmt));
      set('[data-price-compare]', compare ? formatMoney(compare, fmt) : '', !compare);
      set('[data-offer-compare]', compare ? formatMoney(compare, fmt) : '', !compare);
      set('[data-sticky-compare]', compare ? formatMoney(compare, fmt) : '', !compare);
      set('[data-pct-off]', compare ? Math.round((1 - unit / compare) * 100) + root.dataset.pctSuffix : '', !compare);

      var idInput = this.$('[data-variant-id]'); if (idInput) idInput.value = v.id;
      var qtyInput = this.$('[data-qty-input]'); if (qtyInput) qtyInput.value = this.qty;

      root.querySelectorAll('[data-atc],[data-sticky-atc]').forEach(function (b) { b.disabled = !self.canBuy(v); });
      var label = this.$('[data-atc-label]');
      if (label) {
        if (!label.dataset.original) label.dataset.original = label.textContent;
        label.textContent = this.canBuy(v) ? label.dataset.original : root.dataset.soldOut;
      }
    };

    OnyxProduct.prototype.toast = function (msg) {
      var t = this.$('[data-toast]');
      if (!t || !msg) return;
      t.textContent = msg;
      t.classList.add('is-visible');
      clearTimeout(this._toastTimer);
      this._toastTimer = setTimeout(function () { t.classList.remove('is-visible'); }, 3500);
    };

    OnyxProduct.prototype.addToCart = function () {
      var self = this, root = this.root, v = this.variant;
      if (!v || !this.canBuy(v)) return;
      var buttons = root.querySelectorAll('[data-atc],[data-sticky-atc]');
      var err = this.$('[data-atc-error]');
      buttons.forEach(function (b) { b.disabled = true; b.classList.add('is-loading'); });
      if (err) err.hidden = true;

      fetch(root.dataset.cartAddUrl + '.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: self.cartItems() })
      })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.data.description || res.data.message || root.dataset.errorMsg);
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('onyx:added', { detail: res.data }));
          var mode = root.dataset.afterAdd;
          if (mode === 'cart') window.location.href = root.dataset.cartUrl;
          else if (mode === 'checkout') window.location.href = '/checkout';
          else self.toast(root.dataset.addedMsg);
        })
        .catch(function (e) {
          if (err) { err.textContent = e.message || root.dataset.errorMsg; err.hidden = false; }
          self.toast(e.message || root.dataset.errorMsg);
        })
        .finally(function () {
          buttons.forEach(function (b) { b.classList.remove('is-loading'); b.disabled = !self.canBuy(v); });
        });
    };

    OnyxProduct.initAll = function () {
      document.querySelectorAll('[data-onyx-product]').forEach(function (root) {
        if (root.__onyx) return;
        root.__onyx = new OnyxProduct(root);
      });
    };

    window.OnyxProduct = OnyxProduct;
    OnyxProduct.initAll();
    document.addEventListener('shopify:section:load', OnyxProduct.initAll);
  })();

/* ONYX — botón "Ver más reseñas" */
(function () {
  function init() {
    document.querySelectorAll('.onyx [data-more-reviews]').forEach(function (btn) {
      if (btn.__bound) return;
      btn.__bound = true;
      btn.addEventListener('click', function () {
        var root = btn.closest('section');
        root.querySelectorAll('.rev-card.is-hidden').forEach(function (c) { c.classList.remove('is-hidden'); });
        btn.parentNode.style.display = 'none';
      });
    });
  }
  init();
  document.addEventListener('shopify:section:load', init);
  document.addEventListener('shopify:block:select', function (e) {
    if (e.target.classList && e.target.classList.contains('rev-card')) e.target.classList.remove('is-hidden');
  });
})();
</script>

{% schema %}
{
  "name": "Onyx · Landing completa",
  "tag": "section",
  "class": "onyx-landing",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Colores generales"
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "Degradado 1",
      "default": "#FFD93D"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Degradado 2 (principal)",
      "default": "#FF9F1C"
    },
    {
      "type": "color",
      "id": "color_3",
      "label": "Degradado 3",
      "default": "#FF5E3A"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Texto / botón",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "color_secondary",
      "label": "Fondo secundario",
      "default": "#F4F1EC"
    },
    {
      "type": "color",
      "id": "tick_color",
      "label": "Color de los ticks (pestañas desplegables)",
      "default": "#FF9F1C"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Barra de progreso de lectura arriba",
      "default": true
    },
    {
      "type": "header",
      "content": "1 · Producto"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Elige el producto de tu tienda que se mostrará (fotos, precio, variantes y botón de compra). Vacío = el producto de la página en la que estás."
    },
    {
      "type": "paragraph",
      "content": "Las fotos, el precio y las variantes se editan en la ficha del producto (Productos en el admin)."
    },
    {
      "type": "text",
      "id": "title_override",
      "label": "Título personalizado",
      "info": "Vacío = título de cada producto."
    },
    {
      "type": "checkbox",
      "id": "title_custom_font",
      "label": "Elegir tipografía del nombre del producto",
      "default": false,
      "info": "Desactivado = Space Grotesk (la del diseño)."
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Tipografía del nombre",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del nombre (ordenador)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño del nombre (móvil)",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texto de reseñas junto a las estrellas",
      "default": "3.622 reseñas"
    },
    {
      "type": "text",
      "id": "compare_price_manual",
      "label": "Precio de comparación general (tachado)",
      "info": "Ej: 85,00. Se usa en las opciones de cantidad que no tengan su propio 'Precio tachado'. Vacío = usa el 'Precio de comparación' del producto."
    },
    {
      "type": "text",
      "id": "each_text",
      "label": "Texto junto al precio por unidad",
      "default": "each"
    },
    {
      "type": "checkbox",
      "id": "each_always",
      "label": "Mostrar ese texto también con 1 unidad",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pct_badge",
      "label": "Mostrar % de descuento",
      "default": true
    },
    {
      "type": "text",
      "id": "pct_suffix",
      "label": "Sufijo del descuento",
      "default": "% DTO"
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Mostrar selector de color en cada unidad",
      "default": true,
      "info": "Solo aparece si el producto tiene variantes (colores). Las fotos salen de la imagen de cada variante."
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Texto de cada fila de color",
      "default": "Choose Color",
      "info": "Se añade el número: Choose Color 1, Choose Color 2…"
    },
    {
      "type": "text",
      "id": "qty_heading",
      "label": "Título del selector de cantidad",
      "default": "Elige tu cantidad"
    },
    {
      "type": "paragraph",
      "content": "El % de las 'Opciones de cantidad' solo cambia el precio mostrado. Para cobrarlo, crea un descuento automático por cantidad en Descuentos."
    },
    {
      "type": "text",
      "id": "atc_text",
      "label": "Texto del botón",
      "default": "Añadir al carrito +"
    },
    {
      "type": "checkbox",
      "id": "wiggle",
      "label": "Efecto de tintineo en el botón",
      "default": true
    },
    {
      "type": "range",
      "id": "wiggle_every",
      "label": "Tintineo cada",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "ignore_stock",
      "label": "No mostrar nunca \"Agotado\" (dropshipping)",
      "default": true,
      "info": "El botón siempre deja comprar. En el producto desmarca también 'Controlar cantidad' en Inventario, o Shopify rechazará el pedido."
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Texto agotado",
      "default": "Agotado"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "Después de añadir al carrito",
      "default": "cart",
      "options": [
        {
          "value": "cart",
          "label": "Ir a la página del carrito"
        },
        {
          "value": "checkout",
          "label": "Ir directamente al pago"
        },
        {
          "value": "toast",
          "label": "Quedarse y mostrar aviso"
        }
      ]
    },
    {
      "type": "text",
      "id": "added_message",
      "label": "Aviso al añadir",
      "default": "¡Añadido al carrito!"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Aviso de error",
      "default": "No se pudo añadir al carrito. Inténtalo de nuevo."
    },
    {
      "type": "header",
      "content": "Caja de oferta"
    },
    {
      "type": "checkbox",
      "id": "show_offer_box",
      "label": "Mostrar caja de oferta",
      "default": true
    },
    {
      "type": "text",
      "id": "offer_badge",
      "label": "Etiqueta",
      "default": "OFERTA LIMITADA"
    },
    {
      "type": "text",
      "id": "offer_title",
      "label": "Título",
      "info": "Vacío = título del producto."
    },
    {
      "type": "textarea",
      "id": "offer_bullets",
      "label": "Ventajas (una por línea)",
      "default": "Creada por personas de sueño profundo, para personas de sueño profundo\nGarantizado que te despierta\nVibraciones silenciosas que no molestan a nadie más"
    },
    {
      "type": "textarea",
      "id": "trust_lines",
      "label": "Garantías bajo la caja (una por línea)",
      "default": "🛡 100 días de garantía de devolución sin riesgo\n🧪 Testado por laboratorios externos"
    },
    {
      "type": "header",
      "content": "Barra fija inferior"
    },
    {
      "type": "checkbox",
      "id": "show_sticky",
      "label": "Mostrar barra fija",
      "default": true
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Aparece tras hacer scroll (px)",
      "min": 100,
      "max": 2000,
      "step": 50,
      "default": 900
    },
    {
      "type": "header",
      "content": "2 · Preguntas rápidas"
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Título",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "font_picker",
      "id": "faq_font",
      "label": "Tipografía del título",
      "default": "helvetica_n7",
      "info": "Déjala en Helvetica para mantener la fuente original del diseño."
    },
    {
      "type": "header",
      "content": "3 · Ondas"
    },
    {
      "type": "checkbox",
      "id": "show_ripple",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "textarea",
      "id": "ripple_heading",
      "label": "Título",
      "default": "Reloj alarma clínicamente estudiado. Diseñado para"
    },
    {
      "type": "text",
      "id": "ripple_highlight",
      "label": "Título: parte destacada",
      "default": "optimizadores y parejas enamoradas"
    },
    {
      "type": "font_picker",
      "id": "ripple_font",
      "label": "Tipografía del título",
      "default": "helvetica_n7",
      "info": "Déjala en Helvetica para mantener la fuente original del diseño. La parte destacada en cursiva no cambia."
    },
    {
      "type": "image_picker",
      "id": "ripple_image",
      "label": "Imagen central (PNG sin fondo)"
    },
    {
      "type": "textarea",
      "id": "ripple_left",
      "label": "Ventajas izquierda (una por línea)",
      "default": "Mejora la calidad de tu sueño\nSiéntete con energía durante el día\nNo interrumpas el sueño de tu pareja\nDespertar silencioso y fiable"
    },
    {
      "type": "textarea",
      "id": "ripple_right",
      "label": "Ventajas derecha (una por línea)",
      "default": "Despertar de forma natural\nEl mejor dispositivo para sueño profundo\nBatería de +14 días\nHasta 3 alarmas"
    },
    {
      "type": "color",
      "id": "ripple_bg",
      "label": "Fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "ripple_text",
      "label": "Texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "4 · Características"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Título",
      "default": "RECUPERA TUS"
    },
    {
      "type": "text",
      "id": "features_highlight",
      "label": "Título: parte destacada",
      "default": "MAÑANAS."
    },
    {
      "type": "font_picker",
      "id": "features_font",
      "label": "Tipografía del título",
      "default": "helvetica_n7",
      "info": "Déjala en Helvetica para mantener la fuente original del diseño."
    },
    {
      "type": "text",
      "id": "features_sub",
      "label": "Subtítulo",
      "default": "Fija tu hora de despertar y reinicia tu sistema nervioso."
    },
    {
      "type": "color",
      "id": "features_bg",
      "label": "Fondo",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "features_text",
      "label": "Texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "5 · Comparativa"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "text",
      "id": "compare_eyebrow",
      "label": "Antetítulo",
      "default": "¿Qué hace diferente a Onyx?"
    },
    {
      "type": "text",
      "id": "compare_heading",
      "label": "Título",
      "default": "Diseñada para una mañana consciente"
    },
    {
      "type": "font_picker",
      "id": "compare_font",
      "label": "Tipografía del título",
      "default": "helvetica_n7",
      "info": "Déjala en Helvetica para mantener la fuente original del diseño."
    },
    {
      "type": "text",
      "id": "compare_sub",
      "label": "Subtítulo",
      "default": "La vibración física supera al sonido. Siempre."
    },
    {
      "type": "text",
      "id": "compare_col_1",
      "label": "Columna 1 (destacada)",
      "default": "ONYX"
    },
    {
      "type": "image_picker",
      "id": "compare_img_1",
      "label": "Foto columna 1"
    },
    {
      "type": "text",
      "id": "compare_col_2",
      "label": "Columna 2",
      "default": "Móvil"
    },
    {
      "type": "image_picker",
      "id": "compare_img_2",
      "label": "Foto columna 2"
    },
    {
      "type": "text",
      "id": "compare_col_3",
      "label": "Columna 3",
      "default": "Smartwatch"
    },
    {
      "type": "image_picker",
      "id": "compare_img_3",
      "label": "Foto columna 3"
    },
    {
      "type": "color",
      "id": "compare_bg",
      "label": "Fondo de la tabla",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "compare_col_bg",
      "label": "Fondo columnas 2 y 3",
      "default": "#F4F5F7"
    },
    {
      "type": "color",
      "id": "compare_text",
      "label": "Texto columnas 2 y 3",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "compare_yes",
      "label": "Icono sí (columnas 2 y 3)",
      "default": "#22C55E"
    },
    {
      "type": "color",
      "id": "compare_no",
      "label": "Icono no",
      "default": "#EF4444"
    },
    {
      "type": "color",
      "id": "compare_best_icon",
      "label": "Icono sí (columna destacada)",
      "default": "#0A0A0C"
    },
    {
      "type": "header",
      "content": "6 · Expertos"
    },
    {
      "type": "checkbox",
      "id": "show_experts",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "text",
      "id": "experts_heading",
      "label": "Título",
      "default": "Avalada por expertos y elegida por atletas y parejas"
    },
    {
      "type": "richtext",
      "id": "experts_text",
      "label": "Texto",
      "default": "<p>Alarma vibratoria clínicamente estudiada. Resultados reales. Esto es lo que dicen algunas parejas que han probado ONYX:</p>"
    },
    {
      "type": "header",
      "content": "7 · Reseñas"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Mostrar",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Título",
      "default": "Escéptico al principio."
    },
    {
      "type": "text",
      "id": "reviews_highlight",
      "label": "Título: parte destacada",
      "default": "Ahora me despierto SIEMPRE."
    },
    {
      "type": "text",
      "id": "reviews_summary",
      "label": "Resumen",
      "default": "★★★★★ 4,98 · 3.622 reseñas"
    },
    {
      "type": "text",
      "id": "stars_word",
      "label": "Palabra 'estrellas'",
      "default": "estrellas"
    },
    {
      "type": "number",
      "id": "total_reviews",
      "label": "Total de reseñas (0 = ocultar barras)",
      "default": 3622
    },
    {
      "type": "number",
      "id": "count_5",
      "label": "Reseñas de 5 estrellas",
      "default": 3537
    },
    {
      "type": "number",
      "id": "count_4",
      "label": "Reseñas de 4 estrellas",
      "default": 85
    },
    {
      "type": "number",
      "id": "count_3",
      "label": "Reseñas de 3 estrellas",
      "default": 0
    },
    {
      "type": "number",
      "id": "count_2",
      "label": "Reseñas de 2 estrellas",
      "default": 0
    },
    {
      "type": "number",
      "id": "count_1",
      "label": "Reseñas de 1 estrella",
      "default": 0
    },
    {
      "type": "range",
      "id": "reviews_initial",
      "label": "Reseñas visibles al inicio",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "reviews_more",
      "label": "Texto del botón 'ver más'",
      "default": "Ver más reseñas"
    },
    {
      "type": "header",
      "content": "8 · Pie de página"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Mostrar",
      "default": true,
      "info": "Desactívalo si tu tema ya tiene su propio pie de página."
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo (imagen)"
    },
    {
      "type": "text",
      "id": "footer_logo_text",
      "label": "Logo (texto si no hay imagen)",
      "default": "onyx"
    },
    {
      "type": "text",
      "id": "footer_logo_accent",
      "label": "Logo: acento en degradado",
      "default": "."
    },
    {
      "type": "richtext",
      "id": "footer_desc",
      "label": "Descripción",
      "default": "<p>La alarma de pulsera silenciosa para despertar con calma, energía y sin molestar a nadie.</p>"
    },
    {
      "type": "text",
      "id": "footer_copyright",
      "label": "Copyright",
      "default": "© [year] Onyx Sleep. Todos los derechos reservados.",
      "info": "[year] = año actual"
    },
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Fondo",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "footer_text",
      "label": "Texto",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "quantity",
      "name": "1 · Opción de cantidad",
      "limit": 6,
      "settings": [
        {
          "type": "number",
          "id": "qty",
          "label": "Unidades",
          "default": 1
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "1 Alarma"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto de la opción",
          "info": "Ej: 1, 2 o 3 pulseras. Mejor PNG sin fondo."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtexto (opcional)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta de ahorro (degradado)",
          "info": "Ej: Save 10%"
        },
        {
          "type": "range",
          "id": "discount",
          "label": "Descuento mostrado",
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Precio tachado (por unidad)",
          "info": "Ej: 85,00. Es el precio que sale tachado al elegir esta opción. Vacío = usa el precio de comparación general."
        }
      ]
    },
    {
      "type": "accordion",
      "name": "1 · Pestaña desplegable",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "¿Qué es esto?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido",
          "default": "<p>Escribe aquí el contenido.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierta por defecto",
          "default": false
        }
      ]
    },
    {
      "type": "faq",
      "name": "2 · Pregunta rápida",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuánto dura la batería?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Hasta 14 días con una sola carga.</p>"
        }
      ]
    },
    {
      "type": "feature",
