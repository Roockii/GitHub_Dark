        },
        {
          "type": "text",
          "id": "stat2_label",
          "label": "Dato 2: etiqueta",
          "default": "TASA DESPERTAR"
        }
      ]
    },
    {
      "type": "compare_row",
      "name": "5 · Fila comparativa",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Característica",
          "default": "Uso como alarma"
        },
        {
          "type": "checkbox",
          "id": "col_1",
          "label": "Columna 1 la tiene",
