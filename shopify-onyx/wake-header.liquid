{%- comment -%}
  WAKE HEADER — estética Vyra/Onyx
  · Barra negra con 4 mensajes que rotan (editables)
  · Cabecera en tarjeta blanca: enlaces a la izquierda, logo animado en el centro, buscador y carrito a la derecha
  El bloque del logo (animación, tamaño, texto de debajo) se mantiene igual que en la versión anterior.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
  {{ section.settings.tagline_font | font_face: font_display: 'swap' }}
  #wm-{{ section.id }} {
    /* Colores de la tienda */
    --wm-sun-1:     {{ section.settings.hd_sunrise_1 }};
    --wm-sun-2:     {{ section.settings.hd_sunrise_2 }};
    --wm-sun-3:     {{ section.settings.hd_sunrise_3 }};
    --wm-sunrise:   linear-gradient(135deg, var(--wm-sun-1) 0%, var(--wm-sun-2) 50%, var(--wm-sun-3) 100%);
    --wm-ink:       {{ section.settings.hd_text }};
    --wm-page-bg:   {{ section.settings.hd_bg }};
    --wm-logo-h:    {{ section.settings.logo_h | default: 50 }}px;
    --wm-logo-zoom: {{ section.settings.logo_zoom | default: 250 | divided_by: 100.0 }};
    --wm-card-bg:   {{ section.settings.hd_card_bg }};
    --wm-border:    {{ section.settings.hd_border2 }};
    --wm-bar-bg:    {{ section.settings.hd_bar_bg }};
    --wm-bar-text:  {{ section.settings.hd_bar_text }};
    /* Usados por la animación del logo (igual que antes) */
    --wm-accent-1:  var(--wm-sun-2);
    --wm-accent-3:  var(--wm-sun-1);
    --wm-text-soft: #6b7280;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.4;
    color: var(--wm-ink);
    background: var(--wm-page-bg);
    position: relative;
    z-index: 10;
    -webkit-font-smoothing: antialiased;
  }
  #wm-{{ section.id }} * { box-sizing: border-box; }
  #wm-{{ section.id }} a { color: inherit; text-decoration: none; }

  /* ---------- Barra negra con mensajes que rotan ---------- */
  #wm-{{ section.id }} .wm-bar {
    background: var(--wm-bar-bg); color: var(--wm-bar-text);
    font-size: 13px; font-weight: 600; letter-spacing: .01em;
  }
  #wm-{{ section.id }} .wm-bar-inner {
    max-width: 560px; margin: 0 auto; height: 36px; padding: 0 8px;
    display: grid; grid-template-columns: 32px 1fr 32px; align-items: center;
  }
  #wm-{{ section.id }} .wm-bar-arrow {
    background: none; border: 0; color: var(--wm-bar-text); cursor: pointer;
    width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
    opacity: .85; transition: opacity .2s; padding: 0;
  }
  #wm-{{ section.id }} .wm-bar-arrow:hover { opacity: 1; }
  #wm-{{ section.id }} .wm-bar-arrow svg { width: 14px; height: 14px; }
  #wm-{{ section.id }} .wm-bar-track { position: relative; height: 36px; overflow: hidden; }
  #wm-{{ section.id }} .wm-msg {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    opacity: 0; transform: translateY(100%);
    transition: opacity .5s ease, transform .5s cubic-bezier(.22,1,.36,1);
  }
  #wm-{{ section.id }} .wm-msg.is-active { opacity: 1; transform: translateY(0); }
  #wm-{{ section.id }} .wm-msg.is-leaving { opacity: 0; transform: translateY(-100%); }
  #wm-{{ section.id }} .wm-msg a:hover { text-decoration: underline; }
  #wm-{{ section.id }} .wm-msg .wm-hl {
    background-image: var(--wm-sunrise); -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ---------- Cabecera en tarjeta ---------- */
  #wm-{{ section.id }} .wm-shell { padding: 12px 24px 10px; }
  #wm-{{ section.id }} .wm-header-row {
    max-width: 1440px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    background: var(--wm-card-bg);
    border: 1px solid var(--wm-border);
    border-radius: 12px;
    height: 58px;
    padding: 0 36px;
    box-shadow: 0 1px 2px rgba(10,10,12,.04);
  }

  /* Enlaces izquierda */
  #wm-{{ section.id }} .wm-nav { display: flex; align-items: center; gap: 24px; min-width: 0; }
  #wm-{{ section.id }} .wm-nav a {
    font-size: 17px; font-weight: 500; color: #2b2b2f; white-space: nowrap; position: relative; padding: 6px 0;
    transition: color .2s;
  }
  #wm-{{ section.id }} .wm-nav a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px;
    background-image: var(--wm-sunrise); transform: scaleX(0); transform-origin: left; transition: transform .25s ease;
  }
  #wm-{{ section.id }} .wm-nav a:hover::after { transform: scaleX(1); }
  #wm-{{ section.id }} .wm-nav .wm-burger { display: none; }

  /* Iconos derecha */
  #wm-{{ section.id }} .wm-utils { display: flex; align-items: center; gap: 20px; justify-self: end; }
  #wm-{{ section.id }} .wm-util-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: none; padding: 6px; margin: 0; cursor: pointer;
    color: var(--wm-ink); position: relative; line-height: 0; border-radius: 999px; transition: background .2s;
  }
  #wm-{{ section.id }} .wm-util-btn:hover { background: rgba(10,10,12,.05); }
  #wm-{{ section.id }} .wm-util-btn svg { width: 24px; height: 24px; display: block; }

  #wm-{{ section.id }} .wm-search-wrap { position: relative; }
  #wm-{{ section.id }} .wm-search-form {
    position: absolute; top: calc(100% + 14px); right: 0;
    background: var(--wm-card-bg); border: 1px solid var(--wm-border);
    border-radius: 999px; padding: 5px 6px 5px 18px; display: flex; align-items: center; gap: 6px;
    box-shadow: 0 16px 36px -12px rgba(10,10,12,.25);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
    width: 260px; max-width: 70vw; z-index: 20;
  }
  #wm-{{ section.id }} .wm-search-form.is-open { opacity: 1; visibility: visible; transform: translateY(0); }
  #wm-{{ section.id }} .wm-search-form input {
    border: none; outline: none; background: none; font: inherit; font-size: 14px; flex: 1;
    color: var(--wm-ink); min-width: 0;
  }
  #wm-{{ section.id }} .wm-search-form button {
    border: none; background-image: var(--wm-sunrise); color: var(--wm-ink); border-radius: 50%;
    width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; flex: none;
  }
  #wm-{{ section.id }} .wm-search-form button svg { width: 14px; height: 14px; }

  #wm-{{ section.id }} .wm-cart-count {
    position: absolute; top: -2px; right: -4px;
    background-image: var(--wm-sunrise); color: var(--wm-ink); font-size: 10px; font-weight: 800; line-height: 1;
    min-width: 18px; height: 18px; border-radius: 999px; border: 2px solid var(--wm-card-bg);
    display: flex; align-items: center; justify-content: center; padding: 0 3px;
  }

  /* Menú móvil */
  #wm-{{ section.id }} .wm-mobile-nav {
    display: none; max-width: 1440px; margin: 8px auto 0;
    background: var(--wm-card-bg); border: 1px solid var(--wm-border); border-radius: 16px; padding: 6px 0;
  }
  #wm-{{ section.id }} .wm-mobile-nav.is-open { display: block; }
  #wm-{{ section.id }} .wm-mobile-nav a { display: block; padding: 12px 20px; font-weight: 500; }
  #wm-{{ section.id }} .wm-mobile-nav a + a { border-top: 1px solid var(--wm-border); }

  /* ---------- Logo con animación (brillo + flotación), en tamaño compacto ---------- */
  #wm-{{ section.id }} .wm-logo-wrap {
    display: flex; align-items: center; justify-content: center; justify-self: center; gap: 8px;
  }
  #wm-{{ section.id }} .wm-logo-stage {
    position: relative; display: flex; align-items: center; justify-content: center;
    height: 100%; padding: 0 10px;
  }
  #wm-{{ section.id }} .wm-sunrise-glow {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: calc(var(--wm-logo-h) * 1.5); height: calc(var(--wm-logo-h) * 1.5);
    border-radius: 50%;
    background: radial-gradient(circle, var(--wm-accent-3) 0%, var(--wm-accent-1) 55%, transparent 75%);
    filter: blur(12px); opacity: .45; pointer-events: none;
    {% if section.settings.enable_logo_animation %}
    animation: wm-pulse 4.5s ease-in-out infinite;
    {% endif %}
  }
  /* El recorte quita el espacio vacío de arriba y abajo de la imagen (ajuste "Zoom del logo") */
  #wm-{{ section.id }} .wm-logo-clip {
    position: relative; z-index: 2; height: var(--wm-logo-h);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    {% if section.settings.enable_logo_animation %}
    animation: wm-float 5.5s ease-in-out infinite;
    {% endif %}
  }
  #wm-{{ section.id }} .wm-logo-img {
    display: block; flex: none;
    height: calc(var(--wm-logo-h) * var(--wm-logo-zoom)); width: auto; max-width: none; object-fit: contain;
  }
  #wm-{{ section.id }} .wm-logo-text { position: relative; z-index: 2; font-size: calc(var(--wm-logo-h) * .7); font-weight: 800; letter-spacing: -.02em; }
  @keyframes wm-pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(0.92); opacity: .35; }
    50% { transform: translate(-50%, -50%) scale(1.08); opacity: .6; }
  }
  @keyframes wm-float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-3px) rotate(-1.5deg); }
  }
  #wm-{{ section.id }} .wm-wordmark {
    font-family: {{ section.settings.tagline_font.family | default: 'Quicksand' }}, sans-serif;
    font-weight: {{ section.settings.tagline_font.weight | default: 700 }};
    font-size: 12px; color: var(--wm-text-soft); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    #wm-{{ section.id }} .wm-msg { transition: none; }
  }

  @media (max-width: 749px) {
    #wm-{{ section.id }} .wm-bar { font-size: 12px; }
    #wm-{{ section.id }} .wm-shell { padding: 8px 12px; }
    #wm-{{ section.id }} .wm-header-row { padding: 2px 12px; gap: 8px; border-radius: 14px; }
    #wm-{{ section.id }} .wm-nav a { display: none; }
    #wm-{{ section.id }} .wm-nav .wm-burger { display: inline-flex; }
    #wm-{{ section.id }} .wm-utils { gap: 8px; }
    #wm-{{ section.id }} .wm-util-btn svg { width: 20px; height: 20px; }
    #wm-{{ section.id }} { --wm-logo-h: calc({{ section.settings.logo_h | default: 50 }}px * .8); }
    #wm-{{ section.id }} .wm-header-row { height: 52px; }
    #wm-{{ section.id }} .wm-wordmark { display: none; }

  }
{%- endstyle -%}

{%- liquid
  assign messages = ''
  for i in (1..4)
    assign key = 'announce_' | append: i
    if section.settings[key] != blank
      assign messages = messages | append: i | append: ','
    endif
  endfor
  assign message_ids = messages | split: ','
-%}

<div id="wm-{{ section.id }}" data-section-id="{{ section.id }}" data-wm-header>

  {%- if section.settings.show_announce_bar and message_ids.size > 0 -%}
    <div class="wm-bar" data-wm-bar data-interval="{{ section.settings.announce_speed }}">
      <div class="wm-bar-inner">
        <button type="button" class="wm-bar-arrow" data-wm-prev aria-label="Mensaje anterior"{% if message_ids.size < 2 %} style="visibility:hidden"{% endif %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="wm-bar-track" aria-live="polite">
          {%- for i in message_ids -%}
            {%- assign text_key = 'announce_' | append: i -%}
            {%- assign link_key = 'announce_' | append: i | append: '_link' -%}
            <div class="wm-msg{% if forloop.first %} is-active{% endif %}">
              {%- if section.settings[link_key] != blank -%}
                <a href="{{ section.settings[link_key] }}">{{ section.settings[text_key] }}</a>
              {%- else -%}
                <span>{{ section.settings[text_key] }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="wm-bar-arrow" data-wm-next aria-label="Mensaje siguiente"{% if message_ids.size < 2 %} style="visibility:hidden"{% endif %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="wm-shell">
    <div class="wm-header-row">

      {%- comment -%} Izquierda: enlaces {%- endcomment -%}
      <nav class="wm-nav" aria-label="Menú principal">
        <button type="button" class="wm-util-btn wm-burger" data-wm-burger aria-label="Abrir menú" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        {%- if section.settings.menu != blank -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- assign lk = 'nav_' | append: i | append: '_label' -%}
            {%- assign uk = 'nav_' | append: i | append: '_url' -%}
            {%- if section.settings[lk] != blank -%}
              <a href="{{ section.settings[uk] | default: '#' }}">{{ section.settings[lk] }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>

      {%- comment -%} Centro: logo animado (sin cambios) {%- endcomment -%}
      {%- if section.settings.show_logo -%}
      <a href="{{ routes.root_url }}" class="wm-logo-wrap" aria-label="{{ shop.name | escape }}">
        <div class="wm-logo-stage">
          <div class="wm-sunrise-glow"></div>
          {%- if section.settings.logo_image != blank -%}
            <span class="wm-logo-clip">{{ section.settings.logo_image | image_url: width: 600 | image_tag: class: 'wm-logo-img', alt: shop.name }}</span>
          {%- else -%}
            <span class="wm-logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.show_tagline and section.settings.logo_tagline != blank -%}
          <div class="wm-wordmark">{{ section.settings.logo_tagline }}</div>
        {%- endif -%}
      </a>
      {%- else -%}
        <div></div>
      {%- endif -%}

      {%- comment -%} Derecha: buscador y carrito {%- endcomment -%}
      <div class="wm-utils">
        {%- if section.settings.show_search -%}
          <div class="wm-search-wrap">
            <button type="button" class="wm-util-btn wm-search-toggle" data-wm-search-toggle aria-label="Buscar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
            <form action="{{ routes.search_url }}" method="get" role="search" class="wm-search-form">
              <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}">
              <button type="submit" aria-label="Buscar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
            </form>
          </div>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a href="{{ routes.cart_url }}" class="wm-util-btn wm-cart-link" aria-label="Carrito">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            {%- if cart.item_count > 0 -%}
              <span class="wm-cart-count" data-wm-cart-count>{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Menú desplegable en móvil {%- endcomment -%}
    <nav class="wm-mobile-nav" data-wm-mobile-nav aria-label="Menú móvil">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {%- assign lk = 'nav_' | append: i | append: '_label' -%}
          {%- assign uk = 'nav_' | append: i | append: '_url' -%}
          {%- if section.settings[lk] != blank -%}
            <a href="{{ section.settings[uk] | default: '#' }}">{{ section.settings[lk] }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>
  </div>
</div>

<script>
  (function () {
    function initHeader(root) {
      if (!root || root.__wm) return;
      root.__wm = true;

      // Mensajes que rotan
      var bar = root.querySelector('[data-wm-bar]');
      if (bar) {
        var msgs = bar.querySelectorAll('.wm-msg');
        var idx = 0, timer = null;
        var every = (parseFloat(bar.dataset.interval) || 4) * 1000;
        function show(n) {
          if (msgs.length < 2) return;
          var prev = msgs[idx];
          idx = (n + msgs.length) % msgs.length;
          prev.classList.remove('is-active');
          prev.classList.add('is-leaving');
          setTimeout(function () { prev.classList.remove('is-leaving'); }, 500);
          msgs[idx].classList.add('is-active');
        }
        function start() { stop(); if (msgs.length > 1) timer = setInterval(function () { show(idx + 1); }, every); }
        function stop() { if (timer) clearInterval(timer); timer = null; }
        var prevBtn = bar.querySelector('[data-wm-prev]'), nextBtn = bar.querySelector('[data-wm-next]');
        if (prevBtn) prevBtn.addEventListener('click', function () { show(idx - 1); start(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { show(idx + 1); start(); });
        bar.addEventListener('mouseenter', stop);
        bar.addEventListener('mouseleave', start);
        start();
      }

      // Buscador
      var toggle = root.querySelector('[data-wm-search-toggle]');
      if (toggle) toggle.addEventListener('click', function () {
        var f = toggle.parentElement.querySelector('.wm-search-form');
        f.classList.toggle('is-open');
        if (f.classList.contains('is-open')) f.querySelector('input').focus();
      });

      // Menú móvil
      var burger = root.querySelector('[data-wm-burger]');
      var mnav = root.querySelector('[data-wm-mobile-nav]');
      if (burger && mnav) burger.addEventListener('click', function () {
        var open = mnav.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    document.querySelectorAll('[data-wm-header]').forEach(initHeader);
    document.addEventListener('shopify:section:load', function (e) {
      initHeader(e.target.querySelector('[data-wm-header]'));
    });
  })();
</script>

{% schema %}
