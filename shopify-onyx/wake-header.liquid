    },
    {
      "type": "text",
      "id": "announce_2",
      "label": "Mensaje 2",
      "default": "100-Night Risk-Free Trial"
    },
    {
      "type": "url",
      "id": "announce_2_link",
      "label": "Enlace mensaje 2 (opcional)"
    },
    {
      "type": "text",
      "id": "announce_3",
      "label": "Mensaje 3",
