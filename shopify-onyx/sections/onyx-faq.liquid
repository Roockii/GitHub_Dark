{{ 'onyx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'onyx.js' | asset_url }}" defer></script>

<section
  id="{{ section.settings.anchor | default: 'faq' }}"
  class="onyx onyx-wrap py-lg"
  style="scroll-margin-top:2rem;--sunrise-1:{{ section.settings.color_1 }};--sunrise-2:{{ section.settings.color_2 }};--sunrise-3:{{ section.settings.color_3 }};--secondary:{{ section.settings.color_secondary }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="fade-in h2-lg" style="margin-bottom:2.5rem">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="faq-grid">
    {%- for block in section.blocks -%}
      <div class="fade-in faq-card bg-secondary" {{ block.shopify_attributes }}>
        <p class="q">{{ block.settings.question }}</p>
        <div class="a">{{ block.settings.answer }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Onyx · Preguntas rápidas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "anchor", "label": "Ancla (ID)", "default": "faq", "info": "Para enlazar con #faq" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_1", "label": "Degradado 1", "default": "#FFD93D" },
    { "type": "color", "id": "color_2", "label": "Degradado 2", "default": "#FF9F1C" },
    { "type": "color", "id": "color_3", "label": "Degradado 3", "default": "#FF5E3A" },
    { "type": "color", "id": "color_secondary", "label": "Fondo tarjetas", "default": "#F4F1EC" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto dura la batería?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Hasta 14 días con una sola carga y uso nocturno normal.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onyx · Preguntas rápidas",
      "blocks": [
        { "type": "faq", "settings": { "question": "¿Cuánto dura la batería?", "answer": "<p>Hasta 14 días con una sola carga y uso nocturno normal.</p>" } },
        { "type": "faq", "settings": { "question": "¿Es suficiente para despertarme?", "answer": "<p>La vibración está calibrada para despertarte sin sonido. Puedes configurar intervalos de repetición.</p>" } },
        { "type": "faq", "settings": { "question": "¿Necesita móvil o app?", "answer": "<p>No. Onyx es independiente: configuras la alarma directamente en la pulsera.</p>" } },
        { "type": "faq", "settings": { "question": "¿Puedo ducharme con ella?", "answer": "<p>Es resistente al agua para el uso diario, pero no está pensada para nadar.</p>" } }
      ]
    }
  ]
}
{% endschema %}
