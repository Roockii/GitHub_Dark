{{ 'onyx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'onyx.js' | asset_url }}" defer></script>

<section
  class="onyx features-section onyx-wrap py-xl"
  style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }};--sunrise-1:{{ section.settings.color_1 }};--sunrise-2:{{ section.settings.color_2 }};--sunrise-3:{{ section.settings.color_3 }};"
>
  <div class="fade-in feat-head">
    <h2>{{ section.settings.heading }} {% if section.settings.heading_highlight != blank %}<span class="text-sunrise">{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="feat-list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign reverse = false
        if section.settings.alternate
          assign mod = forloop.index0 | modulo: 2
          if mod == 1
            assign reverse = true
          endif
        endif
      -%}
      <div class="feat{% if reverse %} reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="fade-in feat-media">
          <div class="feat-img placeholder-img">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'media-cover' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'media-cover', loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 768px) 40vw, 100vw', alt: block.settings.image.alt }}
            {%- else -%}
              <svg width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--sunrise-2)" stroke-width="1" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
            {%- endif -%}
          </div>
        </div>
        <div class="fade-in">
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<div class="txt">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.stat1_value != blank or block.settings.stat2_value != blank -%}
            <div class="stats">
              {%- if block.settings.stat1_value != blank -%}
                <div class="stat"><p class="n text-sunrise">{{ block.settings.stat1_value }}</p><p class="l">{{ block.settings.stat1_label }}</p></div>
              {%- endif -%}
              {%- if block.settings.stat2_value != blank -%}
                <div class="stat"><p class="n text-sunrise">{{ block.settings.stat2_value }}</p><p class="l">{{ block.settings.stat2_label }}</p></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Onyx · Características",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "RECUPERA TUS" },
    { "type": "text", "id": "heading_highlight", "label": "Título: parte destacada", "default": "MAÑANAS." },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Fija tu hora de despertar y reinicia tu sistema nervioso." },
    { "type": "checkbox", "id": "alternate", "label": "Alternar imagen izquierda/derecha", "default": true },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#0A0A0C" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "color_1", "label": "Degradado 1", "default": "#FFD93D" },
    { "type": "color", "id": "color_2", "label": "Degradado 2", "default": "#FF9F1C" },
    { "type": "color", "id": "color_3", "label": "Degradado 3", "default": "#FF5E3A" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "video", "id": "video", "label": "Vídeo (opcional, sustituye a la imagen)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Vibración potente" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Empieza suave y va a más.</p>" },
        { "type": "header", "content": "Dato 1" },
        { "type": "text", "id": "stat1_value", "label": "Valor", "default": "3" },
        { "type": "text", "id": "stat1_label", "label": "Etiqueta", "default": "NIVELES" },
        { "type": "header", "content": "Dato 2" },
        { "type": "text", "id": "stat2_value", "label": "Valor", "default": "99%" },
        { "type": "text", "id": "stat2_label", "label": "Etiqueta", "default": "TASA DESPERTAR" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onyx · Características",
      "blocks": [
        { "type": "feature", "settings": { "title": "Vibración potente", "text": "<p>Empieza suave y va a más. Con tres niveles de intensidad, tu cerebro no puede ignorarla como un sonido.</p>", "stat1_value": "3", "stat1_label": "NIVELES", "stat2_value": "99%", "stat2_label": "TASA DESPERTAR" } },
        { "type": "feature", "settings": { "title": "Despertar tranquilo", "text": "<p>Despierta sin molestar a tu pareja. Sin alarmas ruidosas, solo una vibración en tu muñeca que solo tú sientes.</p>", "stat1_value": "0 dB", "stat1_label": "RUIDO", "stat2_value": "100%", "stat2_label": "SILENCIOSA" } },
        { "type": "feature", "settings": { "title": "Batería de +14 días", "text": "<p>Configúrala y olvídate. Hasta 14 días con una sola carga y carga rápida por USB cuando la necesites.</p>", "stat1_value": "14+", "stat1_label": "DÍAS", "stat2_value": "USB", "stat2_label": "CARGA RÁPIDA" } }
      ]
    }
  ]
}
{% endschema %}
