{{ 'onyx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'onyx.js' | asset_url }}" defer></script>

{%- liquid
  assign left_items = section.blocks | where: 'type', 'left'
  assign right_items = section.blocks | where: 'type', 'right'
-%}

<section
  class="onyx ripple-section"
  style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }};--sunrise-1:{{ section.settings.color_1 }};--sunrise-2:{{ section.settings.color_2 }};--sunrise-3:{{ section.settings.color_3 }};"
>
  <div class="fade-in ripple-head">
    <h2>
      {{ section.settings.heading }}
      {%- if section.settings.heading_highlight != blank %}
        <em class="onyx-serif text-sunrise">{{ section.settings.heading_highlight }}</em>
      {%- endif -%}
    </h2>
  </div>

  <div class="ripple-grid">
    <div class="ripple-col">
      {%- for block in left_items -%}
        <div class="ripple-item left" {{ block.shopify_attributes }}>
          <span>{{ block.settings.text }}</span>
          <span class="ripple-line"></span>
          <span class="dot"></span>
        </div>
      {%- endfor -%}
    </div>

    <div class="ripple-center">
      {%- if section.settings.show_rings -%}
        <div class="ripple-rings" aria-hidden="true">
          <span class="ripple-ring" style="animation-delay:0s"></span>
          <span class="ripple-ring" style="animation-delay:.75s"></span>
          <span class="ripple-ring" style="animation-delay:1.5s"></span>
          <span class="ripple-ring" style="animation-delay:2.25s"></span>
        </div>
      {%- endif -%}
      <div class="ripple-product{% if section.settings.vibrate %} vibrate{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.image.alt, widths: '350, 500, 700' }}
        {%- else -%}
          <svg width="130" height="130" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--sunrise-2)" stroke-width="1" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
        {%- endif -%}
      </div>
    </div>

    <div class="ripple-col">
      {%- for block in right_items -%}
        <div class="ripple-item right" {{ block.shopify_attributes }}>
          <span class="dot"></span>
          <span class="ripple-line"></span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Móvil: todas las ventajas en 2 columnas {%- endcomment -%}
    <div class="ripple-mobile">
      {%- for block in left_items -%}
        <div class="ripple-item"><span class="dot"></span> {{ block.settings.text }}</div>
      {%- endfor -%}
      {%- for block in right_items -%}
        <div class="ripple-item"><span class="dot"></span> {{ block.settings.text }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Onyx · Ondas",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Título", "default": "Reloj alarma clínicamente estudiado. Diseñado para" },
    { "type": "text", "id": "heading_highlight", "label": "Título: parte destacada (degradado)", "default": "optimizadores y parejas enamoradas" },
    { "type": "image_picker", "id": "image", "label": "Imagen central (PNG sin fondo recomendado)" },
    { "type": "checkbox", "id": "show_rings", "label": "Mostrar ondas animadas", "default": true },
    { "type": "checkbox", "id": "vibrate", "label": "Efecto vibración en la imagen", "default": true },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "color_1", "label": "Degradado 1", "default": "#FFD93D" },
    { "type": "color", "id": "color_2", "label": "Degradado 2 (ondas)", "default": "#FF9F1C" },
    { "type": "color", "id": "color_3", "label": "Degradado 3", "default": "#FF5E3A" }
  ],
  "blocks": [
    { "type": "left", "name": "Ventaja izquierda", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Mejora la calidad de tu sueño" } ] },
    { "type": "right", "name": "Ventaja derecha", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Despertar de forma natural" } ] }
  ],
  "presets": [
    {
      "name": "Onyx · Ondas",
      "blocks": [
        { "type": "left", "settings": { "text": "Mejora la calidad de tu sueño" } },
        { "type": "left", "settings": { "text": "Siéntete con energía durante el día" } },
        { "type": "left", "settings": { "text": "No interrumpas el sueño de tu pareja" } },
        { "type": "left", "settings": { "text": "Despertar silencioso y fiable" } },
        { "type": "right", "settings": { "text": "Despertar de forma natural" } },
        { "type": "right", "settings": { "text": "El mejor dispositivo para sueño profundo" } },
        { "type": "right", "settings": { "text": "Batería de +14 días" } },
        { "type": "right", "settings": { "text": "Hasta 3 alarmas" } }
      ]
    }
  ]
}
{% endschema %}
