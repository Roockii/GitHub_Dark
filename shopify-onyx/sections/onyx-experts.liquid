{{ 'onyx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'onyx.js' | asset_url }}" defer></script>

<section
  class="onyx onyx-wrap py-xl"
  style="background:{{ section.settings.bg }};--sunrise-1:{{ section.settings.color_1 }};--sunrise-2:{{ section.settings.color_2 }};--sunrise-3:{{ section.settings.color_3 }};"
>
  <div class="fade-in exp-head">
    <h2 class="h2-xl">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
  </div>

  <div class="exp-grid">
    {%- for block in section.blocks -%}
      <div class="fade-in exp-card hover-glow" {{ block.shopify_attributes }}>
        <span class="stars" aria-label="{{ block.settings.stars }} de 5">
          {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
        </span>
        <p class="t">{{ block.settings.title }}</p>
        <div class="x">{{ block.settings.text }}</div>
        <div class="who">
          {%- if block.settings.photo != blank -%}
            {{ block.settings.photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
          {%- endif -%}
          <div>
            <p class="n">{{ block.settings.name }}</p>
            <p class="r">{{ block.settings.role }}</p>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Onyx · Expertos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Avalada por expertos y elegida por atletas y parejas" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Alarma vibratoria clínicamente estudiada. Resultados reales. Esto es lo que dicen algunas parejas que han probado ONYX:</p>" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#F4F1EC" },
    { "type": "color", "id": "color_1", "label": "Degradado 1", "default": "#FFD93D" },
    { "type": "color", "id": "color_2", "label": "Degradado 2 (brillo)", "default": "#FF9F1C" },
    { "type": "color", "id": "color_3", "label": "Degradado 3", "default": "#FF5E3A" }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Testimonio",
      "settings": [
        { "type": "range", "id": "stars", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Título", "default": "“¡Estoy enamorada de este producto!”" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Escribe aquí el testimonio.</p>" },
        { "type": "image_picker", "id": "photo", "label": "Foto (opcional)" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Macarena R." },
        { "type": "text", "id": "role", "label": "Cargo / descripción", "default": "Madre y experta en sueño" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onyx · Expertos",
      "blocks": [
        { "type": "expert", "settings": { "title": "“¡Estoy enamorada de este producto!”", "text": "<p>Hasta nuestro hijo usa su ONYX en la universidad. Mi marido se levanta a las 5 para trabajar y ya no me despierta. Estoy encantada.</p>", "name": "Macarena R.", "role": "Madre y experta en sueño" } },
        { "type": "expert", "settings": { "title": "“¡Ha salvado mi relación!”", "text": "<p>Un gran sustituto de despertadores y relojes inteligentes. Su vibración es la más fuerte de todos los wearables y no abulta. Un 10 de 10.</p>", "name": "Lena y Camilo", "role": "Pareja" } },
        { "type": "expert", "settings": { "title": "“¡Seguid creando productos!”", "text": "<p>Mi mujer y yo somos deportistas profesionales y hemos notado una gran diferencia en energía y recuperación para empezar el día.</p>", "name": "Carlo E.", "role": "Deportista profesional" } }
      ]
    }
  ]
}
{% endschema %}
