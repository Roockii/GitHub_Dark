{%- comment -%}
  WAKE FAQ (inicio) — título, texto, fotos de clientes y botón a la izquierda;
  preguntas desplegables (bloques) a la derecha. La primera sale abierta.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
  #wfq-{{ section.id }} {
    --wfq-sun: linear-gradient(135deg, {{ section.settings.sun_1 }} 0%, {{ section.settings.sun_2 }} 50%, {{ section.settings.sun_3 }} 100%);
    background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; font-size: 16px; line-height: 1.5;
    padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px;
    -webkit-font-smoothing: antialiased;
  }
  #wfq-{{ section.id }} * { box-sizing: border-box; }
  #wfq-{{ section.id }} .wfq-grid { max-width: 1344px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 990px) { #wfq-{{ section.id }} .wfq-grid { grid-template-columns: 1fr 1fr; gap: 64px; padding: 0 3vw; } }
  #wfq-{{ section.id }} .wfq-title { margin: 0; font-size: clamp(30px, 3vw, 44px); font-weight: 700; letter-spacing: -.045em; line-height: 1.08; }
  #wfq-{{ section.id }} .wfq-title .wfq-hl { background-image: var(--wfq-sun); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #wfq-{{ section.id }} .wfq-text { margin-top: 16px; max-width: 24em; font-size: 18px; color: {{ section.settings.muted }}; }
  #wfq-{{ section.id }} .wfq-text p { margin: 0; }
  #wfq-{{ section.id }} .wfq-avatars { display: flex; margin-top: 26px; }
  #wfq-{{ section.id }} .wfq-avatars span { width: 46px; height: 46px; border-radius: 999px; overflow: hidden; border: 3px solid {{ section.settings.bg }}; background-image: var(--wfq-sun); }
  #wfq-{{ section.id }} .wfq-avatars span + span { margin-left: -10px; }
  #wfq-{{ section.id }} .wfq-avatars img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #wfq-{{ section.id }} .wfq-btn {
    display: inline-flex; align-items: center; justify-content: center; margin-top: 40px; height: 56px; padding: 0 32px; border-radius: 999px;
    background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }}; font-size: 18px; font-weight: 700; text-decoration: none;
    position: relative; overflow: hidden; transition: color .35s ease;
  }
  #wfq-{{ section.id }} .wfq-btn::before { content: ""; position: absolute; inset: 0; background-image: var(--wfq-sun); opacity: 0; transition: opacity .35s ease; }
  #wfq-{{ section.id }} .wfq-btn span { position: relative; }
  #wfq-{{ section.id }} .wfq-btn:hover { color: #0A0A0C; }
  #wfq-{{ section.id }} .wfq-btn:hover::before { opacity: 1; }

  #wfq-{{ section.id }} .wfq-list { background: {{ section.settings.list_bg }}; border-radius: 16px; padding: 8px; display: flex; flex-direction: column; gap: 8px; align-self: start; }
  #wfq-{{ section.id }} .wfq-item { background: {{ section.settings.item_bg }}; border-radius: 10px; }
  #wfq-{{ section.id }} .wfq-q {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 16px;
    background: none; border: 0; cursor: pointer; text-align: left; font: inherit; font-size: 17px; font-weight: 600; color: inherit;
  }
  #wfq-{{ section.id }} .wfq-icon { position: relative; width: 14px; height: 14px; flex: none; transition: transform .3s ease; }
  #wfq-{{ section.id }} .wfq-icon::before, #wfq-{{ section.id }} .wfq-icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; border-radius: 2px; background: currentColor; transform: translate(-50%,-50%); }
  #wfq-{{ section.id }} .wfq-icon::after { transform: translate(-50%,-50%) rotate(90deg); }
  #wfq-{{ section.id }} .wfq-item.is-open .wfq-icon { transform: rotate(45deg); }
  #wfq-{{ section.id }} .wfq-item.is-open .wfq-icon::before, #wfq-{{ section.id }} .wfq-item.is-open .wfq-icon::after { background-image: var(--wfq-sun); }
  #wfq-{{ section.id }} .wfq-a { overflow: hidden; max-height: 0; transition: max-height .35s ease; }
  #wfq-{{ section.id }} .wfq-a-inner { padding: 0 16px 20px; color: {{ section.settings.muted }}; font-size: 15px; line-height: 1.6; }
  #wfq-{{ section.id }} .wfq-a-inner p { margin: 0; }
  #wfq-{{ section.id }} .wfq-a-inner p + p { margin-top: 14px; }
  @media (max-width: 749px) { #wfq-{{ section.id }} .wfq-btn { width: 100%; } }
{%- endstyle -%}

<section id="wfq-{{ section.id }}" class="wfq" data-wfq>
  <div class="wfq-grid">
    <div>
      <h2 class="wfq-title">{{ section.settings.title }}{% if section.settings.title_highlight != blank %} <span class="wfq-hl">{{ section.settings.title_highlight }}</span>{% endif %}</h2>
      {%- if section.settings.text != blank -%}<div class="wfq-text">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.settings.avatar_1 != blank or section.settings.avatar_2 != blank or section.settings.avatar_3 != blank -%}
        <div class="wfq-avatars">
          {%- for i in (1..3) -%}
            {%- assign key = 'avatar_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <span>{{ section.settings[key] | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="wfq-btn" href="{{ section.settings.button_url | default: '#' }}"><span>{{ section.settings.button_label }}</span></a>
      {%- endif -%}
    </div>

    <div class="wfq-list">
      {%- for block in section.blocks -%}
        <div class="wfq-item{% if forloop.first and section.settings.open_first %} is-open{% endif %}" {{ block.shopify_attributes }}>
          <button type="button" class="wfq-q" aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
            <span>{{ block.settings.question }}</span><span class="wfq-icon" aria-hidden="true"></span>
          </button>
          <div class="wfq-a"{% if forloop.first and section.settings.open_first %} style="max-height:none"{% endif %}>
            <div class="wfq-a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    function init(root) {
      if (!root || root.__wfq) return; root.__wfq = true;
      root.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('.wfq-q'); if (!btn) return;
        var item = btn.parentElement, open = item.classList.contains('is-open');
        root.querySelectorAll('.wfq-item').forEach(function (it) {
          it.classList.remove('is-open'); it.querySelector('.wfq-a').style.maxHeight = '0px';
          it.querySelector('.wfq-q').setAttribute('aria-expanded', 'false');
        });
        if (!open) {
          var a = item.querySelector('.wfq-a');
          item.classList.add('is-open'); a.style.maxHeight = a.scrollHeight + 'px'; btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
    document.querySelectorAll('[data-wfq]').forEach(init);
    document.addEventListener('shopify:section:load', function (e) { init(e.target.querySelector('[data-wfq]')); });
  })();
</script>

{% schema %}
{
  "name": "Wake preguntas (inicio)",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Got Questions About"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Título: parte en degradado",
      "default": "WakeMute?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Quick answers to the most common questions, from shipping to how it works.</p>"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Foto de cliente 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Foto de cliente 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Foto de cliente 3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Go to Support Centre"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Primera pregunta abierta",
      "default": true
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Texto secundario",
      "default": "#4B5563"
    },
    {
      "type": "color",
      "id": "list_bg",
      "label": "Fondo de la lista",
      "default": "#F4F4F5"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "Fondo de cada pregunta",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Botón: fondo",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Botón: texto",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "sun_1",
      "label": "Degradado 1",
      "default": "#FFD93D"
    },
    {
      "type": "color",
      "id": "sun_2",
      "label": "Degradado 2",
      "default": "#FF9F1C"
    },
    {
      "type": "color",
      "id": "sun_3",
      "label": "Degradado 3",
      "default": "#FF5E3A"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "Do you ship overseas?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Yes, we ship internationally.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wake preguntas (inicio)",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Do you ship overseas?",
            "answer": "<p>Yes! We ship internationally, and shipping costs are calculated at checkout.</p><p>We run discounts and promotions all year, so keep an eye out for free-shipping deals.</p>"
          }
